package main

// S4 acceptance: encoding/base64 (std+url+raw, RFC 4648), encoding/hex,
// encoding/binary le/be, encoding/csv (RFC 4180).
import "std/encoding/base64"

import "std/encoding/hex"

import "std/encoding/binary"

import "std/encoding/csv"

import "std/testing"

import "std/errors"

fn ck(e: err, m: str) {
    testing.expect(e == nil, m + ": " + errors.msg(e))
}

fn b64pair(in: str, want: str) {
    got := base64.encode(in as []byte)
    testing.expect(got == want, "b64 " + in + " -> " + got)
    [d, e] = base64.decode(want)
    ck(e, "b64 decode " + want)
    testing.expect(d as str == in, "b64 round-trip " + in)
}

fn test_base64() {
    b64pair("", "")
    b64pair("f", "Zg==")
    b64pair("fo", "Zm8=")
    b64pair("foo", "Zm9v")
    b64pair("foob", "Zm9vYg==")
    b64pair("fooba", "Zm9vYmE=")
    b64pair("foobar", "Zm9vYmFy")
    // raw = no padding
    testing.expect(base64.encode_raw("f" as []byte) == "Zg", "b64 raw f")
    testing.expect(base64.encode_raw("fo" as []byte) == "Zm8", "b64 raw fo")
    [d, e] = base64.decode_raw("Zg")
    ck(e, "b64 decode raw")
    testing.expect(d as str == "f", "b64 raw round-trip")
    // url alphabet: 0xfb 0xff 0xfe encodes "-__-" (std would be "+//+")
    ub := mkslice(byte, 3)
    ub[0] = 251
    ub[1] = 255
    ub[2] = 254
    ue := base64.url_encode(ub)
    testing.expect(ue == "-__-", "b64 url alphabet got " + ue)
    [ud, uerr] = base64.url_decode(ue)
    ck(uerr, "b64 url decode")
    testing.expect(len(ud) == 3 && ud[0] == 251 && ud[1] == 255 && ud[2] == 254, "b64 url round-trip")
    // malformed inputs are errors, not garbage
    [_, e1] = base64.decode("Zg!")
    testing.expect(e1 != nil, "b64 rejects non-alphabet")
    [_, e2] = base64.decode("Zg=")
    testing.expect(e2 != nil, "b64 rejects bad padding")
}

fn test_hex() {
    testing.expect(hex.encode("hello" as []byte) == "68656c6c6f", "hex encode")
    testing.expect(hex.encode("" as []byte) == "", "hex empty")
    [d, e] = hex.decode("68656c6c6f")
    ck(e, "hex decode")
    testing.expect(d as str == "hello", "hex round-trip")
    [_, e1] = hex.decode("abc")
    testing.expect(e1 != nil, "hex rejects odd length")
    [_, e2] = hex.decode("zz")
    testing.expect(e2 != nil, "hex rejects non-hex")
}

fn test_binary() {
    b := mkslice(byte, 16)
    binary.put_le_u16(b, 0, 4660)
    testing.expect(b[0] == 52 && b[1] == 18, "put_le_u16 layout")
    testing.expect(binary.le_u16(b, 0) == 4660, "le_u16 round-trip")
    binary.put_be_u16(b, 0, 4660)
    testing.expect(b[0] == 18 && b[1] == 52, "put_be_u16 layout")
    testing.expect(binary.be_u16(b, 0) == 4660, "be_u16 round-trip")
    binary.put_le_u32(b, 0, 3735928559)
    testing.expect(binary.le_u32(b, 0) == 3735928559, "le_u32 round-trip")
    binary.put_be_u32(b, 4, 3735928559)
    testing.expect(binary.be_u32(b, 4) == 3735928559, "be_u32 round-trip")
    testing.expect(b[0] != b[4], "le vs be byte order differs")
    binary.put_le_u64(b, 0, 81985529216486895)
    testing.expect(binary.le_u64(b, 0) == 81985529216486895, "le_u64 round-trip")
    // negative values keep the two's-complement pattern — a signed
    // % / / split at the 32-bit seam emits wrong halves otherwise
    binary.put_le_u64(b, 0, -1)
    testing.expect(b[0] == 255 && b[3] == 255 && b[4] == 255 && b[7] == 255, "le_u64 -1 layout")
    testing.expect(binary.le_u64(b, 0) == -1, "le_u64 -1 round-trip")
    binary.put_be_u64(b, 0, -2)
    testing.expect(b[0] == 255 && b[3] == 255 && b[4] == 255 && b[7] == 254, "be_u64 -2 layout")
    testing.expect(binary.be_u64(b, 0) == -2, "be_u64 -2 round-trip")
}

fn test_csv() {
    [r, e] = csv.read_all("a,b,c\nd,e,f\n")
    ck(e, "csv basic")
    testing.expect(len(r) == 2, "csv rows")
    testing.expect(len(r[0]) == 3 && r[0][0] == "a" && r[0][1] == "b" && r[0][2] == "c", "csv row 0")
    testing.expect(len(r[1]) == 3 && r[1][0] == "d" && r[1][2] == "f", "csv row 1")
    // quoted: embedded comma + escaped quote + CRLF rows
    [r2, e2] = csv.read_all("\"x,y\",\"q\"\"z\"\r\nlast,one")
    ck(e2, "csv quoted")
    testing.expect(len(r2) == 2, "csv quoted rows")
    testing.expect(r2[0][0] == "x,y", "csv embedded comma")
    testing.expect(r2[0][1] == "q\"z", "csv escaped quote")
    testing.expect(r2[1][0] == "last" && r2[1][1] == "one", "csv crlf split")
    // format round-trip
    out := csv.format(r)
    [r3, e3] = csv.read_all(out)
    ck(e3, "csv format reparse")
    testing.expect(len(r3) == 2 && r3[0][0] == "a" && r3[1][2] == "f", "csv format round-trip")
    // quoting is applied only when needed
    fq := csv.format_record(r2[0])
    testing.expect(find(fq, "\"") >= 0, "csv format_record quotes comma field")
    fp := csv.format_record(r[0])
    testing.expect(fp == "a,b,c", "csv format_record plain")
}

fn main() {}
