// Regression: break/continue/return inside a loop-nested scope must
// join the scope's children before transferring control — the old
// lowering emitted a bare goto, orphaning the children and leaving the
// frame-resident RtScope unclosed. `started` and `finished` must be
// equal the moment each fn returns: a missed join would return while
// the last leaf still sleeps.
import "std/time"

fn leaf(s: shared, f: shared) {
    sadd(s, 1)
    time.sleep_ms(40)
    sadd(f, 1)
}

fn with_break(s: shared, f: shared) {
    i := 0
    for i < 20 {
        scope {
            spawn leaf(s, f)
            if i >= 4 {
                break
            }
        }
        i = i + 1
    }
}

fn with_continue(s: shared, f: shared) {
    i := 0
    for i < 5 {
        scope {
            spawn leaf(s, f)
            i = i + 1
            continue
        }
    }
}

fn with_return(s: shared, f: shared) {
    i := 0
    for i < 20 {
        scope {
            spawn leaf(s, f)
            if i >= 4 {
                return
            }
        }
        i = i + 1
    }
}

// break from two scopes deep must drain innermost first
fn nested(s: shared, f: shared) {
    i := 0
    for i < 10 {
        scope {
            spawn leaf(s, f)
            scope {
                spawn leaf(s, f)
                if i == 2 {
                    break
                }
                i = i + 1
            }
        }
    }
}

fn main() {
    s := mkshared(0)
    f := mkshared(0)
    with_break(s, f)
    assert(sadd(s, 0) == sadd(f, 0))
    with_continue(s, f)
    assert(sadd(s, 0) == sadd(f, 0))
    with_return(s, f)
    assert(sadd(s, 0) == sadd(f, 0))
    nested(s, f)
    assert(sadd(s, 0) == sadd(f, 0))
    println("scope-exit ok")
}
