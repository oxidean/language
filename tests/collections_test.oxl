import "std/collections"

fn main() {
    m := collections.map_new()
    // 10k set/get — exercises growth from 16 → 32768 buckets
    i := 0
    for i < 10000 {
        collections.map_set(m, "k" + itoa(i), i)
        i = i + 1
    }
    assert(collections.map_len(m) == 10000)
    i = 0
    bad := 0
    for i < 10000 {
        [v, e] = collections.map_get(m, "k" + itoa(i))
        if e != nil || v != i {
            bad = bad + 1
        }
        i = i + 1
    }
    assert(bad == 0)
    // overwrite keeps size, updates value
    collections.map_set(m, "k42", -1)
    assert(collections.map_len(m) == 10000)
    [v0, e0] = collections.map_get(m, "k42")
    assert(e0 == nil && v0 == -1)
    // miss -> err
    [_, e1] = collections.map_get(m, "nope")
    assert(e1 != nil)
    assert(!collections.map_has(m, "nope"))
    // delete removes, len tracks — "k7777" stays outside the
    // k0..k4999 mass-delete below so the count stays honest
    collections.map_del(m, "k7777")
    assert(!collections.map_has(m, "k7777"))
    assert(collections.map_len(m) == 9999)
    collections.map_del(m, "nope")   // missing del is a no-op
    assert(collections.map_len(m) == 9999)
    // delete mid-chain + head-of-bucket both work — hammer deletes
    i = 0
    for i < 5000 {
        collections.map_del(m, "k" + itoa(i))
        i = i + 1
    }
    assert(collections.map_len(m) == 4999)
    i = 0
    bad = 0
    for i < 10000 {
        want := 0
        if i < 5000 || i == 7777 { want = 1 }
        [v2, e2] = collections.map_get(m, "k" + itoa(i))
        if want == 1 {
            if e2 == nil { bad = bad + 1 }
        } else {
            if e2 != nil || v2 != i { bad = bad + 1 }
        }
        i = i + 1
    }
    assert(bad == 0)

    s := collections.set_new()
    collections.set_add(s, "a")
    collections.set_add(s, "b")
    collections.set_add(s, "a")   // dup is idempotent
    assert(collections.set_has(s, "a"))
    assert(collections.set_has(s, "b"))
    assert(!collections.set_has(s, "c"))
    collections.set_del(s, "a")
    assert(!collections.set_has(s, "a"))
    assert(collections.set_has(s, "b"))
    println("collections ok")
}
