// A2 select fairness: the pick must be uniform over the READY arms,
// not over arm positions. With a never-ready third arm, a random-start
// first-ready sweep lands on arm a with P=2/3 (starts at a, or wraps
// through empty c back to a) — the fair pick is 1/2 each.
import "std/time"

fn producer(c: chan, v: int, n: int) {
    i := 0
    for i < n {
        send(c, v) // parks when full; close() completes the rest
        i = i + 1
    }
}

fn main() {
    n := 10000
    a := mkchan(16)
    b := mkchan(16)
    c := mkchan() // never sends: keeps the ready set partial
    na := 0
    scope {
        spawn producer(a, 1, n)
        spawn producer(b, 2, n)
        i := 0
        for i < n {
            select {
                v := recv(a) => {
                    na = na + v // v is always 1: na counts a-picks
                }
                w := recv(b) => {}
                x := recv(c) => {
                    na = na - x // unreachable — silences unused binding
                }
            }
            i = i + 1
        }
        // producers oversupplied (2n for n picks): close completes
        // their parked sends silently so the join can't hang
        close(a)
        close(b)
        close(c)
    }
    println("na=" + itoa(na))
    // fair: na ≈ n/2; the positional sweep gives ≈ 2n/3 and fails
    d := na - n / 2
    if d < 0 {
        d = -d
    }
    assert(d < n / 25)
    println("select fair ok a=" + itoa(na))
}
