package main

// S4 acceptance: crypto/sha256 + crypto/md5 published vectors (empty,
// abc, quick-brown-fox, 55/56/64 padding boundaries); hmac RFC 2202
// (md5) + RFC 4231 (sha256) cases 1-2; incremental == one-shot.
import "std/crypto/sha256"

import "std/crypto/md5"

import "std/crypto/hmac"

import "std/encoding/hex"

import "std/testing"

import "std/errors"

fn ck(e: err, m: str) {
    testing.expect(e == nil, m + ": " + errors.msg(e))
}

fn rep(n: int) -> str {
    s := ""
    i := 0
    for i < n {
        s = s + "a"
        i = i + 1
    }
    return s
}

fn test_sha256() {
    testing.expect(sha256.hexdigest("" as []byte) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256 empty")
    testing.expect(sha256.hexdigest("abc" as []byte) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 abc")
    testing.expect(sha256.hexdigest("The quick brown fox jumps over the lazy dog" as []byte) == "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592", "sha256 fox")
    testing.expect(sha256.hexdigest(rep(55) as []byte) == "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318", "sha256 a*55")
    testing.expect(sha256.hexdigest(rep(56) as []byte) == "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a", "sha256 a*56")
    testing.expect(sha256.hexdigest(rep(64) as []byte) == "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb", "sha256 a*64")
    testing.expect(len(sha256.sum256("abc" as []byte)) == 32, "sha256 digest len")
    // incremental write == one-shot
    h := sha256.new()
    [_w1, _e1] = h.write("ab" as []byte)
    [_w2, _e2] = h.write("c" as []byte)
    s := h.sum(nil)
    testing.expect(hex.encode(s) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 incremental")
    testing.expect(h.blocksize() == 64, "sha256 blocksize")
}

fn test_md5() {
    testing.expect(md5.hexdigest("" as []byte) == "d41d8cd98f00b204e9800998ecf8427e", "md5 empty")
    testing.expect(md5.hexdigest("abc" as []byte) == "900150983cd24fb0d6963f7d28e17f72", "md5 abc")
    testing.expect(md5.hexdigest("The quick brown fox jumps over the lazy dog" as []byte) == "9e107d9d372bb6826bd81d3542a419d6", "md5 fox")
    testing.expect(md5.hexdigest(rep(55) as []byte) == "ef1772b6dff9a122358552954ad0df65", "md5 a*55")
    testing.expect(md5.hexdigest(rep(56) as []byte) == "3b0c8ac703f828b04c6c197006d17218", "md5 a*56")
    testing.expect(md5.hexdigest(rep(64) as []byte) == "014842d480b571495a4a0363793f7367", "md5 a*64")
    h := md5.new()
    [_w1, _e1] = h.write("ab" as []byte)
    [_w2, _e2] = h.write("c" as []byte)
    s := h.sum(nil)
    testing.expect(hex.encode(s) == "900150983cd24fb0d6963f7d28e17f72", "md5 incremental")
}

fn hx(b: own []byte) -> str {
    return hex.encode(b)
}

fn test_hmac() {
    // RFC 2202 md5 cases 1-2: key 16x0x0b / "Jefe"
    kb := mkslice(byte, 16)
    i := 0
    for i < 16 {
        kb[i] = 11
        i = i + 1
    }
    h := hmac.new(md5.new, kb)
    [_w, _e] = h.write("Hi There" as []byte)
    testing.expect(hx(h.sum(nil)) == "9294727a3638bb1c13f48ef8158bfc9d", "hmac-md5 c1")
    h2 := hmac.new(md5.new, "Jefe" as []byte)
    [_w_h2, _e_h2] = h2.write("what do ya want for nothing?" as []byte)
    testing.expect(hx(h2.sum(nil)) == "750c783e6ab0b503eaa86e310a5db738", "hmac-md5 c2")
    // RFC 4231 sha256 cases 1-2: key 20x0x0b / "Jefe"
    kb2 := mkslice(byte, 20)
    i = 0
    for i < 20 {
        kb2[i] = 11
        i = i + 1
    }
    h3 := hmac.new(sha256.new, kb2)
    [_w_h3, _e_h3] = h3.write("Hi There" as []byte)
    testing.expect(hx(h3.sum(nil)) == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", "hmac-sha256 c1")
    h4 := hmac.new(sha256.new, "Jefe" as []byte)
    [_w_h4, _e_h4] = h4.write("what do ya want for nothing?" as []byte)
    testing.expect(hx(h4.sum(nil)) == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843", "hmac-sha256 c2")
}

// retained hasher state must be heap-backed: a write inside a nested
// scope pushes into the scope arena without it, and a later sum reads
// freed storage (heap flag rides the header through views + growth)
fn test_scope_escape() {
    h := sha256.new()
    scope {
        [_w_s, _e_s] = h.write("abc" as []byte)
    }
    testing.expect(hx(h.sum(nil)) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 across scope")
    m := hmac.new(sha256.new, "key" as []byte)
    scope {
        [_w_m, _e_m] = m.write("abc" as []byte)
    }
    testing.expect(hx(m.sum(nil)) == "9c196e32dc0175f86f4b1cb89289d6619de6bee699e4c378e68309ed97a1a6ab", "hmac across scope")
}

fn main() {}
