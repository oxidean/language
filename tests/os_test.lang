import "std/os"
import "std/testing"

fn test_args() {
    testing.expect(os.nargs() >= 1, "has args")
    testing.expect(len(os.args(0)) > 0, "argv0 nonempty")
}

fn test_file() {
    n := os.writefile_("/tmp/lang-ostest.txt", "hello os")
    testing.expect(n == 0, "write ok")
    testing.expect_streq(os.readfile_("/tmp/lang-ostest.txt"), "hello os", "read back")
}

fn main() {}
