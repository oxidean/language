package main

// d5 module qualification: namespaces, `as` alias, selective flatten,
// and two modules exporting the same name coexisting
import "oxl/tests/d5a"

import "oxl/tests/d5b"

import "std/strings" as s

import "std/strings".{trim}

fn main() {
    assert(d5a.f() == 1)
    assert(d5b.f() == 2)
    assert(s.trim("  x  ") == "x")
    assert(trim("  y  ") == "y")
    assert(strings.startswith("ab", "a"))
    println("d5 qual ok")
}
