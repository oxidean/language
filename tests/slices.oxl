package main

// B3: slices — []T is a {ptr,len,cap} fat header passed by value.
// mkslice/push/index/view per spec b3-slices.md

// pass-by-value: callee reads the same backing store
fn ssum(s: []int) -> int {
    t := 0
    i := 0
    for i < len(s) {
        t = t + s[i]
        i = i + 1
    }
    return t
}

// callee writes through the shared backing pointer
fn bump(s: []int) {
    i := 0
    for i < len(s) {
        s[i] = s[i] + 1
        i = i + 1
    }
}

// shape substitution: generic over the element type
fn first[T any](s: []T) -> T {
    return s[0]
}

// suspendable fn — slice header lives in the coroutine frame
fn worker(c: chan) {
    s := mkslice(int, 0)
    i := 0
    for i < 100 {
        s = push(s, i)
        i = i + 1
    }
    send(c, s[50] + len(s))
}

fn main() {
    // mkslice: len == cap == n, zeroed
    s := mkslice(int, 4)
    assert(len(s) == 4)
    assert(s[0] == 0)
    assert(s[3] == 0)

    // index write + read
    s[0] = 11
    s[3] = 44
    assert(s[0] == 11)
    assert(s[3] == 44)

    // push appends and grows the header — reassign
    s = push(s, 55)
    assert(len(s) == 5)
    assert(s[4] == 55)
    assert(s[0] == 11) // existing elems survived growth

    // resizable buffer without mkbuf: 10k pushes exercise doubling
    buf := mkslice(int, 0)
    i := 0
    for i < 10000 {
        buf = push(buf, i)
        i = i + 1
    }
    assert(len(buf) == 10000)
    assert(buf[0] == 0)
    assert(buf[9999] == 9999)
    assert(ssum(buf) == 49995000)

    // s[a:b] view: shares backing, own len
    v := buf[100:104]
    assert(len(v) == 4)
    assert(v[0] == 100)
    assert(v[3] == 103)

    // writes through the view are visible in the parent
    v[1] = 7777
    assert(buf[101] == 7777)
    // and parent writes are visible through the view
    buf[102] = 8888
    assert(v[2] == 8888)

    // open-ended and full views
    tail := buf[9998:]
    assert(len(tail) == 2)
    assert(tail[1] == 9999)
    head := buf[:3]
    assert(len(head) == 3)
    assert(head[2] == 2)
    all := buf[:]
    assert(len(all) == 10000)

    // callee mutation through the shared backing
    small := mkslice(int, 3)
    small[0] = 1
    small[1] = 2
    small[2] = 3
    bump(small)
    assert(small[0] == 2)
    assert(small[2] == 4)

    // generic shape substitution over the element type
    fs := mkslice(float, 2)
    fs[0] = 1.5
    fs[1] = 2.5
    assert(first(fs) == 1.5)
    assert(first(small) == 2)

    // own slice: header boxed, ops deref through it
    os := new(mkslice(int, 2))
    assert(len(os) == 2)
    os[0] = 7
    os[1] = 8
    assert(os[0] == 7)
    assert(len(os[0:1]) == 1)

    // slice in a suspendable frame: 100 pushes then send
    c := mkchan(1)
    scope {
        spawn worker(c)
    }
    assert(recv(c) == 150)

    println("slices ok")
}
