// std/http — minimal HTTP/1.1 server written in the language over libc
// sockets. Import with `import "std/http"` and hand `serve` a Handler:
//
//   interface Handler { route(method: str, path: str, body: str) -> Resp }
//   fn (a App) route(method: str, path: str, body: str) -> Resp { ... }
//   fn main() { serve(8080, App{}) }
//
// `h.route` is dispatched per request on the blocking pool; it returns a
// Resp — the status becomes the response's HTTP status line and the body
// is sent as text/plain.
extern fn socket(domain: int, ty: int, proto: int) -> int

extern fn bind(fd: int, addr: ref sockaddr, len: int) -> int

extern fn listen(fd: int, backlog: int) -> int

extern fn accept(fd: int, addr: mut sockaddr, len: mut intp) -> int

extern fn read(fd: int, buf: mut void, n: int) -> int

extern fn write(fd: int, buf: cstr, n: int) -> int

extern fn close(fd: int) -> int

extern fn setsockopt(fd: int, lvl: int, opt: int, v: ref intp, n: int) -> int

// explicit release for `own ?` buffers (mkbuf) — scope arenas don't
// reclaim them, so a per-request scratch must be freed by hand
extern fn rt_free(p: mut void)

// signal(2): SIGPIPE(13) + SIG_IGN(1) — a client that resets mid-write
// must not kill the process before write() returns an error
extern fn signal(sig: int, handler: int) -> int

// heap try-scope for per-conn trap containment — the runtime's
// documented contract (rt_scope_try): join returns the trap code
// instead of propagating it to the parent scope
extern fn rt_scope_new() -> own void

extern fn rt_scope_join_free(s: mut void) -> int

struct sockaddr { a: int, b: int } // 16 bytes: sockaddr_in fits

struct intp { v: int }

/// handler result: the HTTP status code plus the text/plain body
struct Resp { status: int, body: str }

/// request handler — implement `route` on your app struct and pass it
/// to `serve`; dispatched per connection on the blocking pool
interface Handler { route(method: str, path: str, body: str) -> Resp }

fn status_text(status: int) -> str {
    if status == 200 {
        return "OK"
    }
    if status == 201 {
        return "Created"
    }
    if status == 400 {
        return "Bad Request"
    }
    if status == 404 {
        return "Not Found"
    }
    if status == 405 {
        return "Method Not Allowed"
    }
    if status == 500 {
        return "Internal Server Error"
    }
    return "Status"
}

fn http_resp(status: int, body: str) -> str {
    return "HTTP/1.1 " + itoa(status) + " " + status_text(status) + "\r\ncontent-type: text/plain\r\ncontent-length: " + itoa(len(body)) + "\r\n\r\n" + body
}

/// in-flight connection cap — accept()s past it are closed at once so
/// a flood can't pile up unbounded blocking-pool threads
let MAX_CONN = 64

/// release the conn slot and the fd on EVERY exit — normal return,
/// early read failure, and handler trap (the runtime drains task
/// defers on trap unwind, so a trapping route can't leak either)
fn conn_cleanup(fd: int, inflight: shared) {
    close(fd)
    sadd(inflight, -1)
}

/// runs one request through the handler and writes the response.
/// Spawned inside the conn's try-scope — a trap in here marks only
/// that scope, so serve's shared scope and every sibling connection
/// survive a bad handler
fn route_serve(h: Handler, method: str, path: str, body: str, fd: int) {
    r := h.route(method, path, body)
    resp := http_resp(r.status, r.body)
    write(fd, cstr(resp), len(resp))
}

fn handle_conn(h: Handler, fd: int, inflight: shared) {
    defer conn_cleanup(fd, inflight)
    // conn-scoped arena: the request buffer + parse garbage die when the
    // handler returns instead of accumulating in the serve scope
    scope {
        set_rcvtimo(fd, 10) // slowloris guard: reads give up after 10s
        buf := mkbuf(4096)
        n := read(fd, buf, 4095)
        if n > 0 {
            req := bufstr(buf, n)
            rt_free(buf) // `own` scratch: done once the bytes are copied

            // "METHOD PATH HTTP/1.x" — split on the first two spaces
            sp1 := find(req, " ")
            rest := substr(req, sp1 + 1, len(req))
            sp2 := find(rest, " ")
            path := substr(rest, 0, sp2)
            method := substr(req, 0, sp1)
            hdr_end := find(req, "\r\n\r\n")
            body := ""
            if hdr_end >= 0 {
                body = substr(req, hdr_end + 4, len(req))
            }

            // per-conn trap containment: route_serve runs as a nested
            // task inside a heap try-scope. Its trap stops at
            // rt_scope_join_free instead of propagating through serve's
            // shared spawn scope and cancelling sibling handlers
            rsc := rt_scope_new()
            spawnBlocking route_serve(h, method, path, body, fd)
            if rt_scope_join_free(rsc) != 0 {
                resp := http_resp(500, "handler trapped\n")
                write(fd, cstr(resp), len(resp))
            }
        } else {
            rt_free(buf) // unread/failed read: scratch still must die
        }
    }
}

/// listen+serve on port; dispatches `h.route` per request
fn serve(port: int, h: Handler) {
    signal(13, 1) // SIGPIPE, SIG_IGN — reset clients must not kill us
    srv := socket(2, 1, 0) // AF_INET, SOCK_STREAM
    one := new(intp)
    one.v = 1
    setsockopt(srv, 1, 2, one, 4) // SOL_SOCKET, SO_REUSEADDR

    addr := new(sockaddr)
    // sockaddr_in: family (host order) | port (network order) | addr | zero
    poke8(addr, 0, 2) // sin_family = AF_INET (LE pair 02 00)
    poke8(addr, 1, 0)
    poke16(addr, 2, port) // sin_port = htons(port)
    poke32(addr, 4, 0) // sin_addr = INADDR_ANY
    if bind(srv, addr, 16) != 0 || listen(srv, 64) != 0 {
        // a failed bind/listen makes every accept return -1 at once:
        // the serve loop would spin at 100% CPU serving nothing
        close(srv)
        println("serve: bind/listen failed on :" + itoa(port))
        exit(1)
    }
    println("listening on :" + itoa(port))

    inflight := mkshared(0)
    scope {
        for true {
            cfd := accept(srv, addr, one)
            if cfd >= 0 {
                // claim a slot before spawning; sadd returns the OLD count
                if sadd(inflight, 1) >= MAX_CONN {
                    sadd(inflight, -1)
                    close(cfd)
                } else {
                    spawnBlocking handle_conn(h, cfd, inflight)
                }
            } else {
                // persistent accept errors (EMFILE and friends) would
                // spin the accept loop — back off briefly and retry
                usleep(50000)
            }
        }
    }
}
