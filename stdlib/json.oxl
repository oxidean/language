// std/json — a minimal JSON value tree, serializer, and parser.
//
// One node type carries everything:
//   kind: 0 null · 1 bool · 2 int · 3 str · 4 obj · 5 arr
//   key:  member name when this node sits inside an object
//   s/i/b: payload for str/int/bool nodes
//   child: first member (obj) or element (arr) — a linked list via next
//
// Numbers are ints only; string escapes handle \" \\ \n \t. That covers
// the pilot and config-file cases; floats/unicode escapes are v1 work.
// explicit release for `own ?` buffers (mkbuf) — scope arenas don't
// reclaim them, so a temporary scratch must be freed by hand
extern fn rt_free(p: mut void)

struct Json {
    kind: int,
    key: str,
    s: str,
    i: int,
    f: float,
    b: bool,
    child: own Json,
    next: own Json,
}

fn jnull() -> own Json {
    j := new(Json)
    j.kind = 0
    return j
}

fn jbool(v: bool) -> own Json {
    j := new(Json)
    j.kind = 1
    j.b = v
    return j
}

fn jint(v: int) -> own Json {
    j := new(Json)
    j.kind = 2
    j.i = v
    return j
}

fn jfloat(v: float) -> own Json {
    j := new(Json)
    j.kind = 6
    j.f = v
    return j
}

fn jstr(v: str) -> own Json {
    j := new(Json)
    j.kind = 3
    j.s = v
    return j
}

fn jobj() -> own Json {
    j := new(Json)
    j.kind = 4
    return j
}

fn jarr() -> own Json {
    j := new(Json)
    j.kind = 5
    return j
}

/// append member/element; key is ignored for arrays
fn jadd(parent: mut Json, key: str, val: own Json) {
    val.key = key
    if parent.child == nil {
        parent.child = val
        return
    }
    last := parent.child
    for last.next != nil {
        last = last.next
    }
    last.next = val
}

/// first member with this key, or nil
fn jget(obj: ref Json, key: str) -> own Json {
    m := obj.child
    for m != nil {
        if m.key == key {
            return m
        }
        m = m.next
    }
    return m
}

// ---------- serialize ----------
fn jescape(s: str) -> str {
    out := ""
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c == 34 {
            out = out + "\\\""
        }
        if c == 92 {
            out = out + "\\\\"
        }
        if c == 10 {
            out = out + "\\n"
        }
        if c == 9 {
            out = out + "\\t"
        }
        if c == 13 {
            out = out + "\\r"
        }
        // RFC 8259: every other byte below 0x20 needs a \u00XX escape
        if c < 32 && c != 10 && c != 9 && c != 13 {
            out = out + "\\u00" + substr("0123456789abcdef", c / 16, c / 16 + 1) + substr("0123456789abcdef", c % 16, c % 16 + 1)
        }
        if c != 34 && c != 92 && c >= 32 {
            out = out + substr(s, i, i + 1)
        }
        i = i + 1
    }
    return out
}

fn tojson(j: ref Json) -> str {
    if j == nil {
        return "null"
    }
    if j.kind == 0 {
        return "null"
    }
    if j.kind == 1 {
        if j.b {
            return "true"
        }
        return "false"
    }
    if j.kind == 2 {
        return itoa(j.i)
    }
    if j.kind == 6 {
        return ftoa(j.f)
    }
    if j.kind == 3 {
        return "\"" + jescape(j.s) + "\""
    }
    out := ""
    if j.kind == 4 {
        out = "{"
    } else {
        out = "["
    }
    m := j.child
    first := true
    for m != nil {
        if first {
            first = false
        } else {
            out = out + ","
        }
        if j.kind == 4 {
            out = out + "\"" + jescape(m.key) + "\":" + tojson(m)
        } else {
            out = out + tojson(m)
        }
        m = m.next
    }
    if j.kind == 4 {
        out = out + "}"
    } else {
        out = out + "]"
    }
    return out
}

// ---------- parse ----------
struct JCur { src: str, pos: int }

fn jskipws(p: mut JCur) {
    for p.pos < len(p.src) {
        c := byteat(p.src, p.pos)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            return
        }
        p.pos = p.pos + 1
    }
}

// 4 hex digits -> code point (invalid digits fold to 0)
fn hex4(s: str) -> int {
    v := 0
    i := 0
    for i < 4 {
        c := byteat(s, i)
        d := 0
        if c >= 48 && c <= 57 {
            d = c - 48
        } else if c >= 97 && c <= 102 {
            d = c - 87
        } else if c >= 65 && c <= 70 {
            d = c - 55
        }
        v = v * 16 + d
        i = i + 1
    }
    return v
}

// code point -> UTF-8 string (the lexer only accepts \n \t \r \0 \\ \"
// escapes in source, so control bytes are built through mkbuf)
fn utf8_1(cp: int) -> str {
    buf := mkbuf(1)
    poke8(buf, 0, cp)
    out := bufstr(buf, 1)
    rt_free(buf)
    return out
}

fn utf8_2(cp: int) -> str {
    buf := mkbuf(2)
    poke8(buf, 0, 192 + cp / 64)
    poke8(buf, 1, 128 + cp % 64)
    out := bufstr(buf, 2)
    rt_free(buf)
    return out
}

fn utf8_3(cp: int) -> str {
    buf := mkbuf(3)
    poke8(buf, 0, 224 + cp / 4096)
    poke8(buf, 1, 128 + cp / 64 % 64)
    poke8(buf, 2, 128 + cp % 64)
    out := bufstr(buf, 3)
    rt_free(buf)
    return out
}

fn jparse_str(p: mut JCur) -> str {
    p.pos = p.pos + 1 // opening quote
    out := ""
    for p.pos < len(p.src) {
        c := byteat(p.src, p.pos)
        if c == 34 {
            p.pos = p.pos + 1
            return out
        }
        if c == 92 {
            p.pos = p.pos + 1
            e := byteat(p.src, p.pos)
            if e == 110 {
                out = out + "\n"
            }
            if e == 116 {
                out = out + "\t"
            }
            if e == 114 {
                out = out + "\r"
            }
            if e == 98 {
                out = out + utf8_1(8) // \b
            }
            if e == 102 {
                out = out + utf8_1(12) // \f
            }
            if e == 47 {
                out = out + "/"
            }
            if e == 34 {
                out = out + "\""
            }
            if e == 92 {
                out = out + "\\"
            }
            if e == 117 && p.pos + 4 < len(p.src) {
                // \uXXXX — UTF-8 encoded (surrogate pairs are v1 work)
                cp := hex4(substr(p.src, p.pos + 1, p.pos + 5))
                if cp < 128 {
                    out = out + utf8_1(cp)
                } else if cp < 2048 {
                    out = out + utf8_2(cp)
                } else {
                    out = out + utf8_3(cp)
                }
                p.pos = p.pos + 4
            }
            p.pos = p.pos + 1
        } else {
            out = out + substr(p.src, p.pos, p.pos + 1)
            p.pos = p.pos + 1
        }
    }
    return out
}

fn jparse_num(p: mut JCur) -> own Json {
    start := p.pos
    isf := 0
    for p.pos < len(p.src) {
        c := byteat(p.src, p.pos)
        // digits, sign, '.', exponent
        if c >= 48 && c <= 57 || c == 45 || c == 43 {
            p.pos = p.pos + 1
            continue
        }
        if c == 46 || c == 101 || c == 69 { // . e E
            isf = 1
            p.pos = p.pos + 1
            continue
        }
        break
    }
    if p.pos == start {
        // no numeric chars consumed — swallow the offending char so
        // callers looping on jparse_val (`[x]`, `[a,1]`) still advance
        if p.pos < len(p.src) {
            p.pos = p.pos + 1
        }
        return jnull()
    }
    if isf == 1 {
        return jfloat(atof(substr(p.src, start, p.pos)))
    }
    return jint(atoi(substr(p.src, start, p.pos)))
}

fn jparse_val(p: mut JCur) -> own Json {
    jskipws(p)
    if p.pos >= len(p.src) {
        return jnull()
    }
    c := byteat(p.src, p.pos)
    if c == 34 {
        return jstr(jparse_str(p))
    }
    if c == 123 { // {
        o := jobj()
        p.pos = p.pos + 1
        for p.pos < len(p.src) {
            jskipws(p)
            if byteat(p.src, p.pos) == 125 { // }
                p.pos = p.pos + 1
                return o
            }
            k := jparse_str(p)
            jskipws(p)
            p.pos = p.pos + 1 // :
            jadd(o, k, jparse_val(p))
            jskipws(p)
            if byteat(p.src, p.pos) == 44 { // ,
                p.pos = p.pos + 1
            }
        }
        return o
    }
    if c == 91 { // [
        a := jarr()
        p.pos = p.pos + 1
        for p.pos < len(p.src) {
            jskipws(p)
            if byteat(p.src, p.pos) == 93 { // ]
                p.pos = p.pos + 1
                return a
            }
            jadd(a, "", jparse_val(p))
            jskipws(p)
            if byteat(p.src, p.pos) == 44 {
                p.pos = p.pos + 1
            }
        }
        return a
    }
    if c == 116 { // true
        p.pos = p.pos + 4
        return jbool(true)
    }
    if c == 102 { // false
        p.pos = p.pos + 5
        return jbool(false)
    }
    if c == 110 { // null
        p.pos = p.pos + 4
        return jnull()
    }
    return jparse_num(p)
}

/// parse text into a Json tree (null node on malformed input)
fn jparse(src: str) -> own Json {
    p := new(JCur)
    p.src = src
    p.pos = 0
    return jparse_val(p)
}
