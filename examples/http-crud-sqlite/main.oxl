// HTTP CRUD + SQLite pilot — the v0.0.1 success bar for services.
// Now built on std/http: the server plumbing lives in stdlib, this file
// only declares the route handler.
//
//   oxl run examples/http-crud-sqlite/main.oxl
//   curl localhost:8080/items             → list rows
//   curl -d 'widget' localhost:8080/items → insert row
import "std/http"

import "std/json"

import "std/strings"

// one shared connection for the whole process — sqlite's serialized
// mode (THREADSAFE=1) provides the write lock; no per-request open/close
let db = sqlite_open(cstr("pilot.db"))

struct App { d: int }

// control bytes have no place in a stored name: NUL truncates the row
// at read (rt_sqlite_query treats columns as C strings) and raw bytes
// < 0x20 would make the JSON response invalid — jstr doesn't escape
// them. One byteat scan rejects the whole class, newlines included.
fn has_ctl(s: str) -> bool {
    i := 0
    for i < len(s) {
        if byteat(s, i) < 32 {
            return true
        }
        i = i + 1
    }
    return false
}

fn (a App) route(method: str, path: str, reqbody: str) -> http.Resp {
    status := 404
    body := "oxl http server — try /items\n"
    if find(path, "/items") == 0 {
        if find(method, "POST") == 0 {
            status = 201
            if has_ctl(reqbody) {
                // sqlite_query emits newline-delimited rows — a stored
                // newline would also split one row into two on read.
                status = 400
                body = "{\"error\":\"name must not contain control bytes\"}\n"
            } else if sqlite_exec_bind(db, cstr("INSERT INTO items VALUES(?)"), reqbody) != 0 {
                // ^ request body is bound, never concatenated into SQL
                status = 500
                body = "{\"error\":\"insert failed\"}\n"
            } else {
                r := json.jobj()
                json.jadd(r, "created", json.jstr(reqbody))
                body = json.tojson(r) + "\n"
            }
        } else if sqlite_exec(db, cstr("SELECT rowid, name FROM items")) != 0 {
            // sqlite_exec can't return rows, but its status answers
            // what sqlite_query's bare "" conflates: a failed SELECT
            // vs. an empty table. Failure is a 500, not {items:[]}.
            status = 500
            body = "{\"error\":\"query failed\"}\n"
        } else {
            status = 200
            // rows arrive as "id|name" lines — reshape into real JSON
            items := json.jarr()
            rows := strings.split(sqlite_query(db, cstr("SELECT rowid, name FROM items")), "\n")
            r := rows
            for r != nil {
                if len(r.v) > 0 {
                    item := json.jobj()
                    idstr := ""
                    nm := r.v
                    sep := find(r.v, "|")
                    if sep >= 0 {
                        idstr = substr(r.v, 0, sep)
                        nm = substr(r.v, sep + 1, len(r.v))
                    }
                    json.jadd(item, "id", json.jint(atoi(idstr)))
                    json.jadd(item, "name", json.jstr(nm))
                    json.jadd(items, "", item)
                }
                r = r.next
            }
            res := json.jobj()
            json.jadd(res, "items", items)
            body = json.tojson(res) + "\n"
        }
    }
    return http.Resp{status: status, body: body}
}

fn main() {
    // table exists before the first request — a fresh db must serve
    // {items:[]}, not a query error, and the SELECT probe above only
    // means "failed" once the table is guaranteed to exist.
    if sqlite_exec(db, cstr("CREATE TABLE IF NOT EXISTS items(name TEXT)")) != 0 {
        println("pilot: db init failed")
        exit(1)
    }
    http.serve(8080, App{d: 0})
}
