// HTTP CRUD + SQLite pilot — the v0.0.1 success bar for services.
// Now built on std/http: the server plumbing lives in stdlib, this file
// only declares the route.
//
//   lang run examples/http-crud-sqlite/main.lang
//   curl localhost:8080/items             → list rows
//   curl -d 'widget' localhost:8080/items → insert row

import "std/http"
import "std/json"
import "std/strings"

// one shared connection for the whole process — sqlite's serialized
// mode (THREADSAFE=1) provides the write lock; no per-request open/close
let db = sqlite_open(cstr("pilot.db"))

fn route(method: str, path: str, reqbody: str) -> str {
    body := ""
    if find(path, "/items") == 0 {
        if find(method, "POST") == 0 {
            sqlite_exec(db, cstr("CREATE TABLE IF NOT EXISTS items(name TEXT)"))
            sqlite_exec(db, cstr("INSERT INTO items VALUES('" + reqbody + "')"))
            r := jobj()
            jadd(r, "created", jstr(reqbody))
            body = tojson(r) + "\n"
        } else {
            // rows arrive as "id|name" lines — reshape into real JSON
            items := jarr()
            rows := split(sqlite_query(db, cstr("SELECT rowid, name FROM items")), "\n")
            r := rows
            for r != nil {
                if len(r.v) > 0 {
                    item := jobj()
                    idstr := ""
                    nm := r.v
                    sep := find(r.v, "|")
                    if sep >= 0 {
                        idstr = substr(r.v, 0, sep)
                        nm = substr(r.v, sep + 1, len(r.v))
                    }
                    jadd(item, "id", jint(atoi(idstr)))
                    jadd(item, "name", jstr(nm))
                    jadd(items, "", item)
                }
                r = r.next
            }
            res := jobj()
            jadd(res, "items", items)
            body = tojson(res) + "\n"
        }
    } else {
        body = "lang http server — try /items\n"
    }
    return body
}

fn main() {
    serve(8080)
}
