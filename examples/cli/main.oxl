package main

// simple CLI pilot: greets by name, counts to n — exercises argv,
// the std/flag package end to end, and [v, err] error handling.
//
//   oxl run examples/cli/main.oxl -- -n=3 Jesse
//   → "hello, Jesse" / 0 / 1 / 2
import "std/flag"

fn greet(name: str) -> str {
    return "hello, " + name
}

fn main() {
    fs := flag.newset("cli")
    flag.int_(fs, "n", 0, "count lines to print")
    flag.boolean(fs, "v", 0, "verbose greeting")
    [_, err] = flag.parse(fs)
    if err != nil {
        // parse already wrote the message and usage to stderr
        exit(2)
    }
    pos := flag.args(fs)
    if len(pos) < 1 {
        f2 := flag.usage(fs)
        println(f2)
        exit(2)
    }
    println(greet(pos[0]))
    if flag.getb(fs, "v") {
        println("verbose mode on")
    }
    c := flag.geti(fs, "n")
    i := 0
    for i < c {
        println(itoa(i))
        i = i + 1
    }
}
