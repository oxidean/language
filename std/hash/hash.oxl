package hash

// std/hash — Go's hash surface: a Hash interface every algorithm
// implements (io.Writer + sum/reset/blocksize) plus one-shot helpers.
// All pure .oxl — fnv/adler32/crc32 are short enough that porting C
// would cost more than it buys.
/// Hash is an incremental digest — write bytes in, sum appends the
/// running digest to b and returns the grown slice (Go's Sum shape:
/// `sum(nil)` yields just the digest). reset returns to initial.
/// blocksize is the algorithm's chunk size (hmac keys off it).
/// The write contract is io.Writer's.
interface Hash {
    write(b: []byte) -> [int, err],
    sum(b: []byte) -> own []byte,
    reset(),
    blocksize() -> int,
}

let M32: int = 4294967295

// ---- fnv-1a ----

/// Fnv32 state.
struct Fnv32 { h: int }

/// Fnv64 state (fnv-1a 64).
struct Fnv64 { h: int }

fn (f mut Fnv32) write(b: []byte) -> [int, err] {
    i := 0
    for i < len(b) {
        f.h = (f.h ^ b[i]) * 16777619 & M32
        i = i + 1
    }
    return len(b), nil
}

fn (f mut Fnv32) sum(b: []byte) -> own []byte {
    // append the 4 big-endian digest bytes — Go's Sum shape
    r := mkslice(byte, 4)
    r[0] = f.h / 16777216 % 256
    r[1] = f.h / 65536 % 256
    r[2] = f.h / 256 % 256
    r[3] = f.h % 256
    return concat(b, r)
}

/// sum32 is the int read-out — Go's Sum32.
fn (f ref Fnv32) sum32() -> int {
    return f.h
}

fn (f mut Fnv32) reset() {
    f.h = 2166136261
}

fn (f mut Fnv32) blocksize() -> int {
    return 4
}

fn (f mut Fnv64) write(b: []byte) -> [int, err] {
    i := 0
    for i < len(b) {
        // int64 mul wraps — the fnv64 modulus is 2^64 itself, so the
        // wrap IS the spec's arithmetic (same pattern math/rand uses)
        f.h = (f.h ^ b[i]) * 1099511628211
        i = i + 1
    }
    return len(b), nil
}

fn (f mut Fnv64) sum(b: []byte) -> own []byte {
    r := mkslice(byte, 8)
    i := 0
    for i < 8 {
        r[i] = f.h / pow256(7 - i) % 256
        i = i + 1
    }
    return concat(b, r)
}

/// sum64 is the int read-out — Go's Sum64.
fn (f ref Fnv64) sum64() -> int {
    return f.h
}

fn (f mut Fnv64) reset() {
    f.h = -3750763034362895579
}

fn (f mut Fnv64) blocksize() -> int {
    return 8
}

/// new_fnv1a returns a fresh 32-bit FNV-1a hasher.
fn new_fnv1a() -> Hash {
    f := Fnv32{h: 2166136261}
    return f.ashash()
}

/// new_fnv1a64 returns a fresh 64-bit FNV-1a hasher.
fn new_fnv1a64() -> Hash {
    f := Fnv64{h: -3750763034362895579}
    return f.ashash()
}

/// fnv1a32 one-shot.
fn fnv1a32(b: []byte) -> int {
    h := 2166136261
    i := 0
    for i < len(b) {
        h = (h ^ b[i]) * 16777619 & M32
        i = i + 1
    }
    return h
}

/// fnv1a64 one-shot — the int64 bit pattern IS the u64 result.
fn fnv1a64(b: []byte) -> int {
    h := -3750763034362895579
    i := 0
    for i < len(b) {
        h = (h ^ b[i]) * 1099511628211
        i = i + 1
    }
    return h
}

// ---- adler32 (RFC 1950) ----

/// Adler32 state — a and b accumulators, RFC 1950.
struct Adler { a: int, b: int }

fn (d mut Adler) write(p: []byte) -> [int, err] {
    i := 0
    for i < len(p) {
        d.a = (d.a + p[i]) % 65521
        d.b = (d.b + d.a) % 65521
        i = i + 1
    }
    return len(p), nil
}

fn (d mut Adler) sum(b: []byte) -> own []byte {
    v := d.b * 65536 + d.a
    r := mkslice(byte, 4)
    r[0] = v / 16777216 % 256
    r[1] = v / 65536 % 256
    r[2] = v / 256 % 256
    r[3] = v % 256
    return concat(b, r)
}

/// sum32 is the int read-out.
fn (d ref Adler) sum32() -> int {
    return d.b * 65536 + d.a
}

fn (d mut Adler) reset() {
    d.a = 1
    d.b = 0
}

fn (d mut Adler) blocksize() -> int {
    return 4
}

/// new_adler32 returns a fresh Adler-32 hasher.
fn new_adler32() -> Hash {
    d := Adler{a: 1, b: 0}
    return d.ashash()
}

/// adler32 one-shot.
fn adler32(p: []byte) -> int {
    a := 1
    b := 0
    i := 0
    for i < len(p) {
        a = (a + p[i]) % 65521
        b = (b + a) % 65521
        i = i + 1
    }
    return b * 65536 + a
}

// ---- crc32 (IEEE 802.3, reflected poly 0xEDB88320) ----

/// Crc32 state — running crc register.
struct Crc { c: int }

let crc_tab: own []int = nil

// crc_table builds the 256-entry reflected table lazily — arithmetic
// shifts (the language has no >>): c/2 is >>1 on non-negative ints.
fn crc_table() -> own []int {
    if crc_tab == nil {
        t := mkslice(int, 256)
        i := 0
        for i < 256 {
            c := i
            k := 0
            for k < 8 {
                if c % 2 == 1 {
                    c = c / 2 ^ 3988292384
                } else {
                    c = c / 2
                }
                k = k + 1
            }
            t[i] = c & 4294967295
            i = i + 1
        }
        crc_tab = new(t)
    }
    return crc_tab
}

fn (d mut Crc) write(p: []byte) -> [int, err] {
    t := crc_table()
    i := 0
    for i < len(p) {
        d.c = t[(d.c ^ p[i]) % 256] ^ d.c / 256
        i = i + 1
    }
    return len(p), nil
}

fn (d mut Crc) sum(b: []byte) -> own []byte {
    v := d.c ^ 4294967295
    r := mkslice(byte, 4)
    r[0] = v / 16777216 % 256
    r[1] = v / 65536 % 256
    r[2] = v / 256 % 256
    r[3] = v % 256
    return concat(b, r)
}

/// sum32 is the int read-out.
fn (d ref Crc) sum32() -> int {
    return d.c ^ 4294967295
}

fn (d mut Crc) reset() {
    d.c = 4294967295
}

fn (d mut Crc) blocksize() -> int {
    return 4
}

/// new_crc32 returns a fresh IEEE CRC-32 hasher.
fn new_crc32() -> Hash {
    d := Crc{c: 4294967295}
    return d.ashash()
}

/// crc32 one-shot — IEEE polynomial, the checksum every zip/gzip/png
/// uses.
fn crc32(p: []byte) -> int {
    t := crc_table()
    c := 4294967295
    i := 0
    for i < len(p) {
        c = t[(c ^ p[i]) % 256] ^ c / 256
        i = i + 1
    }
    return c ^ 4294967295
}

// concat appends src bytes to a copy of dst — the sum() helper.
fn concat(dst: []byte, src: []byte) -> own []byte {
    out := mkslice(byte, len(dst) + len(src))
    i := 0
    for i < len(dst) {
        out[i] = dst[i]
        i = i + 1
    }
    for i < len(src) {
        out[len(dst) + i] = src[i]
        i = i + 1
    }
    return new(out)
}

// pow256 is 256**k as an int — no pow builtin; k stays small.
fn pow256(k: int) -> int {
    v := 1
    i := 0
    for i < k {
        v = v * 256
        i = i + 1
    }
    return v
}

fn (f Fnv32) ashash() -> Hash {
    return f
}

fn (f Fnv64) ashash() -> Hash {
    return f
}

fn (d Adler) ashash() -> Hash {
    return d
}

fn (d Crc) ashash() -> Hash {
    return d
}
