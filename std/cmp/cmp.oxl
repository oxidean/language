package cmp

// std/cmp — ordered-type helpers.
//
// `Ordered` is the constraint name generic fns bind on: a type
// satisfies it when the language's ordered ops (< <= > >=) work on
// it — int, float, byte, str today.

/// Ordered is satisfied by types supporting the ordered ops — the
/// builtin `ordered` op surfaced as a constraint name.
interface Ordered { ordered }

/// compare returns -1, 0, or 1 as a is less than, equal to, or
/// greater than b.
fn compare[T Ordered](a: T, b: T) -> int {
    if a < b {
        return -1
    }
    if a > b {
        return 1
    }
    return 0
}

/// min returns the smaller of a and b.
fn min[T Ordered](a: T, b: T) -> T {
    if a < b {
        return a
    }
    return b
}

/// max returns the larger of a and b.
fn max[T Ordered](a: T, b: T) -> T {
    if a > b {
        return a
    }
    return b
}
