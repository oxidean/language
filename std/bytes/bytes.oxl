package bytes

// std/bytes — []byte helpers + the growing Buffer. Slices passed in
// stay borrowed — Buffer never aliases caller memory (push reallocates
// into its own header). `tostr` is the zero-copy view; the str dies
// with the buffer's backing (same arena rules as every borrowed view).
//
// Boxing a Buffer into io.Reader/Writer COPIES it — writes land in the
// box, invisible to the variable. The as*/-methods are Go's `&buf`:
// they box a borrow of the receiver, so mutations write through to the
// value the caller still holds.

/// Buffer is a growable byte sink/source — io.ReadWriter over memory.
struct Buffer { buf: []byte, rd: int }

/// newbuffer — an empty Buffer.
fn newbuffer() -> Buffer {
    return Buffer{buf: mkslice(byte, 0), rd: 0}
}

/// write appends p; always [len(p), nil] — memory can't fail.
fn (b mut Buffer) write(p: []byte) -> [int, err] {
    i := 0
    for i < len(p) {
        b.buf = push(b.buf, p[i])
        i = i + 1
    }
    return len(p), nil
}

/// read drains up to len(p) unread bytes; 0,eof at end. The eof
/// sentinel is the shared interned one — io.eof() == this code.
fn (b mut Buffer) read(p: []byte) -> [int, err] {
    if b.rd >= len(b.buf) {
        return 0, err_eof()
    }
    n := len(b.buf) - b.rd
    if n > len(p) {
        n = len(p)
    }
    i := 0
    for i < n {
        p[i] = b.buf[b.rd + i]
        i = i + 1
    }
    b.rd = b.rd + n
    return n, nil
}

/// str views the unread region (zero-copy — dies with the buffer).
fn (b ref Buffer) str() -> str {
    return b.buf[b.rd:] as str
}

/// len of unread bytes.
fn (b ref Buffer) len() -> int {
    return len(b.buf) - b.rd
}

/// reset drops contents and the read offset.
fn (b mut Buffer) reset() {
    b.buf = mkslice(byte, 0)
    b.rd = 0
}

// shared interned sentinel — errors.new interns by message text
extern fn rt_err_new(msg: str) -> err

fn err_eof() -> err {
    return rt_err_new("EOF")
}

/// equal — byte-wise equality.
fn equal(a: []byte, b: []byte) -> bool {
    if len(a) != len(b) {
        return false
    }
    i := 0
    for i < len(a) {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/// compare — lexicographic order: -1, 0, +1.
fn compare(a: []byte, b: []byte) -> int {
    n := len(a)
    if len(b) < n {
        n = len(b)
    }
    i := 0
    for i < n {
        if a[i] < b[i] {
            return -1
        }
        if a[i] > b[i] {
            return 1
        }
        i = i + 1
    }
    if len(a) < len(b) {
        return -1
    }
    if len(a) > len(b) {
        return 1
    }
    return 0
}

/// index — first position of sub in b, or -1.
fn index(b: []byte, sub: []byte) -> int {
    if len(sub) == 0 {
        return 0
    }
    if len(sub) > len(b) {
        return -1
    }
    last := len(b) - len(sub)
    i := 0
    for i <= last {
        hit := true
        j := 0
        for j < len(sub) {
            if b[i + j] != sub[j] {
                hit = false
                break
            }
            j = j + 1
        }
        if hit {
            return i
        }
        i = i + 1
    }
    return -1
}

/// contains — whether sub appears in b.
fn contains(b: []byte, sub: []byte) -> bool {
    return index(b, sub) >= 0
}

/// tostr — zero-copy str view over the slice (backing outlives via own).
fn tostr(b: []byte) -> str {
    return b as str
}

import "std/io"

/// asreader boxes a borrow of this Buffer as an io.Reader — reads
/// drain the caller's value (Go's `&buf`).
fn (b mut Buffer) asreader() -> io.Reader {
    return b
}

/// aswriter boxes a borrow of this Buffer as an io.Writer — writes
/// grow the caller's value.
fn (b mut Buffer) aswriter() -> io.Writer {
    return b
}

/// asreadwriter boxes a borrow as an io.ReadWriter.
fn (b mut Buffer) asreadwriter() -> io.ReadWriter {
    return b
}
