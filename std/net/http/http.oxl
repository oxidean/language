package http

// std/net/http — HTTP/1.1 server + client over std/net. Import with
// `import "std/net/http"` and hand `serve` a Handler:
//
//   interface Handler { route(method: str, path: str, body: str) -> Resp }
//   fn (a App) route(method: str, path: str, body: str) -> Resp { ... }
//   fn main() { serve(8080, App{}) }
//
// `h.route` is dispatched per request on the blocking pool; it returns a
// Resp — the status becomes the response's HTTP status line and the body
// is sent as text/plain. Client side: `get`/`post` or a `Client` with a
// dial/read budget. HTTPS stays parked (no TLS — see impl-s4).
import "std/net"

import "std/io"

import "std/errors"

import "std/strconv"

// a client that resets mid-write must not kill the process before
// Conn.write() returns EPIPE — runtime wrapper (libc signal can't be
// extern'd portably: its real prototype clashes with int args)
extern fn rt_sigpipe_ignore()

// heap try-scope for per-conn trap containment — the runtime's
// documented contract (rt_scope_try): join returns the trap code
// instead of propagating it to the parent scope
extern fn rt_scope_new() -> own void

extern fn rt_scope_join_free(s: own void) -> int

/// handler result: the HTTP status code plus the text/plain body
/// ctype selects content-type; empty falls back to text/plain
struct Resp { status: int, body: str, ctype: str }

/// read_request result — status 0 ok · 400 malformed/never-terminated ·
/// 413 body over cap; on non-0 the caller writes the status and returns
struct ReqRead { status: int, req: str, body: str }

/// request handler — implement `route` on your app struct and pass it
/// to `serve`; dispatched per connection on the blocking pool
interface Handler { route(method: str, path: str, body: str) -> Resp }

fn status_text(status: int) -> str {
    if status == 200 {
        return "OK"
    }
    if status == 201 {
        return "Created"
    }
    if status == 400 {
        return "Bad Request"
    }
    if status == 413 {
        return "Payload Too Large"
    }
    if status == 404 {
        return "Not Found"
    }
    if status == 405 {
        return "Method Not Allowed"
    }
    if status == 500 {
        return "Internal Server Error"
    }
    return "Status"
}

/// ctype is caller-controlled — a handler that derives it from request
/// data could inject response headers with CR/LF, so it lands in the
/// same text/plain fallback as an empty value
fn has_crlf(s: str) -> bool {
    i := 0
    for i < len(s) {
        b := byteat(s, i)
        if b == 13 || b == 10 {
            return true
        }
        i = i + 1
    }
    return false
}

fn http_resp_ct(status: int, body: str, ctype: str) -> str {
    ct := ctype
    if len(ct) == 0 || has_crlf(ct) {
        ct = "text/plain"
    }
    return "HTTP/1.1 " + itoa(status) + " " + status_text(status) + "\r\ncontent-type: " + ct + "\r\ncontent-length: " + itoa(len(body)) + "\r\nconnection: close\r\n\r\n" + body
}

fn http_resp(status: int, body: str) -> str {
    return http_resp_ct(status, body, "")
}

/// in-flight connection cap — accept()s past it are closed at once so
/// a flood can't pile up unbounded blocking-pool threads
let MAX_CONN = 64

/// request body cap — bigger uploads get a 413 instead of a read loop
let MAX_BODY = 1048576

/// whole-request budget (ms) — set_rcvtimo caps each read at 10s, but a
/// client feeding a byte every 9s would hold the conn forever without
/// a fixed deadline measured from request start
let REQ_MS = 30000

/// release the conn slot and the fd on EVERY exit — normal return,
/// early read failure, and handler trap (the runtime drains task
/// defers on trap unwind, so a trapping route can't leak either)
fn conn_cleanup(c: net.Conn, inflight: shared) {
    c.close()
    sadd(inflight, -1)
}

/// Conn.write() may return short — loop until the whole response is on
/// the wire or the conn dies (n <= 0 covers EPIPE + resets). Dropping the
/// raw count would silently truncate bodies on a partial write.
fn write_all(c: net.Conn, s: str) {
    off := 0
    for off < len(s) {
        [n, e] = c.write(substr(s, off, len(s)) as []byte)
        if e != nil || n <= 0 {
            return
        }
        off = off + n
    }
}

/// runs one request through the handler and writes the response.
/// Spawned inside the conn's try-scope — a trap in here marks only
/// that scope, so serve's shared scope and every sibling connection
/// survive a bad handler
fn route_serve(h: Handler, method: str, path: str, body: str, c: net.Conn) {
    r := h.route(method, path, body)
    resp := http_resp_ct(r.status, r.body, r.ctype)
    write_all(c, resp)
}

/// lowercase copy for case-insensitive header lookup — header names
/// are case-insensitive but find() is byte-exact
fn lwr(s: str) -> str {
    b := s as []byte
    out := mkslice(byte, len(s))
    i := 0
    for i < len(s) {
        c := b[i]
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        out[i] = c
        i = i + 1
    }
    return out as str
}

/// index of needle in s at or after `from`, -1 when absent — find()
/// takes no offset, and substr()-copying the remaining block per match
/// allocates ~16KiB x N on repeated headers (request-smuggling inputs
/// are exactly the many-match case)
fn find_from(s: str, needle: str, from: int) -> int {
    last := len(s) - len(needle)
    i := from
    for i <= last {
        j := 0
        for j < len(needle) && byteat(s, i + j) == byteat(needle, j) {
            j = j + 1
        }
        if j == len(needle) {
            return i
        }
        i = i + 1
    }
    return -1
}

/// Content-Length value from a header block; -1 = malformed or
/// conflicting duplicates, 0 = absent. Matches only at header-line
/// starts so a request-target or x-content-length lookalike can't
/// inject a length, and every occurrence must carry the same trimmed
/// value — a disagreement is a smuggling attempt, not a pick-one (CWE-444)
fn content_length(req: str, hdr_end: int) -> int {
    hdrs := lwr(substr(req, 0, hdr_end))
    v := 0
    seen := false
    i := find_from(hdrs, "\r\ncontent-length:", 0)
    for i >= 0 {
        j := i + 17
        for j < len(hdrs) && (byteat(hdrs, j) == 32 || byteat(hdrs, j) == 9) {
            j = j + 1
        }
        w := 0
        nd := 0
        for j < len(hdrs) && byteat(hdrs, j) >= 48 && byteat(hdrs, j) <= 57 {
            w = w * 10 + (byteat(hdrs, j) - 48)
            if w > MAX_BODY {
                return w // past the cap — the caller answers 413
            }
            nd = nd + 1
            j = j + 1
        }
        for j < len(hdrs) && (byteat(hdrs, j) == 32 || byteat(hdrs, j) == 9) {
            j = j + 1
        }
        // value must end the line (or the header block): "12x" is malformed
        if nd == 0 || j < len(hdrs) && byteat(hdrs, j) != 13 {
            return -1
        }
        if seen && w != v {
            return -1 // conflicting duplicates — refuse to pick one
        }
        v = w
        seen = true
        i = find_from(hdrs, "\r\ncontent-length:", j)
    }
    return v
}

/// read a full request. One Conn.read() is NOT a request — TCP splits
/// segments anywhere, so >4KiB bodies and split header/body deliveries
/// (curl's Expect: 100-continue) silently truncate. Accumulate until
/// the header terminator, then drain exactly Content-Length bytes.
fn read_request(c: net.Conn) -> ReqRead {
    scratch := mkslice(byte, 4096)
    req := ""
    hdr_end := -1
    deadline := now_ms() + REQ_MS
    for hdr_end < 0 && len(req) <= 16384 {
        if now_ms() > deadline {
            return ReqRead{status: 400, req: "", body: ""}
        }
        [n, e] = c.read(scratch)
        if e != nil || n <= 0 {
            return ReqRead{status: 400, req: "", body: ""}
        }
        req = req + scratch[0:n] as str
        hdr_end = find(req, "\r\n\r\n")
    }
    if hdr_end < 0 {
        return ReqRead{status: 400, req: "", body: ""}
    }
    cl := content_length(req, hdr_end)
    if cl < 0 {
        return ReqRead{status: 400, req: "", body: ""}
    }
    // no chunked decoding: a TE body has no length to drain, so the
    // chunk bytes stay on the wire and desync the next request — refuse
    if find_from(lwr(substr(req, 0, hdr_end)), "\r\ntransfer-encoding:", 0) >= 0 {
        return ReqRead{status: 400, req: "", body: ""}
    }
    if cl > MAX_BODY {
        return ReqRead{status: 413, req: "", body: ""}
    }
    // copy the already-arrived tail, then drain into a sized buffer —
    // `req + chunk` accumulation would go quadratic on large bodies
    tail := substr(req, hdr_end + 4, len(req))
    have := len(tail)
    if have > cl {
        have = cl // pipelined bytes past the length are dropped
    }
    bbuf := mkslice(byte, cl)
    i := 0
    for i < have {
        bbuf[i] = byteat(tail, i)
        i = i + 1
    }
    for have < cl {
        if now_ms() > deadline {
            return ReqRead{status: 400, req: "", body: ""}
        }
        [n, e] = c.read(scratch)
        if e != nil || n <= 0 {
            return ReqRead{status: 400, req: "", body: ""}
        }
        if n > cl - have {
            // a read can return pipelined bytes past the length — the
            // copy must stop at cl or the index walks off bbuf's end
            n = cl - have
        }
        chunk := scratch[0:n] as str
        j := 0
        for j < n {
            bbuf[have + j] = byteat(chunk, j)
            j = j + 1
        }
        have = have + n
    }
    return ReqRead{status: 0, req: req, body: bbuf as str}
}

fn handle_conn(h: Handler, c: net.Conn, inflight: shared) {
    defer conn_cleanup(c, inflight)
    // conn-scoped arena: the request buffer + parse garbage die when the
    // handler returns instead of accumulating in the serve scope
    scope {
        set_rcvtimo(c.rawfd(), 10) // slowloris guard: reads give up after 10s
        set_sndtimo(c.rawfd(), 10) // a client that stops reading can't pin the conn in write()
        rr := read_request(c)
        if rr.status != 0 {
            resp := http_resp(rr.status, status_text(rr.status) + "\n")
            write_all(c, resp)
        } else {
            // "METHOD PATH HTTP/1.x" — split on the first two spaces; a
            // line missing either (or opening with one) is malformed —
            // substr on a -1/0 hit would dispatch a garbage route.
            // search inside the request LINE only: a space in a header
            // value (e.g. Host: a b) would otherwise split the block
            eol := find(rr.req, "\r\n")
            line := substr(rr.req, 0, eol)
            sp1 := find(line, " ")
            sp2 := -1
            rest := ""
            if sp1 > 0 {
                rest = substr(line, sp1 + 1, len(line))
                sp2 = find(rest, " ")
            }
            if sp1 <= 0 || sp2 <= 0 {
                resp := http_resp(400, "malformed request line\n")
                write_all(c, resp)
            } else {
                path := substr(rest, 0, sp2)
                method := substr(line, 0, sp1)

                // per-conn trap containment: route_serve runs as a nested
                // task inside a heap try-scope. Its trap stops at
                // rt_scope_join_free instead of propagating through serve's
                // shared spawn scope and cancelling sibling handlers
                rsc := rt_scope_new()
                spawnBlocking route_serve(h, method, path, rr.body, c)
                if rt_scope_join_free(rsc) != 0 {
                    resp := http_resp(500, "handler trapped\n")
                    write_all(c, resp)
                }
            }
        }
    }
}

/// listen+serve on port; dispatches `h.route` per request
fn serve(port: int, h: Handler) {
    rt_sigpipe_ignore() // reset clients must not kill us on write
    [l, le] = net.listen(port)
    if le != nil {
        println("serve: listen failed on :" + itoa(port))
        exit(1)
    }
    println("listening on :" + itoa(port))

    inflight := mkshared(0)
    scope {
        for true {
            [c, ae] = l.accept()
            if ae == nil {
                // claim a slot before spawning; sadd returns the OLD count
                if sadd(inflight, 1) >= MAX_CONN {
                    sadd(inflight, -1)
                    c.close()
                } else {
                    spawnBlocking handle_conn(h, c, inflight)
                }
            } else {
                // persistent accept errors (EMFILE and friends) would
                // spin the accept loop — back off briefly and retry
                usleep(50000)
            }
        }
    }
}

/// a parsed request URL — `http://` only; port defaults to 80, path to /
struct Url { host: str, port: int, path: str }

/// `http://host[:port][/path]` — IPv4 or host names net.dial accepts.
/// Anything else (https, userinfo, query-less garbage) is an err, not a
/// silent misparsed request
fn parse_url(url: str) -> [Url, err] {
    bad := Url{host: "", port: 0, path: ""}
    u := url
    if len(u) >= 7 && substr(u, 0, 7) == "http://" {
        u = substr(u, 7, len(u))
    } else if find(u, "://") >= 0 {
        return bad, errors.new("http: unsupported scheme in " + url)
    }
    if len(u) == 0 {
        return bad, errors.new("http: empty url")
    }
    slash := find(u, "/")
    hostport := u
    path := "/"
    if slash >= 0 {
        hostport = substr(u, 0, slash)
        path = substr(u, slash, len(u))
    }
    colon := find(hostport, ":")
    host := hostport
    port := 80
    if colon >= 0 {
        host = substr(hostport, 0, colon)
        ps := substr(hostport, colon + 1, len(hostport))
        [p, pe] = strconv.atoi(ps)
        if pe != nil || p <= 0 || p > 65535 {
            return bad, errors.new("http: bad port in " + url)
        }
        port = p
    }
    if len(host) == 0 {
        return bad, errors.new("http: empty host in " + url)
    }
    return Url{host: host, port: port, path: path}, nil
}

/// hdr_of extracts one header value from the response head —
/// `lowered` is the case-folded copy of resp[0:he] used for matching;
/// the value keeps the original casing off resp, trimmed of SP/TAB.
fn hdr_of(resp: str, lowered: str, key: str) -> str {
    at := find_from(lowered, "\r\n" + key + ":", 0)
    if at < 0 {
        // a first-line header would lack the leading CRLF — only the
        // status line sits there, so treat absence as absent
        return ""
    }
    val := substr(resp, at + 2 + len(key) + 1, len(resp))
    e2 := find(val, "\r\n")
    if e2 > 0 {
        val = substr(val, 0, e2)
    }
    lo := 0
    for lo < len(val) && (byteat(val, lo) == 32 || byteat(val, lo) == 9) {
        lo = lo + 1
    }
    hi := len(val)
    for hi > lo && (byteat(val, hi - 1) == 32 || byteat(val, hi - 1) == 9) {
        hi = hi - 1
    }
    if hi <= lo {
        return ""
    }
    return substr(val, lo, hi)
}

/// unchunk decodes a transfer-encoding: chunked body — size lines,
/// data runs, and any trailers up to the 0\r\n\r\n terminator.
fn unchunk(b: str) -> [str, err] {
    out := mkslice(byte, 0)
    pos := 0
    for true {
        nl := find_from(b, "\r\n", pos)
        if nl < 0 {
            return "", errors.new("http: truncated chunk size")
        }
        szs := substr(b, pos, nl)
        semi := find(szs, ";")
        if semi >= 0 {
            szs = substr(szs, 0, semi)
        }
        [sz, se] = strconv.parseint(szs, 16)
        if se != nil || sz < 0 {
            return "", errors.new("http: bad chunk size " + szs)
        }
        if sz == 0 {
            // trailer fields up to the blank line are legal but carry
            // nothing we expose — the body is complete at this marker
            return out as str, nil
        }
        data := nl + 2
        if data + sz > len(b) {
            return "", errors.new("http: truncated chunk data")
        }
        i := 0
        for i < sz {
            out = push(out, byteat(b, data + i))
            i = i + 1
        }
        pos = data + sz
        if pos + 1 >= len(b) || byteat(b, pos) != 13 || byteat(b, pos + 1) != 10 {
            return "", errors.new("http: missing CRLF after chunk")
        }
        pos = pos + 2
    }
}

/// default dial+read budget for the package-level get/post (ms)
let CLIENT_MS = 30000

/// a client with its own dial/read budget — one request at a time
struct Client { tmo: int }

/// one request: dial, write, read-until-close (bounded by the client's
/// budget). Status/ctype come off the status line and headers; the body
/// is whatever follows \r\n\r\n verbatim.
fn (cl ref Client) request(method: str, url: str, ctype: str, body: str) -> [Resp, err] {
    bad := Resp{status: 0, body: "", ctype: ""}
    [u, ue] = parse_url(url)
    if ue != nil {
        return bad, ue
    }
    [c, de] = net.dial_timeout(u.host, u.port, cl.tmo)
    if de != nil {
        return bad, de
    }
    req := method + " " + u.path + " HTTP/1.1\r\nhost: " + u.host
    if u.port != 80 {
        req = req + ":" + itoa(u.port)
    }
    req = req + "\r\nconnection: close\r\n"
    if len(ctype) > 0 && !has_crlf(ctype) {
        req = req + "content-type: " + ctype + "\r\n"
    }
    if len(body) > 0 {
        req = req + "content-length: " + itoa(len(body)) + "\r\n"
    }
    req = req + "\r\n" + body
    write_all(c, req)
    // response: connection: close means read-until-EOF is well-defined.
    // Each read carries only the *remaining* budget — a silent peer
    // can't stretch the whole-request deadline by answering slowly.
    deadline := now_ms() + cl.tmo
    scratch := mkslice(byte, 8192)
    out := mkslice(byte, 0)
    for true {
        rem := deadline - now_ms()
        if rem <= 0 {
            c.close()
            return bad, errors.new("http: read deadline exceeded")
        }
        set_rcvtimo_ms(c.rawfd(), rem)
        [n, e] = c.read(scratch)
        if n > 0 {
            j := 0
            for j < n {
                // []byte growth is amortized; str concat would copy
                // the accumulated prefix per read (quadratic)
                out = push(out, scratch[j])
                j = j + 1
            }
        }
        if e == io.eof() {
            break
        }
        if e != nil {
            // a read error (timeout, reset) is not a clean close —
            // the body may be truncated; fail, don't deliver it
            c.close()
            return bad, e
        }
        if n <= 0 {
            c.close()
            return bad, errors.new("http: connection closed mid-response")
        }
    }
    c.close()
    resp := out as str
    he := find(resp, "\r\n\r\n")
    if he < 0 {
        return bad, errors.new("http: response never completed headers")
    }
    // "HTTP/1.1 200 OK" — code is the token after the first space
    eol := find(resp, "\r\n")
    line := substr(resp, 0, eol)
    sp := find(line, " ")
    code := 0
    if sp > 0 {
        rest := substr(line, sp + 1, len(line))
        sp2 := find(rest, " ")
        tok := rest
        if sp2 > 0 {
            tok = substr(rest, 0, sp2)
        }
        [v, ae] = strconv.atoi(tok)
        if ae == nil {
            code = v
        }
    }
    hdrs := lwr(substr(resp, 0, he))
    rctype := hdr_of(resp, hdrs, "content-type")
    // framing: we sent HTTP/1.1 so a server may answer chunked, and a
    // content-length shorter than what arrived means truncation got
    // past the read loop — neither may slip through as a "body"
    raw := substr(resp, he + 4, len(resp))
    te := lwr(hdr_of(resp, hdrs, "transfer-encoding"))
    rbody := ""
    if find(te, "chunked") >= 0 {
        [db, de] = unchunk(raw)
        if de != nil {
            return bad, de
        }
        rbody = db
    } else {
        clv := hdr_of(resp, hdrs, "content-length")
        if len(clv) > 0 {
            [cln, cle] = strconv.atoi(clv)
            if cle != nil || cln < 0 {
                return bad, errors.new("http: bad content-length " + clv)
            }
            if len(raw) < cln {
                return bad, errors.new("http: truncated body — content-length " + clv + ", got " + itoa(len(raw)))
            }
            if len(raw) > cln {
                raw = substr(raw, 0, cln)
            }
        }
        rbody = raw
    }
    return Resp{status: code, body: rbody, ctype: rctype}, nil
}

fn (cl ref Client) get(url: str) -> [Resp, err] {
    return cl.request("GET", url, "", "")
}

fn (cl ref Client) post(url: str, ctype: str, body: str) -> [Resp, err] {
    return cl.request("POST", url, ctype, body)
}

/// package-level GET with the default budget — build a Client to tune it
fn get(url: str) -> [Resp, err] {
    cl := Client{tmo: CLIENT_MS}
    return cl.get(url)
}

/// package-level POST with the default budget
fn post(url: str, ctype: str, body: str) -> [Resp, err] {
    cl := Client{tmo: CLIENT_MS}
    return cl.post(url, ctype, body)
}
