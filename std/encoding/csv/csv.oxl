package csv

// std/encoding/csv — RFC 4180 reader/writer, Go's semantics by
// default: quoted fields, "" escapes, embedded commas/newlines/CR,
// a bare quote mid-field is an error (no LazyQuotes). Records end on
// \n or \r\n; \r alone inside quotes is kept.
import "std/errors"

fn is_eol(s: str, i: int) -> bool {
    return byteat(s, i) == 10
}

// scan_one parses one record starting at s[pos], returning
// [fields-json? no — rows accumulate in caller] — shape helper:
// returns the record's field list plus the next position via the
// out params oxl supports (struct box).
struct Scan { fields: []str, next: int }

fn scan_one(s: str, pos: int) -> [Scan, err] {
    let fields: []str = nil
    field := ""
    i := pos
    quoted := false
    was_quoted := false
    started := false
    for true {
        if i >= len(s) {
            if quoted {
                return Scan{fields: nil, next: i}, errors.new("csv: unterminated quoted field")
            }
            // record closes at EOF — trailing field counts only if
            // the record had any content (or a comma ran)
            if started || len(fields) > 0 {
                fields = push(fields, field)
            }
            return Scan{fields: fields, next: i}, nil
        }
        c := byteat(s, i)
        if quoted {
            if c == 34 {
                if i + 1 < len(s) && byteat(s, i + 1) == 34 {
                    field = field + "\""
                    i = i + 2
                } else {
                    quoted = false
                    i = i + 1
                }
            } else {
                field = field + substr(s, i, i + 1)
                i = i + 1
            }
        } else if c == 34 {
            if started {
                // bare quote inside an unquoted field — Go's
                // default rejects these (LazyQuotes off)
                return Scan{fields: nil, next: i}, errors.new("csv: bare \" in unquoted field")
            }
            quoted = true
            was_quoted = true
            i = i + 1
        } else if c == 44 {
            fields = push(fields, field)
            field = ""
            started = false
            was_quoted = false
            i = i + 1
        } else if c == 10 {
            fields = push(fields, field)
            return Scan{fields: fields, next: i + 1}, nil
        } else if c == 13 {
            if i + 1 < len(s) && byteat(s, i + 1) == 10 {
                fields = push(fields, field)
                return Scan{fields: fields, next: i + 2}, nil
            }
            // bare CR ends the record too (RFC treats lone \r
            // leniently; Go eats it as data — kept as data here:
            // simpler and matches Go's field content)
            field = field + "\r"
            i = i + 1
        } else {
            field = field + substr(s, i, i + 1)
            started = true
            i = i + 1
        }
    }
    return Scan{fields: fields, next: i}, nil
}

/// read_all parses s into records — [rows, err]. The own
/// outer is a shallow heap box; row/field backings live in the
/// caller's scope arena, so the tree is valid for the scope's life.
fn read_all(s: str) -> [own [][]str, err] {
    let rows: [][]str = nil
    pos := 0
    for pos < len(s) {
        [sc, e] = scan_one(s, pos)
        if e != nil {
            return nil, e
        }
        if len(sc.fields) > 0 {
            rows = push(rows, sc.fields)
        }
        pos = sc.next
    }
    return new(rows), nil
}

/// format_record renders one record — fields quoting only when they
/// contain a comma, quote, \n or \r (Go's minimal-quoting rule).
fn format_record(fields: []str) -> str {
    out := mkslice(byte, 0)
    i := 0
    for i < len(fields) {
        if i > 0 {
            out = push(out, 44)
        }
        f := fields[i]
        need := false
        j := 0
        for j < len(f) {
            c := byteat(f, j)
            if c == 44 || c == 34 || c == 10 || c == 13 {
                need = true
            }
            j = j + 1
        }
        if need {
            out = push(out, 34)
            j = 0
            for j < len(f) {
                if byteat(f, j) == 34 {
                    out = push(out, 34)
                    out = push(out, 34)
                } else {
                    out = push(out, byteat(f, j))
                }
                j = j + 1
            }
            out = push(out, 34)
        } else {
            j = 0
            for j < len(f) {
                out = push(out, byteat(f, j))
                j = j + 1
            }
        }
        i = i + 1
    }
    return out as str
}

/// format renders all records, \n-terminated per record.
fn format(rows: [][]str) -> str {
    out := mkslice(byte, 0)
    i := 0
    for i < len(rows) {
        r := format_record(rows[i])
        j := 0
        for j < len(r) {
            out = push(out, byteat(r, j))
            j = j + 1
        }
        out = push(out, 10)
        i = i + 1
    }
    return out as str
}
