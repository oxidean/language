package binary

// std/encoding/binary — fixed-width big/little-endian reads and
// writes over []byte. Go-shaped helpers: reads assert the width
// (callers bounds-check, same contract as Go's panics) and returns
// fit in int since oxl ints are 64-bit.
fn need(b: []byte, off: int, n: int) {
    if off < 0 || len(b) - off < n {
        assert(false)
    }
}

/// le_u16 reads a little-endian uint16 at off.
fn le_u16(b: []byte, off: int) -> int {
    need(b, off, 2)
    return b[off] | b[off + 1] * 256
}

/// le_u32 reads a little-endian uint32 at off.
fn le_u32(b: []byte, off: int) -> int {
    need(b, off, 4)
    return b[off] | b[off + 1] * 256 | b[off + 2] * 65536 | b[off + 3] * 16777216
}

/// le_u64 reads a little-endian uint64 at off — the value stays in
/// int (two's-complement pattern, same as oxl's int width).
fn le_u64(b: []byte, off: int) -> int {
    lo := le_u32(b, off)
    hi := le_u32(b, off + 4)
    return lo | hi * 4294967296
}

/// be_u16 reads a big-endian uint16 at off.
fn be_u16(b: []byte, off: int) -> int {
    need(b, off, 2)
    return b[off] * 256 | b[off + 1]
}

/// be_u32 reads a big-endian uint32 at off.
fn be_u32(b: []byte, off: int) -> int {
    need(b, off, 4)
    return b[off] * 16777216 | b[off + 1] * 65536 | b[off + 2] * 256 | b[off + 3]
}

/// be_u64 reads a big-endian uint64 at off.
fn be_u64(b: []byte, off: int) -> int {
    hi := be_u32(b, off)
    lo := be_u32(b, off + 4)
    return lo | hi * 4294967296
}

/// put_le_u16 stores v little-endian at off (writes through the slice view).
fn put_le_u16(b: []byte, off: int, v: int) {
    need(b, off, 2)
    b[off] = v % 256
    b[off + 1] = v / 256 % 256
}

/// put_le_u32 stores v little-endian at off.
fn put_le_u32(b: []byte, off: int, v: int) {
    need(b, off, 4)
    b[off] = v % 256
    b[off + 1] = v / 256 % 256
    b[off + 2] = v / 65536 % 256
    b[off + 3] = v / 16777216 % 256
}

/// put_le_u64 stores v little-endian at off.
fn put_le_u64(b: []byte, off: int, v: int) {
    // & keeps the two's-complement pattern — % and / truncate toward
    // zero, so negatives would emit wrong bytes split at the word seam
    lo := v & 4294967295
    hi := (v - lo) / 4294967296 & 4294967295
    put_le_u32(b, off, lo)
    put_le_u32(b, off + 4, hi)
}

/// put_be_u16 stores v big-endian at off.
fn put_be_u16(b: []byte, off: int, v: int) {
    need(b, off, 2)
    b[off] = v / 256 % 256
    b[off + 1] = v % 256
}

/// put_be_u32 stores v big-endian at off.
fn put_be_u32(b: []byte, off: int, v: int) {
    need(b, off, 4)
    b[off] = v / 16777216 % 256
    b[off + 1] = v / 65536 % 256
    b[off + 2] = v / 256 % 256
    b[off + 3] = v % 256
}

/// put_be_u64 stores v big-endian at off.
fn put_be_u64(b: []byte, off: int, v: int) {
    lo := v & 4294967295
    hi := (v - lo) / 4294967296 & 4294967295
    put_be_u32(b, off, hi)
    put_be_u32(b, off + 4, lo)
}
