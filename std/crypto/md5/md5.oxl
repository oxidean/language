package md5

// std/crypto/md5 — RFC 1321 MD5 written fresh from the RFC's
// algorithm description. u32 values ride in int64 masked to 32 bits
// (M32); no shift operators, so x<<n is (x*2**n)&M32 and x>>n is
// x/2**n — operands stay non-negative so / is exact.
import "std/hash"

import "std/slices"

import "std/encoding/binary"

import "std/encoding/hex"

let M32: int = 4294967295

let P2: own []int = nil

// powers of two — lazy table
fn p2() -> own []int {
    if P2 == nil {
        t := mkslice(int, 33)
        v := 1
        i := 0
        for i < 33 {
            t[i] = v
            v = v * 2
            i = i + 1
        }
        P2 = slices.clone(t)
    }
    return P2
}

let KT: own []int = nil

// per-round constants T[i] = floor(abs(sin(i+1)) * 2^32)
fn kt() -> own []int {
    if KT == nil {
        t := mkslice(int, 64)
        t[0] = 3614090360
        t[1] = 3905402710
        t[2] = 606105819
        t[3] = 3250441966
        t[4] = 4118548399
        t[5] = 1200080426
        t[6] = 2821735955
        t[7] = 4249261313
        t[8] = 1770035416
        t[9] = 2336552879
        t[10] = 4294925233
        t[11] = 2304563134
        t[12] = 1804603682
        t[13] = 4254626195
        t[14] = 2792965006
        t[15] = 1236535329
        t[16] = 4129170786
        t[17] = 3225465664
        t[18] = 643717713
        t[19] = 3921069994
        t[20] = 3593408605
        t[21] = 38016083
        t[22] = 3634488961
        t[23] = 3889429448
        t[24] = 568446438
        t[25] = 3275163606
        t[26] = 4107603335
        t[27] = 1163531501
        t[28] = 2850285829
        t[29] = 4243563512
        t[30] = 1735328473
        t[31] = 2368359562
        t[32] = 4294588738
        t[33] = 2272392833
        t[34] = 1839030562
        t[35] = 4259657740
        t[36] = 2763975236
        t[37] = 1272893353
        t[38] = 4139469664
        t[39] = 3200236656
        t[40] = 681279174
        t[41] = 3936430074
        t[42] = 3572445317
        t[43] = 76029189
        t[44] = 3654602809
        t[45] = 3873151461
        t[46] = 530742520
        t[47] = 3299628645
        t[48] = 4096336452
        t[49] = 1126891415
        t[50] = 2878612391
        t[51] = 4237533241
        t[52] = 1700485571
        t[53] = 2399980690
        t[54] = 4293915773
        t[55] = 2240044497
        t[56] = 1873313359
        t[57] = 4264355552
        t[58] = 2734768916
        t[59] = 1309151649
        t[60] = 4149444226
        t[61] = 3174756917
        t[62] = 718787259
        t[63] = 3951481745
        KT = slices.clone(t)
    }
    return KT
}

fn rotl(x: int, n: int) -> int {
    p := p2()
    return x * p[n] & M32 | x / p[32 - n]
}

/// Md5 is an incremental MD5 state — implements hash.Hash.
struct Md5 { st: []int, buf: []byte, total: int }

fn fill_st(st: []int) {
    st[0] = 1732584193
    st[1] = 4023233417
    st[2] = 2562383102
    st[3] = 271733878
}

fn mkmd5() -> Md5 {
    st := mkslice(int, 4)
    fill_st(st)
    return Md5{st: st, buf: mkslice(byte, 0), total: 0}
}

// one 64-byte block; M words are little-endian
fn compress(st: []int, blk: []byte, off: int) {
    k := kt()
    m := mkslice(int, 16)
    i := 0
    for i < 16 {
        m[i] = binary.le_u32(blk, off + i * 4)
        i = i + 1
    }
    // shift amounts per 4-op group
    sh := mkslice(int, 16)
    sh[0] = 7
    sh[1] = 12
    sh[2] = 17
    sh[3] = 22
    sh[4] = 5
    sh[5] = 9
    sh[6] = 14
    sh[7] = 20
    sh[8] = 4
    sh[9] = 11
    sh[10] = 16
    sh[11] = 23
    sh[12] = 6
    sh[13] = 10
    sh[14] = 15
    sh[15] = 21
    a := st[0]
    b := st[1]
    c := st[2]
    d := st[3]
    i = 0
    for i < 64 {
        r := i / 16
        j := i % 16
        f := 0
        g := 0
        if r == 0 {
            f = b & c | M32 - b & d
            g = j
        } else if r == 1 {
            f = b & d | c & M32 - d
            g = (5 * j + 1) % 16
        } else if r == 2 {
            f = b ^ c ^ d
            g = (3 * j + 5) % 16
        } else {
            f = c ^ (b | M32 - d)
            g = 7 * j % 16
        }
        s := sh[i % 4 + r * 4]
        tmp := a + f + k[i] + m[g] & M32
        a = d
        d = c
        c = b
        b = b + rotl(tmp, s) & M32
        i = i + 1
    }
    st[0] = st[0] + a & M32
    st[1] = st[1] + b & M32
    st[2] = st[2] + c & M32
    st[3] = st[3] + d & M32
}

/// new returns a fresh incremental hasher as hash.Hash.
fn new() -> hash.Hash {
    h := mkmd5()
    return h.ashash()
}

fn (h mut Md5) write(b: []byte) -> [int, err] {
    h.total = h.total + len(b)
    i := 0
    for i < len(b) {
        h.buf = push(h.buf, b[i])
        i = i + 1
    }
    for len(h.buf) >= 64 {
        compress(h.st, h.buf, 0)
        h.buf = h.buf[64:]
    }
    return len(b), nil
}

fn (h mut Md5) sum(b: []byte) -> own []byte {
    st := mkslice(int, 4)
    i := 0
    for i < 4 {
        st[i] = h.st[i]
        i = i + 1
    }
    tb := mkslice(byte, 0)
    i = 0
    for i < len(h.buf) {
        tb = push(tb, h.buf[i])
        i = i + 1
    }
    ml := h.total * 8
    tb = push(tb, 128)
    for len(tb) % 64 != 56 {
        tb = push(tb, 0)
    }
    // bit length is little-endian in MD5
    i = 0
    for i < 8 {
        tb = push(tb, ml / pow8(i) % 256)
        i = i + 1
    }
    off := 0
    for off + 64 <= len(tb) {
        compress(st, tb, off)
        off = off + 64
    }
    out := mkslice(byte, 16)
    i = 0
    for i < 4 {
        binary.put_le_u32(out, i * 4, st[i])
        i = i + 1
    }
    return slices.concat(b, out)
}

fn (h mut Md5) reset() {
    fill_st(h.st)
    h.buf = h.buf[0:0]
    h.total = 0
}

fn (h mut Md5) blocksize() -> int {
    return 64
}

fn (h Md5) ashash() -> hash.Hash {
    return h
}

fn pow8(k: int) -> int {
    v := 1
    i := 0
    for i < k {
        v = v * 256
        i = i + 1
    }
    return v
}

/// sum is the one-shot form — md5.Sum.
fn sum(b: []byte) -> own []byte {
    h := mkmd5()
    [wn, we] = h.write(b)
    return h.sum(nil)
}

/// hexdigest is sum + hex — the printable form.
fn hexdigest(b: []byte) -> str {
    return hex.encode(sum(b))
}
