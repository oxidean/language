package fmt

// std/fmt — bounded formatting: no variadics and no runtime `any`, so
// %v-style reflection stays parked. sprintf substitutes %s verbs with
// []str args (callers convert via itoa/ftoa/etc.); %% escapes.
import "std/errors"

/// sprintf — %s takes the next arg in order; %% emits a literal %.
/// Bad verbs and arg under/over-supply return an err.
fn sprintf(f: str, args: []str) -> [str, err] {
    out := ""
    ai := 0
    i := 0
    for i < len(f) {
        c := byteat(f, i)
        if c != 37 {
            out = out + substr(f, i, i + 1)
            i = i + 1
            continue
        }
        i = i + 1
        if i >= len(f) {
            return "", errors.new("fmt: dangling % at end")
        }
        v := byteat(f, i)
        if v == 37 {
            out = out + "%"
            i = i + 1
            continue
        }
        if v == 115 {
            if ai >= len(args) {
                return "", errors.new("fmt: not enough args for %s")
            }
            out = out + args[ai]
            ai = ai + 1
            i = i + 1
            continue
        }
        return "", errors.new("fmt: unknown verb %" + substr(f, i, i + 1))
    }
    if ai < len(args) {
        return "", errors.new("fmt: " + itoa(len(args) - ai) + " unused arg(s)")
    }
    return out, nil
}

/// sprint is a no-op alias for str identity — the %s path without a
/// format string.
fn sprint(s: str) -> str {
    return s
}

/// sprinti formats an int (itoa alias — the typed %d substitute).
fn sprinti(v: int) -> str {
    return itoa(v)
}
