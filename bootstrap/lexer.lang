// bootstrap/lexer.lang — token dump driver over bootstrap/lexlib.
//   lang run bootstrap/lexer.lang -- examples/hello.lang

import "lexlib"

fn main() {
    if argc() < 2 {
        println("usage: lexer <file.lang>")
        exit(1)
    }
    src := readfile(argv(1))
    if len(src) == 0 {
        println("cannot read " + argv(1))
        exit(1)
    }
    toks := lexlib.lex(src)
    n := 0
    cur := toks
    for cur != nil {
        println(lexlib.kind_name(cur.kind) + "\t" + cur.text)
        n = n + 1
        cur = cur.next
    }
    println(itoa(n) + " tokens")
}
