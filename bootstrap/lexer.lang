// bootstrap/lexer.lang — a lexer for .lang, written in .lang.
// The first self-host component: proves the language can already
// express compiler-shaped code (file io, byte iteration, owned
// linked structures, classification) with v0.0.1 features.
//
//   lang run bootstrap/lexer.lang -- examples/hello.lang

import "std/strings"

// token kinds (ints — no enums yet; see docs/self-hosting.md)
fn k_ident() -> int { return 1 }
fn k_kw() -> int { return 2 }
fn k_int() -> int { return 3 }
fn k_str() -> int { return 4 }
fn k_punct() -> int { return 5 }
fn k_eof() -> int { return 0 }

struct Tok {
    kind: int
    text: str
    next: own Tok
}

fn is_alpha(c: int) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95
}
fn is_digit(c: int) -> bool {
    return c >= 48 && c <= 57
}
fn is_space(c: int) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}
fn is_kw(w: str) -> bool {
    return w == "fn" || w == "struct" || w == "extern" || w == "return"
        || w == "if" || w == "else" || w == "for" || w == "let"
        || w == "scope" || w == "spawn" || w == "go" || w == "own"
        || w == "ref" || w == "mut" || w == "unsafe" || w == "nil"
        || w == "true" || w == "false" || w == "import" || w == "chan"
        || w == "break" || w == "continue" || w == "interface"
        || w == "spawnBlocking"
}
fn push(tail: own Tok, kind: int, text: str) -> own Tok {
    tail.next = new(Tok)
    tail = tail.next
    tail.kind = kind
    tail.text = text
    tail.next = nil
    return tail
}

fn lex(src: str) -> own Tok {
    head := new(Tok)
    head.kind = 0
    head.text = ""
    head.next = nil
    tail := head
    i := 0
    for i < len(src) {
        c := byteat(src, i)
        if is_space(c) {
            i = i + 1
            continue
        }
        if c == 47 && byteat(src, i + 1) == 47 {     // // comment
            for i < len(src) && byteat(src, i) != 10 {
                i = i + 1
            }
            continue
        }
        if is_alpha(c) {
            a := i
            for i < len(src) && (is_alpha(byteat(src, i)) || is_digit(byteat(src, i))) {
                i = i + 1
            }
            w := substr(src, a, i)
            k := k_ident()
            if is_kw(w) { k = k_kw() }
            tail = push(tail, k, w)
            continue
        }
        if is_digit(c) {
            a := i
            for i < len(src) && is_digit(byteat(src, i)) {
                i = i + 1
            }
            tail = push(tail, k_int(), substr(src, a, i))
            continue
        }
        if c == 34 {                                  // "..."
            a := i + 1
            i = i + 1
            for i < len(src) && byteat(src, i) != 34 {
                if byteat(src, i) == 92 { i = i + 1 }  // escape
                i = i + 1
            }
            tail = push(tail, k_str(), substr(src, a, i))
            i = i + 1
            continue
        }
        // single-char punct
        tail = push(tail, k_punct(), substr(src, i, i + 1))
        i = i + 1
    }
    tail = push(tail, k_eof(), "")
    return head.next
}

fn kind_name(k: int) -> str {
    if k == 1 { return "ident" }
    if k == 2 { return "kw" }
    if k == 3 { return "int" }
    if k == 4 { return "str" }
    if k == 5 { return "punct" }
    return "eof"
}

fn main() {
    if argc() < 2 {
        println("usage: lexer <file.lang>")
        exit(1)
    }
    src := readfile(argv(1))
    if len(src) == 0 {
        println("cannot read " + argv(1))
        exit(1)
    }
    toks := lex(src)
    n := 0
    cur := toks
    for cur != nil {
        println(kind_name(cur.kind) + "\t" + cur.text)
        n = n + 1
        cur = cur.next
    }
    println(itoa(n) + " tokens")
}
