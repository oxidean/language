package check

// bootstrap/check.oxl — the typechecker, written in .oxl.
// Third self-host component: ports oxl/src/check.rs over the bootstrap
// parser's `Node` AST. Types are interned ints into a pool (rustc-style
// Ty handles); scopes are a Vec of std/collections maps.
//
//   oxl run bootstrap/check.oxl -- file.oxl      prints diags or "ok"
//
// AST-subset boundary: the bootstrap parser does not produce generics
// (fn f[T any]), interface decls, select arms, closures, import aliases,
// or float literals — files using them fail parse-side before checking.
import "oxl/bootstrap/lexlib"

import "oxl/bootstrap/parser"

import "std/collections"

import "std/strings"

// package loading needs portable dir probes (Rust resolve_pkg mirrors)
extern fn rt_lsdir(path: str) -> str

extern fn rt_isdir(path: str) -> int

// module resolution needs env (OXLMODCACHE) + file-exists (oxl.mod)
extern fn rt_getenv(name: str) -> str

extern fn rt_fexists(path: str) -> int

// ---------- interned types ----------
fn k_unk() -> int {
    return 0
}

fn k_void() -> int {
    return 1
}

fn k_int() -> int {
    return 2
}

fn k_str() -> int {
    return 3
}

fn k_bool() -> int {
    return 4
}

fn k_err() -> int {
    return 5
}

fn k_cstr() -> int {
    return 6
}

fn k_float() -> int {
    return 7
}

fn k_chan() -> int {
    return 8
}

fn k_own() -> int {
    return 9
}

fn k_ref() -> int {
    return 10
}

fn k_mut() -> int {
    return 11
}

fn k_slice() -> int {
    return 12
}

fn k_fn() -> int {
    return 13
}

fn k_var() -> int {
    return 14
}

fn k_struct() -> int {
    return 15
}

fn k_enum() -> int {
    return 16
}

fn k_shared() -> int {
    return 17
}

fn k_iface() -> int {
    return 18
}

// one pool record; i/r are ty handles (-1 unused), args an int list
struct T { k: int, i: int, args: own IList, r: int, name: str }

struct IList { v: int, next: own IList }

fn icons(v: int, next: own IList) -> own IList {
    c := new(IList)
    c.v = v
    c.next = next
    return c
}

fn irev(l: own IList) -> own IList {
    let out: own IList = nil
    for l != nil {
        n := l.next
        l.next = out
        out = l
        l = n
    }
    return out
}

fn ilen(l: ref IList) -> int {
    n := 0
    for l != nil {
        n = n + 1
        l = l.next
    }
    return n
}

// ---------- tables ----------
struct FEnt { n: str, t: int } // (field/variant-arg name, ty)

struct FList { v: own FEnt, next: own FList }

fn fcons(n: str, t: int, next: own FList) -> own FList {
    c := new(FList)
    c.v = new(FEnt)
    c.v.n = n
    c.v.t = t
    c.next = next
    return c
}

// deep copy — the same field list is shared between the struct
// registry and the enum variant entry; each needs its own cells
fn fclone(l: ref FList) -> own FList {
    if l == nil {
        return nil
    }
    e := new(FEnt)
    e.n = l.v.n
    e.t = l.v.t
    c := new(FList)
    c.v = e
    c.next = fclone(l.next)
    return c
}

fn frev(l: own FList) -> own FList {
    let out: own FList = nil
    for l != nil {
        n := l.next
        l.next = out
        out = l
        l = n
    }
    return out
}

// ty of field `n`, or -1
fn ffind(l: ref FList, n: str) -> int {
    for l != nil {
        if l.v.n == n {
            return l.v.t
        }
        l = l.next
    }
    return -1
}

fn flen(l: ref FList) -> int {
    n := 0
    for l != nil {
        n = n + 1
        l = l.next
    }
    return n
}

fn fall_positional(l: ref FList) -> bool {
    // all fields named fN — positional-payload ctor
    for l != nil {
        w := l.v.n
        if len(w) < 2 || byteat(w, 0) != 102 {
            return false
        }
        i := 1
        for i < len(w) {
            c := byteat(w, i)
            if c < 48 || c > 57 {
                return false
            }
            i = i + 1
        }
        l = l.next
    }
    return true
}

struct SEnt { n: str, fields: own FList } // struct entry

struct EVar { n: str, fields: own FList } // one variant

struct VList { v: own EVar, next: own VList }

struct EEnt { n: str, vars: own VList } // enum entry

fn vcons(n: str, fields: own FList, next: own VList) -> own VList {
    c := new(VList)
    c.v = new(EVar)
    c.v.n = n
    c.v.fields = fields
    c.next = next
    return c
}

fn vrev(l: own VList) -> own VList {
    let out: own VList = nil
    for l != nil {
        n := l.next
        l.next = out
        out = l
        l = n
    }
    return out
}

// variant lookup is inlined at each call site — `vl` walks `vars` until
// `vl.v.n` matches (ref returns are banned, so this can't be a helper)
struct FnSig {
    params: own IList, // ty handles
    retk: int, // 0 void, 1 one, 2 pair
    ret1: int, // ty handle for retk 1/2
    is_extern: int,
    typarams: own TPList, // generic (T, constraint) decls — nil when plain
}

struct SList { v: str, next: own SList }

fn scons(v: str, next: own SList) -> own SList {
    c := new(SList)
    c.v = v
    c.next = next
    return c
}

fn sl_clone(l: ref SList) -> own SList {
    if l == nil {
        return nil
    }
    c := new(SList)
    c.v = l.v
    c.next = sl_clone(l.next)
    return c
}

fn sl_del(l: own SList, n: str) -> own SList {
    if l == nil {
        return nil
    }
    if l.v == n {
        return l.next
    }
    t := l.next
    l.next = sl_del(t, n)
    return l
}

// (T, constraint) pairs — generic fn params + the active check scope
struct TPEnt { n: str, c: str }

struct TPList { v: own TPEnt, next: own TPList }

fn tp_clone(l: ref TPList) -> own TPList {
    if l == nil {
        return nil
    }
    c := new(TPList)
    c.v = new(TPEnt)
    c.v.n = l.v.n
    c.v.c = l.v.c
    c.next = tp_clone(l.next)
    return c
}

// interface method sig + the registered decl
struct IMethod { n: str, params: own IList, retk: int, ret1: int }

struct IMList { v: own IMethod, next: own IMList }

struct IEnt { n: str, ops: own SList, methods: own IMList }

// per-scope move marks, snapshotted for branch merges — LL is a list
// of name lists, parallel to the scope stack
struct LL { names: own SList, next: own LL }

// select/match arm end-states awaiting the fall-through merge
struct ArmSt { mv: own LL, ft: int, next: own ArmSt }

// per-file import aliases (qualifier -> stem) and selective names
struct ModEnt { alias: str, stem: str, next: own ModEnt }

struct FileAlias {
    file: str,
    aliases: own ModEnt,
    names: own ModEnt,
    next: own FileAlias,
}

fn sl_has(ll: ref SList, ss: str) -> bool {
    for ll != nil {
        if ll.v == ss {
            return true
        }
        ll = ll.next
    }
    return false
}

struct Edge { a: str, b: str, next: own Edge }

struct DBox { kind: str, msg: str }

struct ClChk { callees: own SList, seeded: int, next: own ClChk }

struct It { node: own parser.Node, mod: str, file: str }

struct Scope { m: own collections.Map, moved: own SList }

struct Env { scopes: []Scope }

struct Loader { items: []It }

struct Ck {
    tyv: []T, // interned type records
    fns: own collections.Map, // name -> idx into fnsv
    fnsv: []FnSig,
    structs: own collections.Map, // name -> idx into structsv
    structsv: []SEnt,
    enums: own collections.Map, // name -> idx into enumsv
    enumsv: []EEnt,
    globals: own collections.Map, // name -> ty handle
    ifaces: own collections.Map, // name -> idx into ifacesv
    ifacesv: []IEnt,
    ty_scope: own SList, // type param names in scope (current generic fn)
    cur_ty_params: own TPList, // (name, constraint) of the fn being checked
    methods: own SList, // qualified `T.m` method names — for the susp ban
    file_aliases: []FileAlias, // per-file alias + selective tables
    diags: []DBox,
    edges: own Edge, // caller -> callee call graph
    susp: own SList, // suspend-capable fn names
    loaded: own SList, // resolved package dirs
    loaded_names: own ModEnt, // resolved dir -> package clause cache
    loading: own ModEnt, // in-flight pkg dir -> written imp (cycle detect)
    load_fail: int, // a load-time diag fired — unwind like Rust's None path
    mod_on: int, // an oxl.mod was found (module mode); 0 = std-only
    mod_path: str, // declared module path
    mod_root: str, // dir holding oxl.mod
    mod_floor: str, // `oxl` directive as written
    mod_reqs: own ModEnt, // require path -> version
    mod_reps: own ModEnt, // replace path -> resolved local dir
    modcache: str, // module cache root
    entry_dir: str, // root package dir — anchors the source-tree std walk
    fnvals: own SList, // named fns used as values
    cur_fn: str,
    cur_mod: str, // package clause while checking
    cur_file: str, // file path while checking (import tables key on it)
    retk: int, // current fn's return kind
    ret1: int,
    in_let2: int,
    in_cl: int, // inside `{ |..| }` — ret feeds cl_ret
    cl_ret: int, // inferred closure return ty (-1 none)
    clcks: own ClChk, // deferred closure susp checks
    loop_depth: int,
    nerr: int,
}

fn env_new() -> own Env {
    e := Env{scopes: mkslice(Scope, 0)}
    e.scopes = push(e.scopes, Scope{m: collections.map_new(), moved: nil})
    return new(e)
}

fn env_push(e: mut Env) {
    e.scopes = push(e.scopes, Scope{m: collections.map_new(), moved: nil})
}

fn env_pop(e: mut Env) {
    e.scopes = e.scopes[0:len(e.scopes) - 1]
}

fn env_set(e: mut Env, n: str, t: int) {
    i := len(e.scopes) - 1
    collections.map_set(e.scopes[i].m, n, t)
    // a (re)binding starts un-moved — clears any stale mark on shadow
    e.scopes[i].moved = sl_del(e.scopes[i].moved, n)
}

// ---------- move tracking (D2) ----------
// a binding is marked moved when its `own` value flows somewhere
// ownership transfers (own arg, own field store, return, chan send).
// moved marks live per-scope, parallel to `scopes`.
fn scope_of(e: ref Env, n: str) -> int {
    i := len(e.scopes) - 1
    for i >= 0 {
        if collections.map_has(e.scopes[i].m, n) {
            return i
        }
        i = i - 1
    }
    return -1
}

fn is_moved(e: ref Env, n: str) -> bool {
    i := scope_of(e, n)
    return i >= 0 && sl_has(e.scopes[i].moved, n)
}

fn mark_moved(e: mut Env, n: str) {
    i := scope_of(e, n)
    if i >= 0 && !sl_has(e.scopes[i].moved, n) {
        e.scopes[i].moved = scons(n, e.scopes[i].moved)
    }
}

fn clear_moved(e: mut Env, n: str) {
    i := scope_of(e, n)
    if i >= 0 {
        e.scopes[i].moved = sl_del(e.scopes[i].moved, n)
    }
}

// snapshot of every scope's moved list — outermost first
fn moved_save(e: ref Env) -> own LL {
    let out: own LL = nil
    i := len(e.scopes) - 1
    for i >= 0 {
        c := new(LL)
        c.names = sl_clone(e.scopes[i].moved)
        c.next = out
        out = c
        i = i - 1
    }
    return out
}

fn moved_restore(e: mut Env, s: own LL) {
    i := 0
    for i < len(e.scopes) && s != nil {
        e.scopes[i].moved = s.names
        s = s.next
        i = i + 1
    }
}

// branch merge: keep a binding marked if it moved on ANY path — the
// join can't prove which branch ran
fn moved_union(e: mut Env, other: ref LL) {
    i := 0
    o := other
    for i < len(e.scopes) && o != nil {
        l := o.names
        for l != nil {
            if !sl_has(e.scopes[i].moved, l.v) {
                e.scopes[i].moved = scons(l.v, e.scopes[i].moved)
            }
            l = l.next
        }
        o = o.next
        i = i + 1
    }
}

// does control reach the end of this block? A trailing return/break/
// continue can't have its moves observed at the join
fn falls_through(items: ref parser.NList) -> bool {
    if items == nil {
        return true
    }
    l := items
    for l.next != nil {
        l = l.next
    }
    return stmt_ft(l.v)
}

fn stmt_ft(s: ref parser.Node) -> bool {
    match s {
        parser.Node.Ret{vals} => {
            return false
        }
        parser.Node.Break => {
            return false
        }
        parser.Node.Continue => {
            return false
        }
        parser.Node.If{cond, then, els} => {
            if els == nil {
                return true
            }
            return node_ft(then) || node_ft(els)
        }
        parser.Node.Scope{body} => {
            return node_ft(body)
        }
        _ => {
            return true
        }
    }
    return true
}

fn node_ft(b: ref parser.Node) -> bool {
    if b == nil {
        return true
    }
    match b {
        parser.Node.List{items} => {
            return falls_through(items)
        }
        _ => {
            return stmt_ft(b)
        }
    }
    return true
}

// `e` consumes an `own` binding — mark it moved
fn move_own(ck: mut Ck, e: ref parser.Node, env: mut Env) {
    match e {
        parser.Node.Name(n) => {
            t := env_get(ck, env, n)
            if t >= 0 && ck.tyv[t].k == k_own() {
                mark_moved(env, n)
            }
        }
        _ => {
        }
    }
}

// move only when the destination wants ownership (param, field, ret) —
// an iface data ptr takes it too
fn move_for(ck: mut Ck, e: ref parser.Node, want: int, env: mut Env) {
    if want >= 0 && (ck.tyv[want].k == k_own() || ck.tyv[want].k == k_iface()) {
        move_own(ck, e, env)
    }
}

// deep copy of a moved snapshot — select/match arms each re-run from it
fn ll_clone(l: ref LL) -> own LL {
    if l == nil {
        return nil
    }
    c := new(LL)
    c.names = sl_clone(l.names)
    c.next = ll_clone(l.next)
    return c
}

// after an arm-merge: pre is restored then wiped — the union of the
// arms' end-states re-adds everything that survives
fn moved_clear_all(e: mut Env) {
    i := 0
    for i < len(e.scopes) {
        e.scopes[i].moved = nil
        i = i + 1
    }
}

// `for` post-pass: any binding newly marked inside the body would be
// read moved by the next iteration — unless re-assigned in place
fn for_moved_check(ck: mut Ck, e: ref Env, pre: ref LL) {
    i := 0
    p := pre
    for i < len(e.scopes) && p != nil {
        l := e.scopes[i].moved
        for l != nil {
            if !sl_has(p.names, l.v) {
                diag(ck, "own", "`" + l.v + "` moved inside `for` — re-assign it in the same iteration")
            }
            l = l.next
        }
        p = p.next
        i = i + 1
    }
}

// ---------- generics + interfaces (D1/D3) ----------

// ty param `v` declared on the fn being checked?
fn tp_found(l: ref TPList, v: str) -> bool {
    for l != nil {
        if l.v.n == v {
            return true
        }
        l = l.next
    }
    return false
}

// `v`'s declared constraint ("" when not a param of the current fn)
fn tp_get(l: ref TPList, v: str) -> str {
    for l != nil {
        if l.v.n == v {
            return l.v.c
        }
        l = l.next
    }
    return ""
}

// idx into ifacesv or -1 — `n` must already be qualified
fn iface_ent(ck: ref Ck, n: str) -> int {
    if collections.map_has(ck.ifaces, n) {
        [i, err] = collections.map_get(ck.ifaces, n)
        if err == nil {
            return i
        }
    }
    return -1
}

// Ret equality across (kind, ty) pairs — void carries no ty
fn ret_eq(ck: ref Ck, k1: int, r1: int, k2: int, r2: int) -> bool {
    if k1 != k2 {
        return false
    }
    if k1 == 0 {
        return true
    }
    return ty_eq(ck, r1, r2)
}

// the fixed op vocabulary — a Var operand passes any op (the declared
// constraint gates use sites, not this test)
fn op_ok(ck: ref Ck, op: str, t: int) -> bool {
    k := ck.tyv[t].k
    if op == "eq" {
        return k == k_int() || k == k_bool() || k == k_str() || k == k_chan() || k == k_var()
    }
    if op == "ordered" {
        return k == k_int() || k == k_var()
    }
    if op == "add" {
        return k == k_int() || k == k_str() || k == k_var()
    }
    return false
}

// base type name behind own/ref/mut — the name methods key on
fn ty_base(ck: ref Ck, t: int) -> str {
    k := ck.tyv[t].k
    if k == k_struct() || k == k_enum() {
        return ck.tyv[t].name
    }
    if k == k_own() || k == k_ref() || k == k_mut() {
        i := ck.tyv[t].i
        if i >= 0 {
            return ty_base(ck, i)
        }
    }
    return ""
}

// iface `have` covers everything iface `want` declares
fn iface_covers(ck: ref Ck, have: str, want: str) -> bool {
    wi := iface_ent(ck, want)
    hi := iface_ent(ck, have)
    if wi < 0 || hi < 0 {
        return false
    }
    wo := ck.ifacesv[wi].ops
    for wo != nil {
        if !sl_has(ck.ifacesv[hi].ops, wo.v) {
            return false
        }
        wo = wo.next
    }
    wm := ck.ifacesv[wi].methods
    for wm != nil {
        hm := ck.ifacesv[hi].methods
        ok := false
        for hm != nil {
            if hm.v.n == wm.v.n && il_eq(ck, hm.v.params, wm.v.params) && ret_eq(ck, hm.v.retk, hm.v.ret1, wm.v.retk, wm.v.ret1) {
                ok = true
                break
            }
            hm = hm.next
        }
        if !ok {
            return false
        }
        wm = wm.next
    }
    return true
}

// copy an IList — interface method sigs are shared, callers need own
fn il_clone(l: ref IList) -> own IList {
    if l == nil {
        return nil
    }
    c := new(IList)
    c.v = l.v
    c.next = il_clone(l.next)
    return c
}

// record ty-param bindings by matching an expected param ty against
// the argument's ty — `own T` binds T to the whole own type
fn bind_vars(ck: mut Ck, want: int, got: int, bind: mut collections.Map) {
    wk := ck.tyv[want].k
    gk := ck.tyv[got].k
    if wk == k_var() {
        v := ck.tyv[want].name
        if !collections.map_has(bind, v) {
            collections.map_set(bind, v, got)
        }
        return
    }
    if wk == k_own() && gk == k_own() || wk == k_ref() && gk == k_ref() || wk == k_mut() && gk == k_mut() {
        if ck.tyv[want].i >= 0 && ck.tyv[got].i >= 0 {
            bind_vars(ck, ck.tyv[want].i, ck.tyv[got].i, bind)
        }
        return
    }
    // an own/ref/mut argument into a ref/mut param still binds the inner
    if (wk == k_ref() || wk == k_mut()) && (gk == k_own() || gk == k_mut() || gk == k_ref()) {
        if ck.tyv[want].i >= 0 && ck.tyv[got].i >= 0 {
            bind_vars(ck, ck.tyv[want].i, ck.tyv[got].i, bind)
        }
        return
    }
    if wk == k_slice() && gk == k_slice() {
        if ck.tyv[want].i >= 0 && ck.tyv[got].i >= 0 {
            bind_vars(ck, ck.tyv[want].i, ck.tyv[got].i, bind)
        }
        return
    }
    if wk == k_fn() && gk == k_fn() {
        wp := ck.tyv[want].args
        gp := ck.tyv[got].args
        for wp != nil && gp != nil {
            bind_vars(ck, wp.v, gp.v, bind)
            wp = wp.next
            gp = gp.next
        }
        if ck.tyv[want].r >= 0 && ck.tyv[got].r >= 0 {
            bind_vars(ck, ck.tyv[want].r, ck.tyv[got].r, bind)
        }
    }
}

// substitute bound ty params inside `t` — unbound Vars stay Vars
fn subst_ty(ck: mut Ck, t: int, bind: ref collections.Map) -> int {
    if t < 0 {
        return t
    }
    k := ck.tyv[t].k
    if k == k_var() {
        v := ck.tyv[t].name
        if collections.map_has(bind, v) {
            [bt, err] = collections.map_get(bind, v)
            if err == nil {
                return bt
            }
        }
        return t
    }
    if k == k_own() || k == k_ref() || k == k_mut() {
        return ti(ck, k, subst_ty(ck, ck.tyv[t].i, bind))
    }
    if k == k_slice() {
        return ti(ck, k, subst_ty(ck, ck.tyv[t].i, bind))
    }
    if k == k_fn() {
        let ps: own IList = nil
        l := ck.tyv[t].args
        for l != nil {
            ps = icons(subst_ty(ck, l.v, bind), ps)
            l = l.next
        }
        return tm(ck, k, -1, irev(ps), subst_ty(ck, ck.tyv[t].r, bind), "")
    }
    return t
}

// concrete `tname` carries every method iface `iname` declares — the
// `tname.m` fn must exist with the iface's sig behind a receiver slot
fn impl_satisfies(ck: mut Ck, tname: str, iname: str) -> bool {
    ii := iface_ent(ck, iname)
    if ii < 0 {
        return false
    }
    ml := ck.ifacesv[ii].methods
    for ml != nil {
        q := tname + "." + ml.v.n
        if !collections.map_has(ck.fns, q) {
            return false
        }
        [fi, err] = collections.map_get(ck.fns, q)
        if err != nil {
            return false
        }
        sig := ck.fnsv[fi]
        if sig.is_extern == 1 || ilen(sig.params) != ilen(ml.v.params) + 1 {
            return false
        }
        if sig.typarams == nil {
            w := sig.params.next
            m := ml.v.params
            for w != nil && m != nil {
                if !ty_eq(ck, w.v, m.v) {
                    return false
                }
                w = w.next
                m = m.next
            }
            if w != nil || m != nil || !ret_eq(ck, sig.retk, sig.ret1, ml.v.retk, ml.v.ret1) {
                return false
            }
        } else {
            // generic impl — the iface sig pins the ty params: bind
            // declared params onto the iface's, then compare post-subst
            bind := collections.map_new()
            w := sig.params.next
            m := ml.v.params
            for w != nil && m != nil {
                bind_vars(ck, w.v, m.v, bind)
                w = w.next
                m = m.next
            }
            tp := sig.typarams
            for tp != nil {
                if !collections.map_has(bind, tp.v.n) {
                    return false
                }
                tp = tp.next
            }
            w = sig.params.next
            m = ml.v.params
            for w != nil && m != nil {
                if !ty_eq(ck, subst_ty(ck, w.v, bind), m.v) {
                    return false
                }
                w = w.next
                m = m.next
            }
            if w != nil || m != nil {
                return false
            }
            ok := sig.retk == ml.v.retk
            if ok && sig.retk != 0 {
                ok = ty_eq(ck, subst_ty(ck, sig.ret1, bind), ml.v.ret1)
            }
            if !ok {
                return false
            }
        }
        ml = ml.next
    }
    return true
}

// does `t` satisfy constraint `c` (builtin word or interface name)? A
// method-declaring iface needs the type's method set; ops keep the
// fixed vocabulary
fn satisfies(ck: mut Ck, t: int, c: str) -> bool {
    tk := ck.tyv[t].k
    if tk == k_var() {
        v := ck.tyv[t].name
        if tp_found(ck.cur_ty_params, v) {
            vc := tp_get(ck.cur_ty_params, v)
            if vc == c {
                return true
            }
            if collections.map_has(ck.ifaces, vc) && collections.map_has(ck.ifaces, c) {
                return iface_covers(ck, vc, c)
            }
            ci := iface_ent(ck, c)
            if ci < 0 || ck.ifacesv[ci].methods != nil {
                return false
            }
            ol := ck.ifacesv[ci].ops
            for ol != nil {
                if !op_ok(ck, ol.v, t) {
                    return false
                }
                ol = ol.next
            }
            return true
        }
    }
    if tk == k_iface() {
        if collections.map_has(ck.ifaces, c) {
            return iface_covers(ck, ck.tyv[t].name, c)
        }
    }
    if len(c) == 0 || c == "any" {
        return true
    }
    if c == "eq" || c == "ordered" || c == "add" {
        return op_ok(ck, c, t)
    }
    ci := iface_ent(ck, c)
    if ci < 0 {
        return false
    }
    ol := ck.ifacesv[ci].ops
    for ol != nil {
        if !op_ok(ck, ol.v, t) {
            return false
        }
        ol = ol.next
    }
    if ck.ifacesv[ci].methods == nil {
        return true
    }
    b := ty_base(ck, t)
    if len(b) == 0 {
        return false
    }
    return impl_satisfies(ck, b, c)
}

// `got` flows into iface `want` — concrete impls need the method set,
// ifaces cover ifaces, constrained Vars forward their constraint, and
// nil is the empty pair
fn iface_ok(ck: mut Ck, want: int, got: int) -> bool {
    if ck.tyv[want].k != k_iface() {
        return false
    }
    w := ck.tyv[want].name
    gk := ck.tyv[got].k
    if gk == k_iface() {
        return iface_covers(ck, ck.tyv[got].name, w)
    }
    if gk == k_var() {
        v := ck.tyv[got].name
        if tp_found(ck.cur_ty_params, v) {
            c := tp_get(ck.cur_ty_params, v)
            return c == w || iface_covers(ck, c, w)
        }
        return false
    }
    if gk == k_err() {
        return true
    }
    b := ty_base(ck, got)
    if len(b) == 0 {
        return false
    }
    return impl_satisfies(ck, b, w)
}

// generic bodies may only use operators the constraint permits
fn req_op(ck: mut Ck, var: str, op: str, bop: str) {
    c := ""
    if tp_found(ck.cur_ty_params, var) {
        c = tp_get(ck.cur_ty_params, var)
    }
    has := false
    if c == "eq" {
        has = op == "eq"
    }
    if c == "ordered" {
        has = op == "ordered" || op == "eq"
    }
    if c == "add" {
        has = op == "add"
    }
    if len(c) > 0 && c != "any" && c != "eq" && c != "ordered" && c != "add" {
        ci := iface_ent(ck, c)
        if ci >= 0 {
            has = sl_has(ck.ifacesv[ci].ops, op)
        }
    }
    if !has {
        diag(ck, "type", "`" + bop + "` on `" + var + "` requires constraint `" + op + "` (has `" + c + "`)")
    }
}

// receiver base name behind `own `/`ref `/`mut ` prefixes — the
// method's `T` in its `T.m` key
fn recv_base_ty(s: str) -> str {
    r := strings.trim(s)
    i := find(r, " ")
    for i > 0 {
        q := substr(r, 0, i)
        if q != "own" && q != "ref" && q != "mut" {
            return r
        }
        r = strings.trim(substr(r, i + 1, len(r)))
        i = find(r, " ")
    }
    return r
}

// qualified decl key for a fn — methods are `T.m` on the receiver's
// resolved base name, everything else is `mod.name`
fn fn_qname(ck: mut Ck, mod: str, recv: ref parser.Node, name: str) -> str {
    if recv == nil {
        return qname(mod, name)
    }
    b := ""
    match recv {
        parser.Node.Param{ty} => {
            b = recv_base_ty(ty_str(ty))
        }
        _ => {
        }
    }
    if len(b) == 0 {
        return qname(mod, name)
    }
    return resolve_named(ck, b) + "." + name
}

// method-call resolution target: 1 = direct `T.m` fn, 2 = vtable slot,
// 0 = nothing
struct MT { k: int, q: str, ps: own IList, rk: int, r1: int }

fn method_target(ck: ref Ck, t: int, m: str) -> own MT {
    mt := new(MT{k: 0, q: "", ps: nil, rk: 0, r1: -1})
    tk := ck.tyv[t].k
    if tk == k_own() || tk == k_ref() || tk == k_mut() {
        i := ck.tyv[t].i
        if i >= 0 {
            return method_target(ck, i, m)
        }
        return mt
    }
    if tk == k_struct() || tk == k_enum() {
        q := ck.tyv[t].name + "." + m
        if collections.map_has(ck.fns, q) {
            mt.k = 1
            mt.q = q
        }
        return mt
    }
    if tk == k_iface() {
        ii := iface_ent(ck, ck.tyv[t].name)
        if ii >= 0 {
            ml := ck.ifacesv[ii].methods
            for ml != nil {
                if ml.v.n == m {
                    mt.k = 2
                    mt.q = ck.tyv[t].name + "." + m
                    mt.ps = il_clone(ml.v.params)
                    mt.rk = ml.v.retk
                    mt.r1 = ml.v.ret1
                    return mt
                }
                ml = ml.next
            }
        }
        return mt
    }
    if tk == k_var() {
        v := ck.tyv[t].name
        if tp_found(ck.cur_ty_params, v) {
            c := tp_get(ck.cur_ty_params, v)
            ii := iface_ent(ck, c)
            if ii >= 0 {
                ml := ck.ifacesv[ii].methods
                for ml != nil {
                    if ml.v.n == m {
                        mt.k = 2
                        mt.q = c + "." + m
                        mt.ps = il_clone(ml.v.params)
                        mt.rk = ml.v.retk
                        mt.r1 = ml.v.ret1
                        return mt
                    }
                    ml = ml.next
                }
            }
        }
        return mt
    }
    return mt
}

// `w.m(args)` through an iface vtable — the declared sig checks args
// (the receiver is the data ptr, not a visible arg)
fn call_iface(ck: mut Ck, ps: ref IList, retk: int, ret1: int, args: ref parser.NList, env: mut Env) -> int {
    if nl_len(args) != ilen(ps) {
        diag(ck, "check", "method takes " + itoa(ilen(ps)) + " args, got " + itoa(nl_len(args)))
    }
    wl := ps
    al := args
    for al != nil && wl != nil {
        gt := expr(ck, al.v, env)
        assignable(ck, wl.v, gt)
        move_for(ck, al.v, wl.v, env)
        wl = wl.next
        al = al.next
    }
    if retk == 0 {
        return t_void(ck)
    }
    if retk == 2 && ck.in_let2 == 0 {
        diag(ck, "check", "`[T, err]` result must be bound with `[v, err] =` or returned")
    }
    return ret1
}

// `want`/`got` where `got` is the receiver being adapted: value want
// derefs a pointer arg, pointer want refs a value arg
fn recv_adapt_ty(ck: ref Ck, want: int, got: int) -> int {
    wk := ck.tyv[want].k
    gk := ck.tyv[got].k
    if (wk == k_struct() || wk == k_enum()) && (gk == k_own() || gk == k_ref() || gk == k_mut()) {
        if ty_base(ck, got) == ck.tyv[want].name {
            return want
        }
    }
    if (wk == k_own() || wk == k_ref() || wk == k_mut()) && (gk == k_struct() || gk == k_enum()) {
        if ty_base(ck, want) == ck.tyv[got].name {
            return want
        }
    }
    return got
}

// field ty of `name` on a struct(-ish) `t` — -1 when absent
fn field_ty(ck: ref Ck, t: int, name: str) -> int {
    sn := ""
    k := ck.tyv[t].k
    if k == k_struct() {
        sn = ck.tyv[t].name
    }
    if k == k_own() || k == k_ref() || k == k_mut() {
        i := ck.tyv[t].i
        if i >= 0 && ck.tyv[i].k == k_struct() {
            sn = ck.tyv[i].name
        }
    }
    if len(sn) == 0 || !collections.map_has(ck.structs, sn) {
        return -1
    }
    [si, err] = collections.map_get(ck.structs, sn)
    if err != nil {
        return -1
    }
    return ffind(ck.structsv[si].fields, name)
}

// can `&e` be taken? idents always; field/index chains when their
// base is — anything else is an rvalue
fn is_lvalue(e: ref parser.Node) -> bool {
    if e == nil {
        return false
    }
    k := nk(e)
    if k == 2 {
        return true
    }
    if k == 9 || k == 38 {
        match e {
            parser.Node.Field{obj} => {
                return is_lvalue(obj)
            }
            parser.Node.Index{obj} => {
                return is_lvalue(obj)
            }
            _ => {
            }
        }
    }
    return false
}

// a `T.m` registered under some T ending `.m` — the susp scans have no
// env to type the receiver, so this only approximates (the methods-may-
// not-suspend ban makes wrong answers unreachable in valid code)
fn method_q(ck: ref Ck, m: str) -> str {
    suf := "." + m
    l := ck.methods
    for l != nil {
        if strings.endswith(l.v, suf) {
            return l.v
        }
        l = l.next
    }
    return ""
}

// return kind+ty of a call expr — resolves declared fns, method calls
// through the receiver's ty, and bare `m(x)` method sugar
struct CRet { rk: int, r1: int }

fn call_ret(ck: mut Ck, e: ref parser.Node, env: mut Env) -> own CRet {
    cr := new(CRet{rk: -1, r1: -1})
    if e == nil || nk(e) != 8 {
        return cr
    }
    match e {
        parser.Node.Call{f, args} => {
            n := callee_name(f)
            if len(n) == 0 {
                return cr
            }
            qn := resolve_named(ck, n)
            if collections.map_has(ck.fns, qn) {
                [fi, err] = collections.map_get(ck.fns, qn)
                if err == nil {
                    cr.rk = ck.fnsv[fi].retk
                    cr.r1 = ck.fnsv[fi].ret1
                }
                return cr
            }
            if nk(f) == 9 {
                match f {
                    parser.Node.Field{obj, name} => {
                        ot := expr(ck, obj, env)
                        mt := method_target(ck, ot, name)
                        if mt.k == 2 {
                            cr.rk = mt.rk
                            cr.r1 = mt.r1
                        }
                        if mt.k == 1 && collections.map_has(ck.fns, mt.q) {
                            [fi2, err2] = collections.map_get(ck.fns, mt.q)
                            if err2 == nil {
                                cr.rk = ck.fnsv[fi2].retk
                                cr.r1 = ck.fnsv[fi2].ret1
                            }
                        }
                    }
                    _ => {
                    }
                }
                return cr
            }
            // `m(x, ..)` — method sugar: receiver is args[0] already
            if !is_builtin(n) && args != nil {
                sv := moved_save(env)
                t0 := expr(ck, args.v, env)
                moved_restore(env, sv)
                mt := method_target(ck, t0, n)
                if mt.k == 1 && collections.map_has(ck.fns, mt.q) {
                    [fi3, err3] = collections.map_get(ck.fns, mt.q)
                    if err3 == nil {
                        cr.rk = ck.fnsv[fi3].retk
                        cr.r1 = ck.fnsv[fi3].ret1
                    }
                }
            }
        }
        _ => {
        }
    }
    return cr
}

// ty handle or -1
fn env_get(ck: ref Ck, e: ref Env, n: str) -> int {
    i := len(e.scopes) - 1
    for i >= 0 {
        if collections.map_has(e.scopes[i].m, n) {
            [v, err] = collections.map_get(e.scopes[i].m, n)
            if err == nil {
                return v
            }
        }
        i = i - 1
    }
    if collections.map_has(ck.globals, n) {
        [v2, err2] = collections.map_get(ck.globals, n)
        if err2 == nil {
            return v2
        }
    }
    return -1
}

fn diag(ck: mut Ck, kind: str, msg: str) {
    ck.diags = push(ck.diags, DBox{kind: kind, msg: msg})
    ck.nerr = ck.nerr + 1
}

// ---------- ty handles ----------
fn tm(ck: mut Ck, k: int, i: int, args: own IList, r: int, name: str) -> int {
    ck.tyv = push(ck.tyv, T{k: k, i: i, args: args, r: r, name: name})
    return len(ck.tyv) - 1
}

fn tk(ck: mut Ck, k: int) -> int {
    return tm(ck, k, -1, nil, -1, "")
}

fn tn(ck: mut Ck, k: int, name: str) -> int {
    return tm(ck, k, -1, nil, -1, name)
}

fn ti(ck: mut Ck, k: int, i: int) -> int {
    return tm(ck, k, i, nil, -1, "")
}

fn t_int(ck: mut Ck) -> int {
    return tk(ck, k_int())
}

fn t_str(ck: mut Ck) -> int {
    return tk(ck, k_str())
}

fn t_bool(ck: mut Ck) -> int {
    return tk(ck, k_bool())
}

fn t_err(ck: mut Ck) -> int {
    return tk(ck, k_err())
}

fn t_void(ck: mut Ck) -> int {
    return tk(ck, k_void())
}

fn t_unk(ck: mut Ck) -> int {
    return tk(ck, k_unk())
}

fn il_eq(ck: ref Ck, a: ref IList, b: ref IList) -> bool {
    for a != nil && b != nil {
        if !ty_eq(ck, a.v, b.v) {
            return false
        }
        a = a.next
        b = b.next
    }
    return a == nil && b == nil
}

fn ty_eq(ck: ref Ck, a: int, b: int) -> bool {
    if a == b {
        return true
    }
    ta := ck.tyv[a]
    tb := ck.tyv[b]
    if ta.k != tb.k {
        return false
    }
    if ta.name != tb.name {
        return false
    }
    if ta.i >= 0 || tb.i >= 0 {
        if ta.i < 0 || tb.i < 0 {
            return false
        }
        if !ty_eq(ck, ta.i, tb.i) {
            return false
        }
    }
    if ta.r >= 0 || tb.r >= 0 {
        if ta.r < 0 || tb.r < 0 {
            return false
        }
        if !ty_eq(ck, ta.r, tb.r) {
            return false
        }
    }
    return il_eq(ck, ta.args, tb.args)
}

fn ty_name(ck: ref Ck, t: int) -> str {
    k := ck.tyv[t].k
    if k == k_unk() {
        return "?"
    }
    if k == k_int() {
        return "int"
    }
    if k == k_float() {
        return "float"
    }
    if k == k_bool() {
        return "bool"
    }
    if k == k_str() {
        return "str"
    }
    if k == k_cstr() {
        return "cstr"
    }
    if k == k_void() {
        return "void"
    }
    if k == k_err() {
        return "err"
    }
    if k == k_chan() {
        return "chan"
    }
    if k == k_shared() {
        return "shared"
    }
    if k == k_var() || k == k_struct() || k == k_enum() || k == k_iface() {
        return ck.tyv[t].name
    }
    if k == k_own() {
        return "own " + ty_name(ck, ck.tyv[t].i)
    }
    if k == k_ref() {
        return "ref " + ty_name(ck, ck.tyv[t].i)
    }
    if k == k_mut() {
        return "mut " + ty_name(ck, ck.tyv[t].i)
    }
    if k == k_slice() {
        return "[]" + ty_name(ck, ck.tyv[t].i)
    }
    if k == k_fn() {
        s := "fn("
        l := ck.tyv[t].args
        first := true
        for l != nil {
            if !first {
                s = s + ", "
            }
            first = false
            s = s + ty_name(ck, l.v)
            l = l.next
        }
        s = s + ")"
        r := ck.tyv[t].r
        if r >= 0 && ck.tyv[r].k != k_void() {
            s = s + " -> " + ty_name(ck, r)
        }
        return s
    }
    return "?"
}

// `want := got` — ports Checker::assignable; reports on failure
fn assignable(ck: mut Ck, want: int, got: int) {
    wk := ck.tyv[want].k
    gk := ck.tyv[got].k
    if wk == k_unk() || gk == k_unk() {
        return
    }
    ok := ty_eq(ck, want, got)
    if !ok && wk == k_own() {
        // `own T` accepts `own ?` (untyped boxes like mkbuf)
        ok = gk == k_own() && ck.tyv[got].i >= 0 && ck.tyv[ck.tyv[got].i].k == k_unk()
    }
    if !ok && wk == k_cstr() {
        ok = gk == k_str()
    }
    if !ok && wk == k_err() {
        ok = gk == k_int()
    }
    if !ok && wk == k_int() {
        ok = gk == k_err()
    }
    if !ok && gk == k_err() {
        // nil is the null pointer for owned/borrowed refs, chans, slices
        ok = wk == k_own() || wk == k_ref() || wk == k_mut() || wk == k_chan() || wk == k_slice() || wk == k_shared()
    }
    if !ok && wk == k_ref() {
        if gk == k_own() || gk == k_mut() || gk == k_ref() {
            ok = ty_eq(ck, ck.tyv[want].i, ck.tyv[got].i)
        }
    }
    if !ok && (wk == k_ref() || wk == k_mut()) {
        // `ref T`/`mut T` accept `own ?` (untyped boxes like mkbuf)
        ok = gk == k_own() && ck.tyv[got].i >= 0 && ck.tyv[ck.tyv[got].i].k == k_unk()
    }
    if !ok && wk == k_mut() {
        if gk == k_own() || gk == k_mut() {
            ok = ty_eq(ck, ck.tyv[want].i, ck.tyv[got].i)
        }
    }
    if !ok && wk == k_iface() {
        // interface want: method-set satisfaction, iface coverage, a
        // constrained Var, or nil
        ok = iface_ok(ck, want, got)
    }
    if !ok {
        diag(ck, "type", "expected `" + ty_name(ck, want) + "`, found `" + ty_name(ck, got) + "`")
    }
}

fn is_word(ck: ref Ck, t: int) -> bool {
    k := ck.tyv[t].k
    return k == k_int() || k == k_bool() || k == k_chan() || k == k_own() || k == k_shared()
}

// ---------- node helpers ----------

// node tag — one compiler-checked mapping for every `kind()` use site
fn nk(n: ref parser.Node) -> int {
    i := match n {
        parser.Node.JInt(_) => 0
        parser.Node.JFloat(_) => 42
        parser.Node.JStr(_) => 1
        parser.Node.Name(_) => 2
        parser.Node.Ty(_) => 3
        parser.Node.NamedField{name} => 4
        parser.Node.Param{name} => 5
        parser.Node.FieldDef{name} => 6
        parser.Node.Lit{obj} => 7
        parser.Node.Call{f} => 8
        parser.Node.Field{obj} => 9
        parser.Node.Let{name} => 10
        parser.Node.Ret{vals} => 11
        parser.Node.Break => 12
        parser.Node.Continue => 13
        parser.Node.Scope{body} => 14
        parser.Node.Spawn{e} => 15
        parser.Node.SpawnBlocking{e} => 16
        parser.Node.Go{e} => 17
        parser.Node.Let2{names} => 18
        parser.Node.Bind{name} => 19
        parser.Node.ExprStmt{e} => 20
        parser.Node.If{cond} => 21
        parser.Node.For{cond} => 22
        parser.Node.List{items} => 23
        parser.Node.Fn{name} => 24
        parser.Node.Import{path} => 25
        parser.Node.Struct{name} => 26
        parser.Node.Skip{text} => 27
        parser.Node.Root{items} => 28
        parser.Node.Enum{name} => 29
        parser.Node.Variant{name} => 30
        parser.Node.As{e} => 31
        parser.Node.Match{e} => 32
        parser.Node.MArm{pat} => 33
        parser.Node.Pat{path} => 34
        parser.Node.PatWild => 35
        parser.Node.PatLit{v} => 36
        parser.Node.Assign{target} => 37
        parser.Node.Index{obj} => 38
        parser.Node.Slice{obj} => 39
        parser.Node.Defer{call} => 40
        parser.Node.Unsafe{body} => 41
        parser.Node.Select{arms} => 43
        parser.Node.SArm{kind} => 44
        parser.Node.Closure{params} => 45
        parser.Node.PatBind{name} => 46
        parser.Node.Interface{name} => 47
        parser.Node.TyParam{name} => 48
        parser.Node.Method{name} => 49
        parser.Node.Package{name} => 52
        _ => -1
    }
    return i
}

// `Node.Ty` payload string ("" when not a Ty node)
fn ty_str(n: ref parser.Node) -> str {
    if n == nil {
        return ""
    }
    s := match n {
        parser.Node.Ty(v) => v
        _ => ""
    }
    return s
}

// callee name for Call nodes: `f()` bare or `a.b()` field path
fn path_join(obj: ref parser.Node, name: str) -> str {
    b := callee_name(obj)
    if len(b) == 0 {
        return ""
    }
    return b + "." + name
}

fn callee_name(f: ref parser.Node) -> str {
    n := match f {
        parser.Node.Name(v) => v
        parser.Node.Field{obj, name} => path_join(obj, name)
        _ => ""
    }
    return n
}

fn nl_len(l: ref parser.NList) -> int {
    n := 0
    for l != nil {
        n = n + 1
        l = l.next
    }
    return n
}

fn last_dot(s: str) -> int {
    i := find(s, ".")
    last := -1
    for i >= 0 {
        last = i
        i = find(substr(s, last + 1, len(s)), ".")
        if i >= 0 {
            i = i + last + 1
        }
    }
    return last
}

fn last_slash(s: str) -> int {
    i := find(s, "/")
    last := -1
    for i >= 0 {
        last = i
        i = find(substr(s, last + 1, len(s)), "/")
        if i >= 0 {
            i = i + last + 1
        }
    }
    return last
}

fn qname(mod: str, n: str) -> str {
    if len(mod) == 0 {
        return n
    }
    return mod + "." + n
}

// per-file import tables: `import "x" as a` maps qualifier a -> stem,
// plain imports map stem -> stem; `import "x".{n}` maps n -> stem.n
fn file_alias_idx(ck: ref Ck, file: str) -> int {
    i := 0
    for i < len(ck.file_aliases) {
        if ck.file_aliases[i].file == file {
            return i
        }
        i = i + 1
    }
    return -1
}

// qualifier -> stem for the current file's aliases ("" when unaliased)
fn alias_stem(ck: ref Ck, q: str) -> str {
    fi := file_alias_idx(ck, ck.cur_file)
    if fi < 0 {
        return ""
    }
    l := ck.file_aliases[fi].aliases
    for l != nil {
        if l.alias == q {
            return l.stem
        }
        l = l.next
    }
    return ""
}

// bare name -> `stem.name` when the file selectively imported it
fn selective_name(ck: ref Ck, n: str) -> str {
    fi := file_alias_idx(ck, ck.cur_file)
    if fi < 0 {
        return ""
    }
    l := ck.file_aliases[fi].names
    for l != nil {
        if l.alias == n {
            return l.stem
        }
        l = l.next
    }
    return ""
}

// the Rust driver qualifies decls `mod.name` at load; lookups here try
// `cur_mod.head` first for bare and dotted names alike. Import aliases
// rewrite the head of dotted names; selective imports rewrite bare ones.
fn resolve_named(ck: ref Ck, s: str) -> str {
    head := s
    i := find(s, ".")
    if i >= 0 {
        head = substr(s, 0, i)
        stem := alias_stem(ck, head)
        if len(stem) > 0 {
            return stem + substr(s, i, len(s))
        }
        // a selective import binds its head too: `E.V` -> `stem.E.V`
        sel := selective_name(ck, head)
        if len(sel) > 0 {
            return sel + substr(s, i, len(s))
        }
    } else {
        sel := selective_name(ck, s)
        if len(sel) > 0 {
            return sel
        }
    }
    if len(ck.cur_mod) == 0 {
        return s
    }
    cand := ck.cur_mod + "." + head
    if collections.map_has(ck.structs, cand) || collections.map_has(ck.enums, cand) || collections.map_has(ck.fns, cand) || collections.map_has(ck.ifaces, cand) {
        return ck.cur_mod + "." + s
    }
    return s
}

// parse a `Node.Ty` string into a ty handle
fn ty_parse(ck: mut Ck, s: str) -> int {
    if len(s) == 0 {
        return t_unk(ck)
    }
    i := find(s, " ")
    if i > 0 {
        q := substr(s, 0, i)
        rest := strings.trim(substr(s, i + 1, len(s)))
        if q == "own" {
            return ti(ck, k_own(), ty_parse(ck, rest))
        }
        if q == "ref" {
            return ti(ck, k_ref(), ty_parse(ck, rest))
        }
        if q == "mut" {
            return ti(ck, k_mut(), ty_parse(ck, rest))
        }
    }
    if len(s) > 2 && substr(s, 0, 2) == "[]" {
        return ti(ck, k_slice(), ty_parse(ck, substr(s, 2, len(s))))
    }
    if len(s) > 3 && substr(s, 0, 3) == "fn(" {
        // canonical `fn(a, b) -> r` produced by p_ty; find the `)`
        // that closes the arg list at paren depth 0 (args may nest fn(...))
        inner := substr(s, 3, len(s))
        d := 0
        close := -1
        j := 0
        for j < len(inner) {
            ch := byteat(inner, j)
            if ch == 40 {
                d = d + 1
            }
            if ch == 41 {
                if d == 0 {
                    close = j
                    break
                }
                d = d - 1
            }
            j = j + 1
        }
        if close < 0 {
            diag(ck, "check", "malformed fn type `" + s + "`")
            return t_unk(ck)
        }
        argtxt := substr(inner, 0, close)
        rest := strings.trim(substr(inner, close + 1, len(inner)))
        ret := -1
        if len(rest) > 2 && substr(rest, 0, 2) == "->" {
            ret = ty_parse(ck, strings.trim(substr(rest, 2, len(rest))))
        }
        let args: own IList = nil
        // split args on depth-0 commas
        if len(argtxt) > 0 {
            d = 0
            a := 0
            j = 0
            for j <= len(argtxt) {
                if j == len(argtxt) || byteat(argtxt, j) == 44 && d == 0 {
                    args = icons(ty_parse(ck, strings.trim(substr(argtxt, a, j))), args)
                    a = j + 1
                } else {
                    if byteat(argtxt, j) == 40 {
                        d = d + 1
                    }
                    if byteat(argtxt, j) == 41 {
                        d = d - 1
                    }
                }
                j = j + 1
            }
            args = irev(args)
        }
        if ret < 0 {
            ret = t_void(ck)
        }
        return tm(ck, k_fn(), -1, args, ret, "")
    }
    if s == "int" {
        return t_int(ck)
    }
    if s == "float" {
        return tk(ck, k_float())
    }
    if s == "bool" {
        return t_bool(ck)
    }
    if s == "str" {
        return t_str(ck)
    }
    if s == "cstr" {
        return tk(ck, k_cstr())
    }
    if s == "void" {
        return t_void(ck)
    }
    if s == "err" {
        return t_err(ck)
    }
    if s == "chan" {
        return tk(ck, k_chan())
    }
    if s == "shared" {
        return tk(ck, k_shared())
    }
    if sl_has(ck.ty_scope, s) {
        return tn(ck, k_var(), s)
    }
    n := resolve_named(ck, s)
    if collections.map_has(ck.structs, n) {
        return tn(ck, k_struct(), n)
    }
    if collections.map_has(ck.enums, n) {
        return tn(ck, k_enum(), n)
    }
    if collections.map_has(ck.ifaces, n) {
        return tn(ck, k_iface(), n)
    }
    diag(ck, "check", "unknown type `" + s + "`")
    return t_unk(ck)
}

// variant ctor lookup `E.V` — returns the enum-table idx or -1
fn enum_variant(ck: ref Ck, path: str) -> int {
    ld := last_dot(path)
    if ld < 0 {
        return -1
    }
    en := resolve_named(ck, substr(path, 0, ld))
    vn := substr(path, ld + 1, len(path))
    if !collections.map_has(ck.enums, en) {
        return -1
    }
    [ei, err] = collections.map_get(ck.enums, en)
    if err != nil {
        return -1
    }
    vl := ck.enumsv[ei].vars
    for vl != nil {
        if vl.v.n == vn {
            break
        }
        vl = vl.next
    }
    if vl == nil {
        return -1
    }
    return ei
}

// ---------- registration ----------
fn reg_tynames(ck: mut Ck, its: []It) {
    // pass 0: type names first so self-refs and forward use resolve
    i := 0
    for i < len(its) {
        match its[i].node {
            parser.Node.Struct{name, fields} => {
                sn := qname(its[i].mod, name)
                if !collections.map_has(ck.structs, sn) {
                    collections.map_set(ck.structs, sn, len(ck.structsv))
                    ck.structsv = push(ck.structsv, SEnt{n: sn, fields: nil})
                }
            }
            parser.Node.Enum{name, vars} => {
                en := qname(its[i].mod, name)
                if !collections.map_has(ck.enums, en) {
                    collections.map_set(ck.enums, en, len(ck.enumsv))
                    ck.enumsv = push(ck.enumsv, EEnt{n: en, vars: nil})
                }
            }
            parser.Node.Interface{name} => {
                iname := qname(its[i].mod, name)
                if !collections.map_has(ck.ifaces, iname) {
                    collections.map_set(ck.ifaces, iname, len(ck.ifacesv))
                    ck.ifacesv = push(ck.ifacesv, IEnt{n: iname, ops: nil, methods: nil})
                }
            }
            _ => {
            }
        }
        i = i + 1
    }
}

fn reg_variant(ck: mut Ck, en: str, ei: int, vars: ref parser.NList) {
    // pass 1 enum: variants -> E.V payload structs + variant table
    let out: own VList = nil
    let seen: own SList = nil
    vl := vars
    for vl != nil {
        match vl.v {
            parser.Node.Variant{name, args} => {
                if sl_has(seen, name) {
                    diag(ck, "check", "duplicate variant `" + name + "`")
                } else {
                    seen = scons(name, seen)
                    let fields: own FList = nil
                    fi := 0
                    al := args
                    for al != nil {
                        if nk(al.v) == 5 {
                            match al.v {
                                parser.Node.Param{name, ty} => {
                                    fields = fcons(name, ty_parse(ck, ty_str(ty)), fields)
                                }
                                _ => {
                                }
                            }
                        } else {
                            fields = fcons("f" + itoa(fi), ty_parse(ck, ty_str(al.v)), fields)
                        }
                        fi = fi + 1
                        al = al.next
                    }
                    fields = frev(fields)
                    // the `as` payload resolves as a struct `E.V`
                    sn := en + "." + name
                    collections.map_set(ck.structs, sn, len(ck.structsv))
                    ck.structsv = push(ck.structsv, SEnt{n: sn, fields: fclone(fields)})
                    out = vcons(name, fields, out)
                }
            }
            _ => {
            }
        }
        vl = vl.next
    }
    ck.enumsv[ei].vars = vrev(out)
}

fn reg_struct(ck: mut Ck, sn: str, si: int, fields: ref parser.NList) {
    // pass 1 struct: fields resolve; borrowed refs rejected in heap
    let out: own FList = nil
    fl := fields
    for fl != nil {
        match fl.v {
            parser.Node.FieldDef{name, ty} => {
                t := ty_parse(ck, ty_str(ty))
                tk2 := ck.tyv[t].k
                if tk2 == k_ref() || tk2 == k_mut() {
                    diag(ck, "own", "borrowed refs may not be stored in heap objects (v0)")
                }
                out = fcons(name, t, out)
            }
            _ => {
            }
        }
        fl = fl.next
    }
    ck.structsv[si].fields = frev(out)
}

// shared ret resolution for fns + iface method sigs: `-> t` is One,
// `-> [t, err]` is Pair; borrowed refs may not be returned
fn ret_sig(ck: mut Ck, ret: ref parser.Node) -> own CRet {
    cr := new(CRet{rk: 0, r1: -1})
    if ret != nil {
        if nk(ret) == 3 {
            cr.rk = 1
            cr.r1 = ty_parse(ck, ty_str(ret))
        }
        if nk(ret) == 23 { // [T, err]
            match ret {
                parser.Node.List{items} => {
                    cr.rk = 2
                    if items != nil {
                        cr.r1 = ty_parse(ck, ty_str(items.v))
                    }
                }
                _ => {
                }
            }
        }
    }
    if cr.r1 >= 0 {
        rk2 := ck.tyv[cr.r1].k
        if rk2 == k_ref() || rk2 == k_mut() {
            diag(ck, "own", "borrowed refs may not be returned (v0)")
        }
    }
    return cr
}

// (T, ..) param names as an SList — the ty_scope shape
fn tp_names(l: ref TPList) -> own SList {
    if l == nil {
        return nil
    }
    c := new(SList)
    c.v = l.v.n
    c.next = tp_names(l.next)
    return c
}

// pass 1 iface: ops are fixed-vocabulary words; methods resolve to
// receiver-less sigs (interfaces aren't generic — empty ty scope)
fn reg_iface(ck: mut Ck, ii: int, ops: ref parser.NList, methods: ref parser.NList) {
    let ol: own SList = nil
    l := ops
    for l != nil {
        match l.v {
            parser.Node.Name(op) => {
                ol = scons(op, ol)
            }
            _ => {
            }
        }
        l = l.next
    }
    ck.ifacesv[ii].ops = ol
    let ml: own IMList = nil
    l = methods
    for l != nil {
        match l.v {
            parser.Node.Method{name, params, ret} => {
                let ps: own IList = nil
                pl := params
                for pl != nil {
                    match pl.v {
                        parser.Node.Param{ty} => {
                            ps = icons(ty_parse(ck, ty_str(ty)), ps)
                        }
                        _ => {
                        }
                    }
                    pl = pl.next
                }
                cr := ret_sig(ck, ret)
                m := new(IMethod{n: name, params: irev(ps), retk: cr.rk, ret1: cr.r1})
                mc := new(IMList)
                mc.v = m
                mc.next = ml
                ml = mc
            }
            _ => {
            }
        }
        l = l.next
    }
    ck.ifacesv[ii].methods = ml
}

fn reg_fields(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        ck.cur_mod = its[i].mod
        ck.cur_file = its[i].file
        match its[i].node {
            parser.Node.Interface{name, ops, methods} => {
                iname := qname(its[i].mod, name)
                if collections.map_has(ck.ifaces, iname) {
                    [ii, err] = collections.map_get(ck.ifaces, iname)
                    if err == nil {
                        reg_iface(ck, ii, ops, methods)
                    }
                }
            }
            parser.Node.Enum{name, vars} => {
                en := qname(its[i].mod, name)
                if collections.map_has(ck.enums, en) {
                    [ei, err] = collections.map_get(ck.enums, en)
                    if err == nil {
                        reg_variant(ck, en, ei, vars)
                    }
                }
            }
            parser.Node.Struct{name, fields} => {
                sn := qname(its[i].mod, name)
                if collections.map_has(ck.structs, sn) {
                    [si, err] = collections.map_get(ck.structs, sn)
                    if err == nil {
                        reg_struct(ck, sn, si, fields)
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1
    }
}

fn reg_fn(ck: mut Ck, mod: str, ex: bool, name: str, recv: ref parser.Node, typarams: ref parser.NList, params: ref parser.NList, ret: ref parser.Node) {
    // pass 2 fn: params + ret resolve into a signature; generic params
    // scope ty names, a receiver prefixes the sig and keys `T.m`
    let tp: own TPList = nil
    let tnames: own SList = nil
    tl := typarams
    for tl != nil {
        match tl.v {
            parser.Node.TyParam{name, constraint} => {
                te := new(TPEnt{n: name, c: constraint})
                tc := new(TPList)
                tc.v = te
                tc.next = tp
                tp = tc
                tnames = scons(name, tnames)
            }
            _ => {
            }
        }
        tl = tl.next
    }
    ck.ty_scope = tnames
    qn := name
    if !ex {
        qn = fn_qname(ck, mod, recv, name)
    }
    let ps: own IList = nil
    if recv != nil {
        match recv {
            parser.Node.Param{ty} => {
                rt := ty_parse(ck, ty_str(ty))
                rk0 := ck.tyv[rt].k
                ok := rk0 == k_struct() || rk0 == k_enum()
                if !ok && (rk0 == k_own() || rk0 == k_ref() || rk0 == k_mut()) {
                    i0 := ck.tyv[rt].i
                    ok = i0 >= 0 && (ck.tyv[i0].k == k_struct() || ck.tyv[i0].k == k_enum())
                }
                if !ok {
                    diag(ck, "check", "method receiver must be a declared struct/enum type (optionally behind own/ref/mut)")
                }
                ps = icons(rt, ps)
            }
            _ => {
            }
        }
    }
    pl := params
    for pl != nil {
        match pl.v {
            parser.Node.Param{name, ty} => {
                ps = icons(ty_parse(ck, ty_str(ty)), ps)
            }
            _ => {
            }
        }
        pl = pl.next
    }
    ps = irev(ps)
    cr := ret_sig(ck, ret)
    ck.ty_scope = nil
    if !ex && is_builtin(qn) {
        diag(ck, "check", "`" + name + "` is a builtin and cannot be redefined")
    }
    tl2 := tp
    for tl2 != nil {
        c := tl2.v.c
        if len(c) > 0 && c != "any" && c != "ordered" && c != "eq" && c != "add" {
            if iface_ent(ck, resolve_named(ck, c)) < 0 {
                diag(ck, "check", "unknown constraint `" + c + "` for `" + tl2.v.n + "`")
            }
        }
        tl2 = tl2.next
    }
    if recv != nil {
        ck.methods = scons(qn, ck.methods)
    }
    if !collections.map_has(ck.fns, qn) {
        collections.map_set(ck.fns, qn, len(ck.fnsv))
        ck.fnsv = push(ck.fnsv, FnSig{params: ps, retk: cr.rk, ret1: cr.r1, is_extern: 0, typarams: tp})
    }
    if ex {
        [idx, err2] = collections.map_get(ck.fns, qn)
        if err2 == nil {
            ck.fnsv[idx].is_extern = 1
        }
    }
}

fn reg_global(ck: mut Ck, name: str, ty: ref parser.Node, init: ref parser.Node) {
    // top-level `let` = a global; its init is checked against no env
    e := env_new()
    it := expr(ck, init, e)
    t := it
    if ty != nil {
        want := ty_parse(ck, ty_str(ty))
        assignable(ck, want, it)
        t = want
    }
    collections.map_set(ck.globals, name, t)
}

fn reg_sigs(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        ck.cur_mod = its[i].mod
        ck.cur_file = its[i].file
        match its[i].node {
            parser.Node.Fn{ex, name, recv, typarams, params, ret, body} => {
                reg_fn(ck, its[i].mod, ex, name, recv, typarams, params, ret)
            }
            parser.Node.Let{name, ty, init} => {
                reg_global(ck, name, ty, init)
            }
            _ => {
            }
        }
        i = i + 1
    }
    ck.cur_mod = ""
    ck.cur_file = ""
}

fn register(ck: mut Ck, its: []It) {
    reg_tynames(ck, its)
    reg_fields(ck, its)
    reg_sigs(ck, its)
}

// ---------- builtins ----------
fn is_builtin(n: str) -> bool {
    return n == "print" || n == "println" || n == "mkchan" || n == "send" || n == "recv" || n == "close" || n == "sleep" || n == "msleep" || n == "new" || n == "mkslice" || n == "push" || n == "assert" || n == "itoa" || n == "argc" || n == "argv" || n == "len" || n == "byteat" || n == "substr" || n == "find" || n == "atoi" || n == "mkbuf" || n == "bufstr" || n == "poke8" || n == "poke16" || n == "poke32" || n == "htons" || n == "htonl" || n == "cstr" || n == "sqlite_open" || n == "str" || n == "sqlite_exec" || n == "sqlite_exec_bind" || n == "set_rcvtimo" || n == "set_sndtimo" || n == "sqlite_query" || n == "sqlite_close" || n == "readfile" || n == "writefile" || n == "exit" || n == "mkshared" || n == "sget" || n == "sset" || n == "scas" || n == "sadd" || n == "now" || n == "now_ms" || n == "usleep" || n == "ftoi" || n == "itof" || n == "atof" || n == "ftoa"
}

fn is_susp_builtin(n: str) -> bool {
    return n == "recv" || n == "send" || n == "sleep" || n == "msleep"
}

// ---------- expressions ----------
fn expr(ck: mut Ck, e: ref parser.Node, env: mut Env) -> int {
    if e == nil {
        return t_unk(ck)
    }
    t := match e {
        parser.Node.JInt(_) => t_int(ck)
        parser.Node.JFloat(_) => tk(ck, k_float())
        parser.Node.JStr(_) => t_str(ck)
        parser.Node.Name(n) => ident(ck, n, env)
        parser.Node.Call{f, args} => call(ck, f, args, env)
        parser.Node.Field{obj, name} => field_expr(ck, obj, name, env)
        parser.Node.Un{op, e} => un_expr(ck, op, e, env)
        parser.Node.Bin{op, l, r} => bin_expr(ck, op, l, r, env)
        parser.Node.Lit{obj, fields} => lit_expr(ck, obj, fields, env)
        parser.Node.As{e, ty} => as_expr(ck, e, ty, env)
        parser.Node.Match{e, arms} => match_expr(ck, e, arms, env)
        parser.Node.Closure{params, body} => closure_expr(ck, params, body, env)
        parser.Node.Index{obj, idx} => index_expr(ck, obj, idx, env)
        parser.Node.Slice{obj, lo, hi} => slice_expr(ck, obj, lo, hi, env)
        parser.Node.Ty(_) => tylit_bad(ck)
        _ => t_unk(ck)
    }
    return t
}

fn tylit_bad(ck: mut Ck) -> int {
    diag(ck, "type", "type literal only allowed as `mkslice` element type")
    return t_unk(ck)
}

fn ident(ck: mut Ck, n: str, env: mut Env) -> int {
    // `nil`/`true`/`false` parse as Name in the bootstrap AST
    if n == "nil" {
        return t_err(ck)
    }
    if n == "true" || n == "false" {
        return t_bool(ck)
    }
    t := env_get(ck, env, n)
    if t >= 0 {
        if is_moved(env, n) {
            diag(ck, "own", "use of moved value `" + n + "`")
        }
        return t
    }
    qn := resolve_named(ck, n)
    if collections.map_has(ck.fns, qn) {
        [fi, err] = collections.map_get(ck.fns, qn)
        if err == nil {
            sig := ck.fnsv[fi]
            // named fn as a value — generics need a call site, [T,err]
            // has no shared ret struct
            if sig.typarams != nil {
                diag(ck, "check", "generic fn `" + n + "` can't be a value — call it to instantiate")
            } else if sig.retk == 2 {
                diag(ck, "check", "`" + n + "` returns `[T, err]` — pair returns can't be fn values (v0.2)")
            } else {
                ck.fnvals = scons(qn, ck.fnvals)
                r1 := sig.ret1
                if sig.retk == 0 {
                    r1 = t_void(ck)
                }
                return tm(ck, k_fn(), -1, sig.params, r1, "")
            }
        }
        return t_unk(ck)
    }
    if is_builtin(n) {
        diag(ck, "check", "`" + n + "` is a function — call it")
    } else {
        diag(ck, "check", "undefined `" + n + "`")
    }
    return t_unk(ck)
}

fn field_expr(ck: mut Ck, obj: ref parser.Node, name: str, env: mut Env) -> int {
    // unit enum variant `E.V` — obj flattens to a path, not a value
    base := callee_name(obj)
    if len(base) > 0 {
        path := resolve_named(ck, base)
        if collections.map_has(ck.enums, path) {
            [ei, err] = collections.map_get(ck.enums, path)
            if err == nil {
                vl := ck.enumsv[ei].vars
                for vl != nil {
                    if vl.v.n == name {
                        break
                    }
                    vl = vl.next
                }
                if vl == nil {
                    diag(ck, "check", "enum `" + path + "` has no variant `" + name + "`")
                    return t_unk(ck)
                }
                if vl.v.fields != nil {
                    diag(ck, "check", "`" + path + "." + name + "` has a payload — construct it")
                    return t_unk(ck)
                }
                return tn(ck, k_enum(), path)
            }
        }
    }
    t := expr(ck, obj, env)
    sn := ""
    tk2 := ck.tyv[t].k
    if tk2 == k_struct() {
        sn = ck.tyv[t].name
    }
    if tk2 == k_own() || tk2 == k_ref() || tk2 == k_mut() {
        inner := ck.tyv[t].i
        if inner >= 0 && ck.tyv[inner].k == k_struct() {
            sn = ck.tyv[inner].name
        }
    }
    if len(sn) == 0 {
        if tk2 != k_unk() {
            diag(ck, "type", "`." + name + "` on non-struct `" + ty_name(ck, t) + "`")
        }
        return t_unk(ck)
    }
    if !collections.map_has(ck.structs, sn) {
        return t_unk(ck)
    }
    [si, err] = collections.map_get(ck.structs, sn)
    if err != nil {
        return t_unk(ck)
    }
    ft := ffind(ck.structsv[si].fields, name)
    if ft < 0 {
        diag(ck, "type", "`" + sn + "` has no field `" + name + "`")
        return t_unk(ck)
    }
    return ft
}

// every `{name: expr}` literal field — shared by struct and enum paths
fn lit_fields(ck: mut Ck, path: str, want: ref FList, fields: ref parser.NList, env: mut Env) {
    fl := fields
    for fl != nil {
        match fl.v {
            parser.Node.NamedField{name, val} => {
                wt := ffind(want, name)
                if wt < 0 {
                    diag(ck, "type", "`" + path + "` has no field `" + name + "`")
                } else {
                    gt := expr(ck, val, env)
                    assignable(ck, wt, gt)
                    move_for(ck, val, wt, env)
                }
            }
            _ => {
            }
        }
        fl = fl.next
    }
    w := want
    for w != nil {
        found := false
        fl := fields
        for fl != nil {
            match fl.v {
                parser.Node.NamedField{name, val} => {
                    if name == w.v.n {
                        found = true
                    }
                }
                _ => {
                }
            }
            fl = fl.next
        }
        if !found {
            diag(ck, "type", "missing field `" + w.v.n + "` in `" + path + "` literal")
        }
        w = w.next
    }
}

fn lit_expr(ck: mut Ck, obj: ref parser.Node, fields: ref parser.NList, env: mut Env) -> int {
    name := callee_name(obj)
    path := resolve_named(ck, name)
    // named enum payload `E.V{f: x, ..}`
    ei := enum_variant(ck, path)
    if ei >= 0 {
        ld := last_dot(path)
        vn := substr(path, ld + 1, len(path))
        en := substr(path, 0, ld)
        vl := ck.enumsv[ei].vars
        for vl != nil {
            if vl.v.n == vn {
                break
            }
            vl = vl.next
        }
        want := vl.v.fields
        if want == nil || fall_positional(want) {
            diag(ck, "check", "`" + path + "` has positional payload — call it `" + path + "(...)`")
        } else {
            given := nl_len(fields)
            if given != flen(want) {
                diag(ck, "type", "`" + path + "` takes " + itoa(flen(want)) + " payload field(s), found " + itoa(given))
            } else {
                lit_fields(ck, path, want, fields, env)
            }
        }
        return tn(ck, k_enum(), en)
    }
    if !collections.map_has(ck.structs, path) {
        diag(ck, "type", "unknown struct `" + name + "`")
        return t_unk(ck)
    }
    [si, err] = collections.map_get(ck.structs, path)
    if err != nil {
        return t_unk(ck)
    }
    lit_fields(ck, path, ck.structsv[si].fields, fields, env)
    return tn(ck, k_struct(), path)
}

fn as_expr(ck: mut Ck, inner: ref parser.Node, ty: ref parser.Node, env: mut Env) -> int {
    ot := expr(ck, inner, env)
    wt := ty_parse(ck, ty_str(ty))
    ok := ck.tyv[ot].k
    oname := ""
    if ok == k_enum() {
        oname = ck.tyv[ot].name
    }
    if ok == k_own() {
        inner2 := ck.tyv[ot].i
        if inner2 >= 0 && ck.tyv[inner2].k == k_enum() {
            oname = ck.tyv[inner2].name
            ok = k_enum()
        }
    }
    wk := ck.tyv[wt].k
    if ok == k_enum() && wk == k_struct() {
        // `E.V` payload struct — verify V belongs to the scrutinee's enum
        ei := enum_variant(ck, ck.tyv[wt].name)
        if ei >= 0 && ck.enumsv[ei].n == oname {
            return wt
        }
        diag(ck, "type", "`" + ck.tyv[wt].name + "` is not a variant of `" + oname + "`")
        return t_unk(ck)
    }
    if ok == k_unk() || wk == k_unk() {
        return t_unk(ck)
    }
    diag(ck, "type", "`as` casts enum values to variant payloads — `" + ty_name(ck, ot) + " as " + ty_name(ck, wt) + "` invalid")
    return t_unk(ck)
}

fn index_expr(ck: mut Ck, obj: ref parser.Node, idx: ref parser.Node, env: mut Env) -> int {
    ot := expr(ck, obj, env)
    it := expr(ck, idx, env)
    assignable(ck, t_int(ck), it)
    ok := ck.tyv[ot].k
    if ok == k_slice() {
        return ck.tyv[ot].i
    }
    if ok == k_own() || ok == k_ref() || ok == k_mut() {
        inner := ck.tyv[ot].i
        if inner >= 0 && ck.tyv[inner].k == k_slice() {
            return ck.tyv[inner].i
        }
    }
    if ok != k_unk() {
        diag(ck, "type", "`[]` on `" + ty_name(ck, ot) + "` — not a slice")
    }
    return t_unk(ck)
}

fn slice_expr(ck: mut Ck, obj: ref parser.Node, lo: ref parser.Node, hi: ref parser.Node, env: mut Env) -> int {
    ot := expr(ck, obj, env)
    if lo != nil {
        assignable(ck, t_int(ck), expr(ck, lo, env))
    }
    if hi != nil {
        assignable(ck, t_int(ck), expr(ck, hi, env))
    }
    ok := ck.tyv[ot].k
    if ok == k_slice() {
        return ot
    }
    if ok == k_own() || ok == k_ref() || ok == k_mut() {
        inner := ck.tyv[ot].i
        if inner >= 0 && ck.tyv[inner].k == k_slice() {
            return inner
        }
    }
    if ok != k_unk() {
        diag(ck, "type", "`[..]` on `" + ty_name(ck, ot) + "` — not a slice")
    }
    return t_unk(ck)
}

fn un_expr(ck: mut Ck, op: str, e: ref parser.Node, env: mut Env) -> int {
    t := expr(ck, e, env)
    if op == "!" {
        assignable(ck, t_bool(ck), t)
        return t_bool(ck)
    }
    if ck.tyv[t].k == k_float() {
        return t
    }
    assignable(ck, t_int(ck), t)
    return t_int(ck)
}

fn bin_expr(ck: mut Ck, op: str, l: ref parser.Node, r: ref parser.Node, env: mut Env) -> int {
    lt := expr(ck, l, env)
    rt := expr(ck, r, env)
    lk := ck.tyv[lt].k
    rk := ck.tyv[rt].k
    if op == "&&" || op == "||" {
        assignable(ck, t_bool(ck), lt)
        assignable(ck, t_bool(ck), rt)
        return t_bool(ck)
    }
    if op == "==" || op == "!=" {
        if lk == k_fn() || rk == k_fn() {
            diag(ck, "type", "fn values aren't comparable (v0.2)")
        } else if lk == k_iface() && rk != k_err() || rk == k_iface() && lk != k_err() {
            diag(ck, "type", "iface values aren't comparable except against nil (v0.2)")
        } else {
            assignable(ck, lt, rt)
        }
        return t_bool(ck)
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        if lk == k_var() {
            b := "Lt"
            if op == "<=" {
                b = "Le"
            }
            if op == ">" {
                b = "Gt"
            }
            if op == ">=" {
                b = "Ge"
            }
            req_op(ck, ck.tyv[lt].name, "ordered", b)
        } else if lk == k_float() || rk == k_float() {
            assignable(ck, tk(ck, k_float()), lt)
            assignable(ck, tk(ck, k_float()), rt)
        } else {
            assignable(ck, t_int(ck), lt)
            assignable(ck, t_int(ck), rt)
        }
        return t_bool(ck)
    }
    if op == "+" {
        if lk == k_var() {
            req_op(ck, ck.tyv[lt].name, "add", "Add")
            return tn(ck, k_var(), ck.tyv[lt].name)
        }
        if lk == k_str() && rk == k_str() {
            return t_str(ck)
        }
        if lk == k_float() || rk == k_float() {
            assignable(ck, tk(ck, k_float()), lt)
            assignable(ck, tk(ck, k_float()), rt)
            return tk(ck, k_float())
        }
        assignable(ck, t_int(ck), lt)
        assignable(ck, t_int(ck), rt)
        return t_int(ck)
    }
    if op == "&" || op == "|" || op == "^" {
        assignable(ck, t_int(ck), lt)
        assignable(ck, t_int(ck), rt)
        return t_int(ck)
    }
    // - * / % — numeric; float promotes
    if lk == k_float() || rk == k_float() {
        assignable(ck, tk(ck, k_float()), lt)
        assignable(ck, tk(ck, k_float()), rt)
        return tk(ck, k_float())
    }
    assignable(ck, t_int(ck), lt)
    assignable(ck, t_int(ck), rt)
    return t_int(ck)
}

// ---------- match ----------
fn pat_lit(ck: mut Ck, v: ref parser.Node, st: int, env: mut Env, sk: int, saw: []int) {
    // literal pattern: `1`, `"x"`, true/false; saw[0]=saw_t, saw[1]=saw_f
    lt := expr(ck, v, env)
    if sk == k_bool() && ck.tyv[lt].k == k_bool() {
        match v {
            parser.Node.Name(nm) => {
                if nm == "true" {
                    saw[0] = 1
                }
                if nm == "false" {
                    saw[1] = 1
                }
            }
            _ => {
            }
        }
        return
    }
    if sk != k_unk() && ck.tyv[lt].k != k_unk() {
        assignable(ck, st, lt)
    }
}

fn pat_variant(ck: mut Ck, path: str, binds: ref parser.NList, en: str, covered: mut SListBox, env: mut Env) {
    qpath := resolve_named(ck, path)
    vei := enum_variant(ck, qpath)
    if vei < 0 {
        diag(ck, "check", "unknown variant `" + path + "`")
        return
    }
    ld := last_dot(qpath)
    vn := substr(qpath, ld + 1, len(qpath))
    ven := ck.enumsv[vei].n
    vl := ck.enumsv[vei].vars
    for vl != nil {
        if vl.v.n == vn {
            break
        }
        vl = vl.next
    }
    if len(en) == 0 || ven != en {
        se := en
        if len(se) == 0 {
            se = "non-enum"
        }
        diag(ck, "check", "`" + qpath + "` is a variant of `" + ven + "` — scrutinee is `" + se + "`")
        return
    }
    if vl.v.fields == nil {
        if binds != nil {
            diag(ck, "check", "`" + qpath + "` is a unit variant — drop the binds")
        }
        covered.l = scons(vn, covered.l)
        return
    }
    covered.l = scons(vn, covered.l)
    if fall_positional(vl.v.fields) {
        if binds == nil || nl_len(binds) != flen(vl.v.fields) {
            diag(ck, "check", "`" + qpath + "` takes " + itoa(flen(vl.v.fields)) + " binds, got " + itoa(nl_len(binds)))
            return
        }
        wl := vl.v.fields
        bl := binds
        for bl != nil && wl != nil {
            match bl.v {
                parser.Node.Name(bn) => {
                    if bn != "_" {
                        env_set(env, bn, wl.v.t)
                    }
                }
                _ => {
                }
            }
            wl = wl.next
            bl = bl.next
        }
        return
    }
    bl := binds
    for bl != nil {
        match bl.v {
            parser.Node.Name(bn) => {
                if bn != "_" {
                    ft := ffind(vl.v.fields, bn)
                    if ft < 0 {
                        diag(ck, "check", "`" + qpath + "` has no field `" + bn + "`")
                    } else {
                        env_set(env, bn, ft)
                    }
                }
            }
            _ => {
            }
        }
        bl = bl.next
    }
}

// a box so covered can be threaded through pat_variant
struct SListBox { l: own SList }

fn match_expr(ck: mut Ck, scrut: ref parser.Node, arms: ref parser.NList, env: mut Env) -> int {
    st := expr(ck, scrut, env)
    sk := ck.tyv[st].k
    en := ""
    if sk == k_enum() {
        en = ck.tyv[st].name
    }
    if sk == k_own() || sk == k_ref() || sk == k_mut() {
        inner := ck.tyv[st].i
        if inner >= 0 && ck.tyv[inner].k == k_enum() {
            en = ck.tyv[inner].name
        }
    }
    ei := -1
    if len(en) > 0 && collections.map_has(ck.enums, en) {
        [x, err] = collections.map_get(ck.enums, en)
        if err == nil {
            ei = x
        }
    }
    cov := new(SListBox{l: nil})
    wild := false
    saw := mkslice(int, 2)
    result := -1
    n_expr := 0
    n_block := 0
    // arms are alternative paths — merge `moved` like if/else
    pre := moved_save(env)
    let armst: own ArmSt = nil
    a := arms
    for a != nil {
        moved_restore(env, ll_clone(pre))
        match a.v {
            parser.Node.MArm{pat, body} => {
                env_push(env)
                pk := nk(pat)
                if pk == 35 {
                    wild = true
                }
                if pk == 46 {
                    // Pattern::Bind — matches everything, binds scrutinee
                    wild = true
                    match pat {
                        parser.Node.PatBind{name} => {
                            env_set(env, name, st)
                        }
                        _ => {
                        }
                    }
                    // binding an `own` scrutinee moves it into the var
                    move_own(ck, scrut, env)
                }
                if pk == 36 {
                    match pat {
                        parser.Node.PatLit{v} => {
                            pat_lit(ck, v, st, env, sk, saw)
                        }
                        _ => {
                        }
                    }
                }
                if pk == 34 {
                    match pat {
                        parser.Node.Pat{path, binds} => {
                            pat_variant(ck, path, binds, en, cov, env)
                        }
                        _ => {
                        }
                    }
                }
                if body != nil && nk(body) == 23 {
                    n_block = n_block + 1
                    match body {
                        parser.Node.List{items} => {
                            block(ck, items, env)
                        }
                        _ => {
                        }
                    }
                } else {
                    n_expr = n_expr + 1
                    bt := expr(ck, body, env)
                    if result < 0 {
                        result = bt
                    } else {
                        assignable(ck, result, bt)
                    }
                }
                env_pop(env)
            }
            _ => {
            }
        }
        a = a.next
    }
    if n_expr > 0 && n_block > 0 {
        diag(ck, "check", "match arms must be all expressions or all blocks — not mixed")
    }
    if !wild && sk != k_unk() {
        if ei >= 0 {
            missing := ""
            vl := ck.enumsv[ei].vars
            for vl != nil {
                if !sl_has(cov.l, vl.v.n) {
                    if len(missing) > 0 {
                        missing = missing + ", "
                    }
                    missing = missing + vl.v.n
                }
                vl = vl.next
            }
            if len(missing) > 0 {
                diag(ck, "check", "non-exhaustive match on `" + en + "` — missing " + missing)
            }
        } else if sk == k_bool() {
            if saw[0] == 0 || saw[1] == 0 {
                diag(ck, "check", "non-exhaustive match on `bool` — cover `true`/`false` or add `_`")
            }
        } else {
            diag(ck, "check", "`match` on `" + ty_name(ck, st) + "` needs a `_` arm")
        }
    }
    if n_expr > 0 {
        if result < 0 {
            return t_void(ck)
        }
        return result
    }
    return t_void(ck)
}

// ---------- calls ----------
fn call_kind(ck: mut Ck, f: ref parser.Node, args: ref parser.NList, env: mut Env) -> int {
    // `e.kind()` — enum tag accessor
    match f {
        parser.Node.Field{obj, name} => {
            ot := expr(ck, obj, env)
            ok := ck.tyv[ot].k
            if ok == k_enum() {
                return t_int(ck)
            }
            if ok == k_own() {
                inner := ck.tyv[ot].i
                if inner >= 0 && ck.tyv[inner].k == k_enum() {
                    return t_int(ck)
                }
            }
            if ok != k_unk() {
                diag(ck, "type", "`.kind()` on non-enum `" + ty_name(ck, ot) + "`")
            }
            return t_unk(ck)
        }
        _ => {
        }
    }
    return t_unk(ck)
}

fn call(ck: mut Ck, f: ref parser.Node, args: ref parser.NList, env: mut Env) -> int {
    name := callee_name(f)
    if len(name) > 0 {
        // enum variant ctor `E.V(...)`
        ei := enum_variant(ck, name)
        if ei >= 0 {
            ld := last_dot(name)
            vn := substr(name, ld + 1, len(name))
            en := ck.enumsv[ei].n
            vl := ck.enumsv[ei].vars
            for vl != nil {
                if vl.v.n == vn {
                    break
                }
                vl = vl.next
            }
            want := vl.v.fields
            if want != nil && !fall_positional(want) {
                diag(ck, "check", "`" + name + "` has named payload — use `" + name + "{...}`")
            } else {
                given := nl_len(args)
                wlen := flen(want)
                if given != wlen {
                    diag(ck, "type", "`" + name + "` takes " + itoa(wlen) + " payload field(s), found " + itoa(given))
                } else {
                    wl := want
                    al := args
                    for al != nil && wl != nil {
                        gt := expr(ck, al.v, env)
                        assignable(ck, wl.v.t, gt)
                        wl = wl.next
                        al = al.next
                    }
                }
            }
            return tn(ck, k_enum(), en)
        }
        // `e.kind()` — enum tag accessor
        if len(name) > 5 && substr(name, len(name) - 5, len(name)) == ".kind" {
            if args == nil {
                return call_kind(ck, f, args, env)
            }
        }
        // local fn value shadows a same-named fn or builtin
        lt := env_get(ck, env, name)
        if lt >= 0 && ck.tyv[lt].k == k_fn() {
            return call_fnvalue(ck, ck.tyv[lt].args, ck.tyv[lt].r, args, env)
        }
        qn := resolve_named(ck, name)
        // method dispatch (D3): `x.m(..)` resolves via the receiver's ty
        // to `T.m` (a fn-typed field wins); `w.m(..)` on an iface or a
        // generic constraint vtab-dispatches; a bare `m(x,..)` that isn't
        // a fn retries as a method on args[0]'s ty
        let recv: ref parser.Node = nil
        if !collections.map_has(ck.fns, qn) {
            if nk(f) == 9 {
                match f {
                    parser.Node.Field{obj, name} => {
                        ot := expr(ck, obj, env)
                        if ck.tyv[ot].k == k_unk() {
                            return t_unk(ck)
                        }
                        ft := field_ty(ck, ot, name)
                        if ft >= 0 {
                            if ck.tyv[ft].k == k_fn() {
                                return call_fnvalue(ck, ck.tyv[ft].args, ck.tyv[ft].r, args, env)
                            }
                            bn := ty_base(ck, ot)
                            if len(bn) == 0 {
                                bn = ty_name(ck, ot)
                            }
                            diag(ck, "type", "`" + bn + "." + name + "` is a field of `" + ty_name(ck, ot) + "`, not callable")
                            return t_unk(ck)
                        }
                        mt := method_target(ck, ot, name)
                        if mt.k == 2 {
                            return call_iface(ck, mt.ps, mt.rk, mt.r1, args, env)
                        }
                        if mt.k == 1 {
                            recv = obj
                            qn = mt.q
                        }
                        if mt.k == 0 {
                            diag(ck, "type", "no method `" + name + "` on `" + ty_name(ck, ot) + "`")
                            return t_unk(ck)
                        }
                    }
                    _ => {
                    }
                }
            } else if !is_builtin(name) && args != nil {
                // `m(x, ..)` — method sugar: receiver is args[0] already.
                // Skip builtins (`new(T)`'s arg is a type name); the probe
                // re-evaluates args[0] so its move marks must not leak
                sv := moved_save(env)
                t0 := expr(ck, args.v, env)
                moved_restore(env, sv)
                mt := method_target(ck, t0, name)
                if mt.k == 1 {
                    qn = mt.q
                }
            }
        }
        if collections.map_has(ck.fns, qn) {
            add_edge(ck, qn)
        }
        // ---------- builtin table ----------
        if qn == "print" || qn == "println" {
            if nl_len(args) != 1 {
                diag(ck, "check", "`" + name + "` takes 1 argument")
            } else {
                t := expr(ck, args.v, env)
                tk2 := ck.tyv[t].k
                if tk2 != k_str() && tk2 != k_int() && tk2 != k_bool() && tk2 != k_err() && tk2 != k_cstr() && tk2 != k_unk() {
                    diag(ck, "type", "cannot print `" + ty_name(ck, t) + "`")
                }
            }
            return t_void(ck)
        }
        if qn == "mkchan" {
            if nl_len(args) > 1 {
                diag(ck, "check", "`mkchan` takes at most one capacity arg")
            }
            if args != nil {
                assignable(ck, t_int(ck), expr(ck, args.v, env))
            }
            return tk(ck, k_chan())
        }
        if qn == "send" {
            if nl_len(args) != 2 {
                diag(ck, "check", "`send` takes (chan, value)")
            } else {
                assignable(ck, tk(ck, k_chan()), expr(ck, args.v, env))
                vt := expr(ck, args.next.v, env)
                if !is_word(ck, vt) {
                    diag(ck, "own", "channels carry word-sized owned values (v0), not `" + ty_name(ck, vt) + "`")
                }
            }
            return t_void(ck)
        }
        if qn == "recv" {
            return t_int(ck)
        }
        if qn == "close" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_void(ck)
        }
        if qn == "sleep" || qn == "msleep" {
            if args != nil {
                assignable(ck, t_int(ck), expr(ck, args.v, env))
            }
            return t_void(ck)
        }
        if qn == "new" {
            if args != nil {
                a := args.v
                if nk(a) == 2 {
                    match a {
                        parser.Node.Name(an) => {
                            sn := resolve_named(ck, an)
                            if collections.map_has(ck.structs, sn) {
                                return ti(ck, k_own(), tn(ck, k_struct(), sn))
                            }
                        }
                        _ => {
                        }
                    }
                }
                t := expr(ck, a, env)
                return ti(ck, k_own(), t)
            }
            diag(ck, "type", "`new` needs a struct name or value")
            return t_unk(ck)
        }
        if qn == "itoa" {
            if args != nil {
                assignable(ck, t_int(ck), expr(ck, args.v, env))
            }
            return t_str(ck)
        }
        if qn == "assert" {
            if args != nil {
                assignable(ck, t_bool(ck), expr(ck, args.v, env))
            }
            return t_void(ck)
        }
        if qn == "argc" {
            return t_int(ck)
        }
        if qn == "argv" {
            return t_str(ck)
        }
        if qn == "len" {
            if args != nil {
                t := expr(ck, args.v, env)
                ok := ck.tyv[t].k
                good := ok == k_str() || ok == k_slice() || ok == k_unk()
                if !good && (ok == k_own() || ok == k_ref() || ok == k_mut()) {
                    inner := ck.tyv[t].i
                    good = inner >= 0 && ck.tyv[inner].k == k_slice()
                }
                if !good {
                    diag(ck, "type", "`len` takes str or slice — got `" + ty_name(ck, t) + "`")
                }
            }
            return t_int(ck)
        }
        if qn == "mkslice" {
            et := t_unk(ck)
            if args != nil {
                a := args.v
                if nk(a) == 2 {
                    match a {
                        parser.Node.Name(an) => {
                            et = ty_parse(ck, an)
                        }
                        _ => {
                        }
                    }
                } else if nk(a) == 3 {
                    et = ty_parse(ck, ty_str(a))
                } else {
                    diag(ck, "check", "`mkslice` takes a type name — mkslice(int, 8)")
                }
            } else {
                diag(ck, "check", "`mkslice` takes (T, n)")
            }
            if args != nil && args.next != nil {
                assignable(ck, t_int(ck), expr(ck, args.next.v, env))
            } else {
                diag(ck, "check", "`mkslice` takes (T, n)")
            }
            return ti(ck, k_slice(), et)
        }
        if qn == "push" {
            if args == nil {
                return t_unk(ck)
            }
            st := expr(ck, args.v, env)
            if ck.tyv[st].k == k_slice() {
                if args.next != nil {
                    vt := expr(ck, args.next.v, env)
                    assignable(ck, ck.tyv[st].i, vt)
                } else {
                    diag(ck, "check", "`push` takes (slice, value)")
                }
                return st
            }
            if ck.tyv[st].k == k_unk() {
                return st
            }
            diag(ck, "type", "`push` on `" + ty_name(ck, st) + "` — not a slice")
            return t_unk(ck)
        }
        if qn == "byteat" || qn == "find" || qn == "atoi" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_int(ck)
        }
        if qn == "ftoi" {
            if args != nil {
                assignable(ck, tk(ck, k_float()), expr(ck, args.v, env))
            }
            return t_int(ck)
        }
        if qn == "itof" {
            if args != nil {
                assignable(ck, t_int(ck), expr(ck, args.v, env))
            }
            return tk(ck, k_float())
        }
        if qn == "atof" {
            if args != nil {
                assignable(ck, t_str(ck), expr(ck, args.v, env))
            }
            return tk(ck, k_float())
        }
        if qn == "ftoa" {
            if args != nil {
                assignable(ck, tk(ck, k_float()), expr(ck, args.v, env))
            }
            return t_str(ck)
        }
        if qn == "substr" || qn == "bufstr" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_str(ck)
        }
        if qn == "mkbuf" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return ti(ck, k_own(), t_unk(ck))
        }
        if qn == "poke8" || qn == "poke16" || qn == "poke32" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_void(ck)
        }
        if qn == "htons" || qn == "htonl" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_int(ck)
        }
        if qn == "cstr" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return tk(ck, k_cstr())
        }
        if qn == "sqlite_open" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return ti(ck, k_own(), t_unk(ck))
        }
        if qn == "str" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_str(ck)
        }
        if qn == "sqlite_exec" || qn == "sqlite_exec_bind" || qn == "set_rcvtimo" || qn == "set_sndtimo" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_int(ck)
        }
        if qn == "sqlite_query" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_str(ck)
        }
        if qn == "sqlite_close" || qn == "exit" || qn == "sset" || qn == "writefile" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            if qn == "writefile" {
                return t_int(ck)
            }
            return t_void(ck)
        }
        if qn == "readfile" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_str(ck)
        }
        if qn == "sget" || qn == "scas" || qn == "sadd" || qn == "now" || qn == "now_ms" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_int(ck)
        }
        if qn == "usleep" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return t_void(ck)
        }
        if qn == "mkshared" {
            al := args
            for al != nil {
                expr(ck, al.v, env)
                al = al.next
            }
            return tk(ck, k_shared())
        }
        // ---------- declared fns ----------
        if !collections.map_has(ck.fns, qn) {
            diag(ck, "check", "undefined `" + name + "`")
            return t_unk(ck)
        }
        [fi, err] = collections.map_get(ck.fns, qn)
        if err != nil {
            return t_unk(ck)
        }
        sig := ck.fnsv[fi]
        if sig.is_extern == 1 {
            al := args
            for al != nil {
                t := expr(ck, al.v, env)
                tk2 := ck.tyv[t].k
                if tk2 != k_int() && tk2 != k_bool() && tk2 != k_cstr() && tk2 != k_str() && tk2 != k_own() && tk2 != k_ref() && tk2 != k_mut() && tk2 != k_chan() && tk2 != k_shared() && tk2 != k_fn() && tk2 != k_unk() {
                    diag(ck, "ffi", "`" + ty_name(ck, t) + "` cannot cross the FFI boundary")
                }
                al = al.next
            }
        }
        have := nl_len(args)
        if recv != nil {
            have = have + 1
        }
        if have != ilen(sig.params) {
            diag(ck, "check", "`" + qn + "` takes " + itoa(ilen(sig.params)) + " args, got " + itoa(have))
        }
        // generic: bind ty params from argument tys, check constraints
        bind := collections.map_new()
        if sig.typarams != nil {
            wl0 := sig.params
            if recv != nil && wl0 != nil {
                bind_vars(ck, wl0.v, expr(ck, recv, env), bind)
                wl0 = wl0.next
            }
            al0 := args
            for al0 != nil && wl0 != nil {
                bind_vars(ck, wl0.v, expr(ck, al0.v, env), bind)
                wl0 = wl0.next
                al0 = al0.next
            }
            tl := sig.typarams
            for tl != nil {
                tv := tl.v.n
                if collections.map_has(bind, tv) {
                    [bt, err3] = collections.map_get(bind, tv)
                    if err3 == nil && !satisfies(ck, bt, tl.v.c) {
                        diag(ck, "type", "`" + ty_name(ck, bt) + "` does not satisfy constraint `" + tl.v.c + "`")
                    }
                } else {
                    diag(ck, "type", "cannot infer type parameter `" + tv + "`")
                }
                tl = tl.next
            }
        }
        wl := sig.params
        al := args
        if recv != nil && wl != nil {
            // receiver slot: `*x`/`&x` adapt — `&` needs an lvalue
            want := subst_ty(ck, wl.v, bind)
            got := expr(ck, recv, env)
            wk2 := ck.tyv[want].k
            gk2 := ck.tyv[got].k
            if (wk2 == k_own() || wk2 == k_ref() || wk2 == k_mut()) && (gk2 == k_struct() || gk2 == k_enum()) && !is_lvalue(recv) {
                diag(ck, "type", "pointer receiver on an rvalue — bind it first")
            }
            got = recv_adapt_ty(ck, want, got)
            assignable(ck, want, got)
            move_for(ck, recv, want, env)
            wl = wl.next
        }
        for al != nil && wl != nil {
            want := subst_ty(ck, wl.v, bind)
            gt := expr(ck, al.v, env)
            assignable(ck, want, gt)
            move_for(ck, al.v, want, env)
            wl = wl.next
            al = al.next
        }
        if sig.retk == 0 {
            return t_void(ck)
        }
        r1 := sig.ret1
        if sig.typarams != nil {
            r1 = subst_ty(ck, r1, bind)
        }
        if sig.retk == 1 {
            return r1
        }
        if ck.in_let2 == 0 {
            diag(ck, "check", "`[T, err]` result must be bound with `[v, err] =` or returned")
        }
        return r1
    }
    // non-name callee — indirect call through a fn value
    ft := expr(ck, f, env)
    if ck.tyv[ft].k == k_fn() {
        return call_fnvalue(ck, ck.tyv[ft].args, ck.tyv[ft].r, args, env)
    }
    if ck.tyv[ft].k != k_unk() {
        diag(ck, "type", "call of non-function `" + ty_name(ck, ft) + "`")
    }
    return t_unk(ck)
}

fn call_fnvalue(ck: mut Ck, ps: ref IList, r: int, args: ref parser.NList, env: mut Env) -> int {
    if nl_len(args) != ilen(ps) {
        diag(ck, "check", "fn value takes " + itoa(ilen(ps)) + " args, got " + itoa(nl_len(args)))
    }
    wl := ps
    al := args
    for al != nil && wl != nil {
        gt := expr(ck, al.v, env)
        assignable(ck, wl.v, gt)
        wl = wl.next
        al = al.next
    }
    return r
}

// ret kind for the `[T, err]` binding rules (-1 = not a declared call)
fn call_retk(ck: mut Ck, e: ref parser.Node, env: mut Env) -> int {
    cr := call_ret(ck, e, env)
    return cr.rk
}

// ret1 for a Call node known to hit a pair-returning fn
fn call_ret1(ck: mut Ck, e: ref parser.Node, env: mut Env) -> int {
    cr := call_ret(ck, e, env)
    return cr.r1
}

// ---------- statements ----------
fn block(ck: mut Ck, items: ref parser.NList, env: mut Env) {
    env_push(env)
    l := items
    for l != nil {
        stmt(ck, l.v, env)
        l = l.next
    }
    env_pop(env)
}

fn block_node(ck: mut Ck, body: ref parser.Node, env: mut Env) {
    if body == nil {
        return
    }
    match body {
        parser.Node.List{items} => {
            block(ck, items, env)
        }
        _ => {
        }
    }
}

fn stmt(ck: mut Ck, s: ref parser.Node, env: mut Env) {
    match s {
        parser.Node.Let{name, ty, init} => {
            it := expr(ck, init, env)
            t := it
            if ty != nil {
                want := ty_parse(ck, ty_str(ty))
                assignable(ck, want, it)
                t = want
            }
            env_set(env, name, t)
        }
        parser.Node.Let2{names, call} => {
            ck.in_let2 = 1
            expr(ck, call, env)
            ck.in_let2 = 0
            val_ty := t_unk(ck)
            if call_retk(ck, call, env) == 2 {
                val_ty = call_ret1(ck, call, env)
            } else {
                diag(ck, "check", "`[v, err] = f()` requires a call to a `[T, err]` function")
            }
            i := find(names, ",")
            an := names
            bn := ""
            if i >= 0 {
                an = substr(names, 0, i)
                bn = substr(names, i + 1, len(names))
            }
            if an != "_" {
                env_set(env, an, val_ty)
            }
            if bn == "_" {
                diag(ck, "check", "cannot discard `err` — handle it or pass it up")
            } else if len(bn) > 0 {
                env_set(env, bn, t_err(ck))
            }
        }
        parser.Node.Assign{target, val} => {
            // a bare-ident target is a write, not a use — assignment to
            // a moved-from binding re-initializes it
            idn := ""
            tt := t_unk(ck)
            match target {
                parser.Node.Name(n) => {
                    idn = n
                    tt = env_get(ck, env, n)
                    if tt < 0 {
                        tt = expr(ck, target, env)
                    }
                }
                _ => {
                    tt = expr(ck, target, env)
                }
            }
            vt := expr(ck, val, env)
            assignable(ck, tt, vt)
            // `x = y` re-initializes (aliasing walks like `s = s.next`
            // stay legal); `s.f = y`/`s[i] = y` hand the value away
            if len(idn) == 0 {
                move_for(ck, val, tt, env)
            } else {
                clear_moved(env, idn)
            }
        }
        parser.Node.ExprStmt{e} => {
            if call_retk(ck, e, env) == 2 {
                diag(ck, "check", "call returns `[T, err]` — bind it with `[v, err] =`")
            }
            expr(ck, e, env)
        }
        parser.Node.Defer{call} => {
            expr(ck, call, env)
        }
        parser.Node.Ret{vals} => {
            if ck.in_cl == 1 {
                n0 := nl_len(vals)
                if n0 > 1 {
                    diag(ck, "check", "`[T, err]` returns aren't supported in closures")
                } else {
                    t0 := t_void(ck)
                    if n0 == 1 {
                        t0 = expr(ck, vals.v, env)
                    }
                    if ck.cl_ret < 0 {
                        ck.cl_ret = t0
                    } else {
                        assignable(ck, ck.cl_ret, t0)
                    }
                }
                return
            }
            n := nl_len(vals)
            if ck.retk == 0 {
                if n > 0 {
                    diag(ck, "check", "function returns void")
                }
            } else if ck.retk == 1 {
                if n != 1 {
                    diag(ck, "check", "expected one return value")
                } else {
                    t := expr(ck, vals.v, env)
                    assignable(ck, ck.ret1, t)
                }
            } else if n == 2 {
                t := expr(ck, vals.v, env)
                assignable(ck, ck.ret1, t)
                e2 := expr(ck, vals.next.v, env)
                assignable(ck, t_err(ck), e2)
            } else if n == 1 {
                ck.in_let2 = 1
                expr(ck, vals.v, env)
                ck.in_let2 = 0
                if call_retk(ck, vals.v, env) == 2 {
                    rt1 := call_ret1(ck, vals.v, env)
                    if rt1 >= 0 {
                        assignable(ck, ck.ret1, rt1)
                    }
                } else {
                    diag(ck, "check", "`[T, err]` function must `return v, err` or forward a `[T, err]` call")
                }
            } else {
                diag(ck, "check", "expected `return v, err`")
            }
        }
        parser.Node.If{cond, then, els} => {
            t := expr(ck, cond, env)
            assignable(ck, t_bool(ck), t)
            // a move on either branch is possible after the join — union
            // the exits; only exits that can reach the join contribute
            pre := moved_save(env)
            block_node(ck, then, env)
            thmv := moved_save(env)
            moved_restore(env, pre)
            tft := node_ft(then)
            eft := els == nil
            if els != nil {
                eft = node_ft(els)
                if nk(els) == 23 {
                    block_node(ck, els, env)
                } else {
                    stmt(ck, els, env)
                }
            }
            if els != nil && !eft && tft {
                moved_restore(env, thmv)
            } else if tft && (els == nil || eft) {
                moved_union(env, thmv)
            }
        }
        parser.Node.For{cond, body} => {
            // a move inside the body is read moved by the next iteration
            // unless re-assigned there — flag newly-moved bindings, then
            // restore the pre-loop state (check.rs: Stmt::For)
            pre := moved_save(env)
            t := expr(ck, cond, env)
            assignable(ck, t_bool(ck), t)
            ck.loop_depth = ck.loop_depth + 1
            block_node(ck, body, env)
            ck.loop_depth = ck.loop_depth - 1
            for_moved_check(ck, env, pre)
            moved_restore(env, pre)
        }
        parser.Node.Break => {
            if ck.loop_depth == 0 {
                diag(ck, "check", "break/continue outside loop")
            }
        }
        parser.Node.Continue => {
            if ck.loop_depth == 0 {
                diag(ck, "check", "break/continue outside loop")
            }
        }
        parser.Node.Scope{body} => {
            block_node(ck, body, env)
        }
        parser.Node.Spawn{e} => {
            spawn_stmt(ck, e, env)
        }
        parser.Node.SpawnBlocking{e} => {
            spawn_stmt(ck, e, env)
        }
        parser.Node.Go{e} => {
            spawn_stmt(ck, e, env)
        }
        parser.Node.Bind{name, init} => {
            t := expr(ck, init, env)
            env_set(env, name, t)
        }
        parser.Node.Unsafe{body} => {
            block_node(ck, body, env)
        }
        parser.Node.Select{arms} => {
            sel_stmt(ck, arms, env)
        }
        parser.Node.List{items} => {
            block(ck, items, env)
        }
        parser.Node.Skip{text} => {
            diag(ck, "parse", "unparsed `" + text + "`")
        }
        _ => {
            expr(ck, s, env)
        }
    }
}

fn spawn_stmt(ck: mut Ck, e: ref parser.Node, env: mut Env) {
    if e != nil && nk(e) == 8 {
        match e {
            parser.Node.Call{f, args} => {
                n := callee_name(f)
                if len(n) > 0 {
                    add_edge(ck, resolve_named(ck, n))
                }
            }
            _ => {
            }
        }
        expr(ck, e, env)
        return
    }
    diag(ck, "check", "`spawn` requires a call")
}

fn add_edge(ck: mut Ck, callee: str) {
    e := new(Edge)
    e.a = ck.cur_fn
    e.b = callee
    e.next = ck.edges
    ck.edges = e
}

// ---------- suspend analysis ----------

// args-walk shared by both susp scans
fn args_susp(ck: ref Ck, args: ref parser.NList) -> bool {
    al := args
    for al != nil {
        if expr_susp(ck, al.v) {
            return true
        }
        al = al.next
    }
    return false
}

fn lit_susp(ck: ref Ck, fields: ref parser.NList) -> bool {
    fl := fields
    for fl != nil {
        match fl.v {
            parser.Node.NamedField{val} => {
                if expr_susp(ck, val) {
                    return true
                }
            }
            _ => {
            }
        }
        fl = fl.next
    }
    return false
}

fn match_susp(ck: ref Ck, scrut: ref parser.Node, arms: ref parser.NList) -> bool {
    if expr_susp(ck, scrut) {
        return true
    }
    a := arms
    for a != nil {
        match a.v {
            parser.Node.MArm{pat, body} => {
                if pat != nil && nk(pat) == 36 {
                    match pat {
                        parser.Node.PatLit{v} => {
                            if expr_susp(ck, v) {
                                return true
                            }
                        }
                        _ => {
                        }
                    }
                }
                if body != nil {
                    if nk(body) == 23 {
                        match body {
                            parser.Node.List{items} => {
                                if block_susp(ck, items) {
                                    return true
                                }
                            }
                            _ => {
                            }
                        }
                    } else if expr_susp(ck, body) {
                        return true
                    }
                }
            }
            _ => {
            }
        }
        a = a.next
    }
    return false
}

// structural seeds — scope sites and susp builtins in bodies
fn expr_susp(ck: ref Ck, e: ref parser.Node) -> bool {
    if e == nil {
        return false
    }
    s := match e {
        parser.Node.Call{f, args} => call_seeds(ck, f, args)
        parser.Node.Bin{l, r} => expr_susp(ck, l) || expr_susp(ck, r)
        parser.Node.Un{e} => expr_susp(ck, e)
        parser.Node.Field{obj} => expr_susp(ck, obj)
        parser.Node.As{e} => expr_susp(ck, e)
        parser.Node.Lit{fields} => lit_susp(ck, fields)
        parser.Node.Match{e, arms} => match_susp(ck, e, arms)
        parser.Node.Index{obj, idx} => expr_susp(ck, obj) || expr_susp(ck, idx)
        parser.Node.Slice{obj, lo, hi} => expr_susp(ck, obj) || expr_susp(ck, lo) || expr_susp(ck, hi)
        _ => false
    }
    return s
}

fn call_seeds(ck: ref Ck, f: ref parser.Node, args: ref parser.NList) -> bool {
    n := callee_name(f)
    if is_susp_builtin(resolve_named(ck, n)) {
        return true
    }
    // Rust sees qualified `mod.f` calls as plain Ident callees; a Field
    // callee here is either that (edge handles it) or an indirect call
    // through a fn-valued field — the latter may suspend
    if nk(f) == 8 {
        return true
    }
    if nk(f) == 9 && !collections.map_has(ck.fns, resolve_named(ck, n)) {
        return true
    }
    return args_susp(ck, args)
}

fn block_susp(ck: ref Ck, items: ref parser.NList) -> bool {
    l := items
    for l != nil {
        if stmt_susp(ck, l.v) {
            return true
        }
        l = l.next
    }
    return false
}

fn block_susp_node(ck: ref Ck, body: ref parser.Node) -> bool {
    if body == nil {
        return false
    }
    b := match body {
        parser.Node.List{items} => block_susp(ck, items)
        _ => false
    }
    return b
}

fn if_susp(ck: ref Ck, cond: ref parser.Node, then: ref parser.Node, els: ref parser.Node) -> bool {
    if expr_susp(ck, cond) {
        return true
    }
    if block_susp_node(ck, then) {
        return true
    }
    if els != nil {
        if nk(els) == 23 {
            return block_susp_node(ck, els)
        }
        return stmt_susp(ck, els)
    }
    return false
}

fn ret_susp(ck: ref Ck, vals: ref parser.NList) -> bool {
    vl := vals
    for vl != nil {
        if expr_susp(ck, vl.v) {
            return true
        }
        vl = vl.next
    }
    return false
}

// ---------- closures ----------
// port of `ExprKind::Closure` in oxl/src/check.rs (B4). Return type is
// inferred from `return` stmts via ck.cl_ret; susp checks are deferred to
// check_closures because the susp set only exists post-fixpoint.
fn closure_expr(ck: mut Ck, params: ref parser.NList, body: ref parser.Node, env: mut Env) -> int {
    // deferred susp scan — collect callees + seeded before checking body
    cc := new(ClChk{callees: nil, seeded: 0, next: nil})
    cl_scan_node(ck, body, cc)
    cc.next = ck.clcks
    ck.clcks = cc
    let ps: own IList = nil
    pl := params
    for pl != nil {
        match pl.v {
            parser.Node.Param{name, ty} => {
                ps = icons(ty_parse(ck, ty_str(ty)), ps)
            }
            _ => {
            }
        }
        pl = pl.next
    }
    ps = irev(ps)
    s_in := ck.in_cl
    s_ret := ck.cl_ret
    ck.in_cl = 1
    ck.cl_ret = -1
    env_push(env)
    pl = params
    wl := ps
    for pl != nil && wl != nil {
        match pl.v {
            parser.Node.Param{name, ty} => {
                env_set(env, name, wl.v)
            }
            _ => {
            }
        }
        wl = wl.next
        pl = pl.next
    }
    block_node(ck, body, env)
    env_pop(env)
    r := ck.cl_ret
    ck.in_cl = s_in
    ck.cl_ret = s_ret
    if r < 0 {
        r = t_void(ck)
    }
    return tm(ck, k_fn(), -1, ps, r, "")
}

// BodyScan port: callee names + seeded (scope/select/spawn/go/defer or a
// susp-builtin call) for the deferred no-susp rule.
fn cl_scan_expr(ck: mut Ck, e: ref parser.Node, cc: mut ClChk) {
    if e == nil {
        return
    }
    match e {
        parser.Node.Call{f, args} => {
            bn := callee_name(f)
            if len(bn) > 0 {
                qn := resolve_named(ck, bn)
                cc.callees = scons(qn, cc.callees)
                if is_susp_builtin(qn) {
                    cc.seeded = 1
                }
            } else {
                cl_scan_expr(ck, f, cc)
            }
            al := args
            for al != nil {
                cl_scan_expr(ck, al.v, cc)
                al = al.next
            }
        }
        parser.Node.Bin{l, r} => {
            cl_scan_expr(ck, l, cc)
            cl_scan_expr(ck, r, cc)
        }
        parser.Node.Un{e} => {
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.As{e} => {
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.Field{obj} => {
            cl_scan_expr(ck, obj, cc)
        }
        parser.Node.Index{obj, idx} => {
            cl_scan_expr(ck, obj, cc)
            cl_scan_expr(ck, idx, cc)
        }
        parser.Node.Slice{obj, lo, hi} => {
            cl_scan_expr(ck, obj, cc)
            if lo != nil {
                cl_scan_expr(ck, lo, cc)
            }
            if hi != nil {
                cl_scan_expr(ck, hi, cc)
            }
        }
        parser.Node.Lit{fields} => {
            fl := fields
            for fl != nil {
                match fl.v {
                    parser.Node.NamedField{val} => {
                        cl_scan_expr(ck, val, cc)
                    }
                    _ => {
                    }
                }
                fl = fl.next
            }
        }
        parser.Node.Match{e, arms} => {
            cl_scan_expr(ck, e, cc)
            a := arms
            for a != nil {
                match a.v {
                    parser.Node.MArm{body} => {
                        cl_scan_node(ck, body, cc)
                    }
                    _ => {
                    }
                }
                a = a.next
            }
        }
        parser.Node.Closure{body} => {
            cl_scan_node(ck, body, cc)
        }
        _ => {
        }
    }
}

fn cl_scan_node(ck: mut Ck, body: ref parser.Node, cc: mut ClChk) {
    if body == nil {
        return
    }
    match body {
        parser.Node.List{items} => {
            l := items
            for l != nil {
                cl_scan_stmt(ck, l.v, cc)
                l = l.next
            }
        }
        _ => {
            cl_scan_expr(ck, body, cc)
        }
    }
}

fn cl_scan_stmt(ck: mut Ck, s: ref parser.Node, cc: mut ClChk) {
    match s {
        parser.Node.Let{init} => {
            cl_scan_expr(ck, init, cc)
        }
        parser.Node.Bind{init} => {
            cl_scan_expr(ck, init, cc)
        }
        parser.Node.Assign{target, val} => {
            cl_scan_expr(ck, target, cc)
            cl_scan_expr(ck, val, cc)
        }
        parser.Node.ExprStmt{e} => {
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.Let2{call} => {
            cl_scan_expr(ck, call, cc)
        }
        parser.Node.Ret{vals} => {
            vl := vals
            for vl != nil {
                cl_scan_expr(ck, vl.v, cc)
                vl = vl.next
            }
        }
        parser.Node.If{cond, then, els} => {
            cl_scan_expr(ck, cond, cc)
            cl_scan_node(ck, then, cc)
            cl_scan_node(ck, els, cc)
        }
        parser.Node.For{cond, body} => {
            cl_scan_expr(ck, cond, cc)
            cl_scan_node(ck, body, cc)
        }
        parser.Node.Scope{body} => {
            cc.seeded = 1
            cl_scan_node(ck, body, cc)
        }
        parser.Node.Unsafe{body} => {
            cl_scan_node(ck, body, cc)
        }
        parser.Node.Defer{call} => {
            cc.seeded = 1
            cl_scan_expr(ck, call, cc)
        }
        parser.Node.Spawn{e} => {
            cc.seeded = 1
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.SpawnBlocking{e} => {
            cc.seeded = 1
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.Go{e} => {
            cc.seeded = 1
            cl_scan_expr(ck, e, cc)
        }
        parser.Node.Select{arms} => {
            cc.seeded = 1
            a := arms
            for a != nil {
                match a.v {
                    parser.Node.SArm{ch, ms, body} => {
                        cl_scan_expr(ck, ch, cc)
                        cl_scan_expr(ck, ms, cc)
                        cl_scan_node(ck, body, cc)
                    }
                    _ => {
                    }
                }
                a = a.next
            }
        }
        _ => {
        }
    }
}

fn clchk_bad(ck: ref Ck, c: ref ClChk) -> bool {
    if c.seeded == 1 {
        return true
    }
    l := c.callees
    for l != nil {
        if sl_has(ck.susp, l.v) {
            return true
        }
        l = l.next
    }
    return false
}

// runs after susp_fixpoint so ck.susp is final (port of closure_checks)
fn check_closures(ck: mut Ck) {
    l := ck.clcks
    for l != nil {
        if clchk_bad(ck, l) {
            diag(ck, "check", "closures may not suspend — spawn/scope/select/recv/send/sleep inside `{ |..| }`")
        }
        l = l.next
    }
}

// ---------- select ----------
// port of `Stmt::Select` in oxl/src/check.rs
fn sel_stmt(ck: mut Ck, arms: ref parser.NList, env: mut Env) {
    if arms == nil {
        diag(ck, "check", "`select` needs at least one arm")
        return
    }
    has_else := false
    tmo := 0
    l := arms
    for l != nil {
        env_push(env)
        match l.v {
            parser.Node.SArm{kind, ch, bind, ms, body} => {
                if kind == "recv" {
                    if ch == nil {
                        diag(ck, "check", "select arm must be `recv(ch)`, `timeout(ms)`, or `else`")
                    } else {
                        assignable(ck, tk(ck, k_chan()), expr(ck, ch, env))
                        if len(bind) > 0 {
                            env_set(env, bind, t_int(ck))
                        }
                    }
                }
                if kind == "timeout" {
                    tmo = tmo + 1
                    if ms == nil {
                        diag(ck, "check", "select arm must be `recv(ch)`, `timeout(ms)`, or `else`")
                    } else {
                        assignable(ck, t_int(ck), expr(ck, ms, env))
                        // a negative wait can never fire —
                        // rt_select_poll reads tmo < 0 as "no timer"
                        neg := false
                        match ms {
                            parser.Node.JInt(v) => {
                                neg = v < 0
                            }
                            parser.Node.Un{op, e} => {
                                if op == "-" {
                                    match e {
                                        parser.Node.JInt(v) => {
                                            neg = v > 0
                                        }
                                        _ => {
                                        }
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                        if neg {
                            diag(ck, "check", "timeout(ms): a negative duration never fires")
                        }
                    }
                }
                if kind == "send" {
                    diag(ck, "check", "select `send` arms are not in v0.2")
                }
                if kind == "else" {
                    has_else = true
                }
                if len(kind) == 0 {
                    diag(ck, "check", "select arm must be `recv(ch)`, `timeout(ms)`, or `else`")
                }
                block_node(ck, body, env)
            }
            _ => {
            }
        }
        env_pop(env)
        l = l.next
    }
    if has_else && tmo > 0 {
        diag(ck, "check", "`else` makes `timeout` unreachable — drop one")
    }
    if tmo > 1 {
        diag(ck, "check", "at most one `timeout` arm")
    }
}

fn stmt_susp(ck: ref Ck, s: ref parser.Node) -> bool {
    r := match s {
        parser.Node.Scope{body} => true
        parser.Node.Spawn{e} => expr_susp(ck, e)
        parser.Node.SpawnBlocking{e} => expr_susp(ck, e)
        parser.Node.Go{e} => expr_susp(ck, e)
        parser.Node.Defer{call} => expr_susp(ck, call)
        parser.Node.ExprStmt{e} => expr_susp(ck, e)
        parser.Node.Assign{val} => expr_susp(ck, val)
        parser.Node.Let{init} => expr_susp(ck, init)
        parser.Node.Bind{init} => expr_susp(ck, init)
        parser.Node.Let2{call} => expr_susp(ck, call)
        parser.Node.Ret{vals} => ret_susp(ck, vals)
        parser.Node.If{cond, then, els} => if_susp(ck, cond, then, els)
        parser.Node.For{cond, body} => expr_susp(ck, cond) || block_susp_node(ck, body)
        parser.Node.Unsafe{body} => block_susp_node(ck, body)
        parser.Node.Select{arms} => true
        parser.Node.List{items} => block_susp(ck, items)
        parser.Node.Match{e} => expr_susp(ck, s)
        _ => false
    }
    return r
}

// seeds: fns whose bodies structurally suspend
fn susp_seeds(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        if nk(its[i].node) == 24 {
            match its[i].node {
                parser.Node.Fn{ex, name, recv, body} => {
                    if !ex && body != nil && block_susp_node(ck, body) {
                        ck.susp = scons(fn_qname(ck, its[i].mod, recv, name), ck.susp)
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1
    }
}

// fixpoint: callers of susp fns suspend
fn susp_fixpoint(ck: mut Ck) {
    grew := true
    for grew {
        grew = false
        e := ck.edges
        for e != nil {
            if !sl_has(ck.susp, e.a) && sl_has(ck.susp, e.b) {
                ck.susp = scons(e.a, ck.susp)
                grew = true
            }
            e = e.next
        }
    }
}

// susp-set aware walk (check_suspend_rules' expr_has_susp)
fn args_has_susp(ck: mut Ck, args: ref parser.NList) -> bool {
    al := args
    for al != nil {
        if expr_has_susp(ck, al.v) {
            return true
        }
        al = al.next
    }
    return false
}

fn lit_has_susp(ck: mut Ck, fields: ref parser.NList) -> bool {
    fl := fields
    for fl != nil {
        match fl.v {
            parser.Node.NamedField{val} => {
                if expr_has_susp(ck, val) {
                    return true
                }
            }
            _ => {
            }
        }
        fl = fl.next
    }
    return false
}

fn match_has_susp(ck: mut Ck, scrut: ref parser.Node, arms: ref parser.NList) -> bool {
    if expr_has_susp(ck, scrut) {
        return true
    }
    a := arms
    for a != nil {
        match a.v {
            parser.Node.MArm{pat, body} => {
                if pat != nil && nk(pat) == 36 {
                    match pat {
                        parser.Node.PatLit{v} => {
                            if expr_has_susp(ck, v) {
                                return true
                            }
                        }
                        _ => {
                        }
                    }
                }
                if body != nil {
                    if nk(body) == 23 {
                        match body {
                            parser.Node.List{items} => {
                                if blk_has_susp(ck, items) {
                                    return true
                                }
                            }
                            _ => {
                            }
                        }
                    } else if expr_has_susp(ck, body) {
                        return true
                    }
                }
            }
            _ => {
            }
        }
        a = a.next
    }
    return false
}

fn call_has_susp(ck: mut Ck, f: ref parser.Node, args: ref parser.NList) -> bool {
    n := callee_name(f)
    qn := resolve_named(ck, n)
    if is_susp_builtin(qn) || len(n) > 0 && sl_has(ck.susp, qn) {
        return true
    }
    if nk(f) == 8 {
        return true
    }
    // indirect call through a fn-valued field — may suspend
    if nk(f) == 9 && !collections.map_has(ck.fns, qn) {
        return true
    }
    return args_has_susp(ck, args)
}

fn expr_has_susp(ck: mut Ck, e: ref parser.Node) -> bool {
    if e == nil {
        return false
    }
    s := match e {
        parser.Node.Call{f, args} => call_has_susp(ck, f, args)
        parser.Node.Bin{l, r} => expr_has_susp(ck, l) || expr_has_susp(ck, r)
        parser.Node.Un{e} => expr_has_susp(ck, e)
        parser.Node.Field{obj} => expr_has_susp(ck, obj)
        parser.Node.As{e} => expr_has_susp(ck, e)
        parser.Node.Lit{fields} => lit_has_susp(ck, fields)
        parser.Node.Match{e, arms} => match_has_susp(ck, e, arms)
        parser.Node.Index{obj, idx} => expr_has_susp(ck, obj) || expr_has_susp(ck, idx)
        parser.Node.Slice{obj, lo, hi} => expr_has_susp(ck, obj) || expr_has_susp(ck, lo) || expr_has_susp(ck, hi)
        _ => false
    }
    return s
}

fn blk_has_susp(ck: mut Ck, items: ref parser.NList) -> bool {
    l := items
    for l != nil {
        if stmt_has_susp(ck, l.v) {
            return true
        }
        l = l.next
    }
    return false
}

fn blk_susp_node(ck: mut Ck, body: ref parser.Node) -> bool {
    if body == nil {
        return false
    }
    b := match body {
        parser.Node.List{items} => blk_has_susp(ck, items)
        _ => false
    }
    return b
}

fn if_has_susp(ck: mut Ck, cond: ref parser.Node, then: ref parser.Node, els: ref parser.Node) -> bool {
    if expr_has_susp(ck, cond) {
        return true
    }
    if blk_susp_node(ck, then) {
        return true
    }
    if els != nil {
        if nk(els) == 23 {
            return blk_susp_node(ck, els)
        }
        return stmt_has_susp(ck, els)
    }
    return false
}

fn ret_has_susp(ck: mut Ck, vals: ref parser.NList) -> bool {
    vl := vals
    for vl != nil {
        if expr_has_susp(ck, vl.v) {
            return true
        }
        vl = vl.next
    }
    return false
}

fn stmt_has_susp(ck: mut Ck, s: ref parser.Node) -> bool {
    r := match s {
        parser.Node.Scope{body} => true
        parser.Node.Defer{call} => expr_has_susp(ck, call)
        parser.Node.Spawn{e} => expr_has_susp(ck, e)
        parser.Node.SpawnBlocking{e} => expr_has_susp(ck, e)
        parser.Node.Go{e} => expr_has_susp(ck, e)
        parser.Node.ExprStmt{e} => expr_has_susp(ck, e)
        parser.Node.Assign{val} => expr_has_susp(ck, val)
        parser.Node.Let{init} => expr_has_susp(ck, init)
        parser.Node.Bind{init} => expr_has_susp(ck, init)
        parser.Node.Let2{call} => expr_has_susp(ck, call)
        parser.Node.Ret{vals} => ret_has_susp(ck, vals)
        parser.Node.If{cond, then, els} => if_has_susp(ck, cond, then, els)
        parser.Node.For{cond, body} => expr_has_susp(ck, cond) || blk_susp_node(ck, body)
        parser.Node.Unsafe{body} => blk_susp_node(ck, body)
        parser.Node.Select{arms} => true
        parser.Node.List{items} => blk_has_susp(ck, items)
        parser.Node.Match{e} => expr_has_susp(ck, s)
        _ => false
    }
    return r
}

// match-position rules (port of scan_match)
fn scan_arm(ck: mut Ck, body: ref parser.Node, stmt_pos: bool) {
    if body == nil {
        return
    }
    if nk(body) == 23 {
        match body {
            parser.Node.List{items} => {
                if !stmt_pos && blk_has_susp(ck, items) {
                    diag(ck, "check", "suspending call inside a value-position match — use `match` as a statement or hoist the call")
                }
                walk_block(ck, items)
            }
            _ => {
            }
        }
        return
    }
    if expr_has_susp(ck, body) {
        top := false
        if nk(body) == 8 {
            match body {
                parser.Node.Call{f, args} => {
                    bn := callee_name(f)
                    if is_susp_builtin(resolve_named(ck, bn)) || len(bn) > 0 && sl_has(ck.susp, resolve_named(ck, bn)) {
                        top = true
                    }
                }
                _ => {
                }
            }
        }
        if !(stmt_pos && top) {
            diag(ck, "check", "suspending call inside a match arm must be the whole arm body of a statement-level match — use a block arm or hoist the call")
        }
    }
    scan_match(ck, body, stmt_pos && nk(body) == 32)
}

fn scan_match(ck: mut Ck, e: ref parser.Node, stmt_pos: bool) {
    if e == nil {
        return
    }
    if nk(e) == 32 {
        match e {
            parser.Node.Match{e, arms} => {
                scan_match(ck, e, false)
                a := arms
                for a != nil {
                    match a.v {
                        parser.Node.MArm{pat, body} => {
                            scan_arm(ck, body, stmt_pos)
                        }
                        _ => {
                        }
                    }
                    a = a.next
                }
            }
            _ => {
            }
        }
        return
    }
    match e {
        parser.Node.Call{f, args} => {
            scan_match(ck, f, false)
            al := args
            for al != nil {
                scan_match(ck, al.v, false)
                al = al.next
            }
        }
        parser.Node.Bin{l, r} => {
            scan_match(ck, l, false)
            scan_match(ck, r, false)
        }
        parser.Node.Un{e} => {
            scan_match(ck, e, false)
        }
        parser.Node.As{e} => {
            scan_match(ck, e, false)
        }
        parser.Node.Field{obj} => {
            scan_match(ck, obj, false)
        }
        parser.Node.Index{obj, idx} => {
            scan_match(ck, obj, false)
            scan_match(ck, idx, false)
        }
        parser.Node.Slice{obj, lo, hi} => {
            scan_match(ck, obj, false)
            if lo != nil {
                scan_match(ck, lo, false)
            }
            if hi != nil {
                scan_match(ck, hi, false)
            }
        }
        parser.Node.Lit{fields} => {
            fl := fields
            for fl != nil {
                match fl.v {
                    parser.Node.NamedField{val} => {
                        scan_match(ck, val, false)
                    }
                    _ => {
                    }
                }
                fl = fl.next
            }
        }
        _ => {
        }
    }
}

fn walk_block(ck: mut Ck, items: ref parser.NList) {
    l := items
    for l != nil {
        s := l.v
        match s {
            parser.Node.Defer{call} => {
                if expr_has_susp(ck, call) {
                    diag(ck, "check", "`defer` cannot capture a suspending call — it runs during unwind")
                }
                scan_match(ck, call, false)
            }
            parser.Node.ExprStmt{e} => {
                scan_match(ck, e, true)
            }
            parser.Node.Let{init} => {
                scan_match(ck, init, false)
            }
            parser.Node.Bind{init} => {
                scan_match(ck, init, false)
            }
            parser.Node.Assign{val} => {
                scan_match(ck, val, false)
            }
            parser.Node.Let2{call} => {
                scan_match(ck, call, false)
            }
            parser.Node.Spawn{e} => {
                scan_match(ck, e, false)
            }
            parser.Node.SpawnBlocking{e} => {
                scan_match(ck, e, false)
            }
            parser.Node.Go{e} => {
                scan_match(ck, e, false)
            }
            parser.Node.Ret{vals} => {
                vl := vals
                for vl != nil {
                    scan_match(ck, vl.v, false)
                    vl = vl.next
                }
            }
            parser.Node.If{cond, then, els} => {
                scan_match(ck, cond, false)
                walk_block_node(ck, then)
                walk_else(ck, els)
            }
            parser.Node.For{cond, body} => {
                scan_match(ck, cond, false)
                walk_block_node(ck, body)
            }
            parser.Node.Scope{body} => {
                walk_block_node(ck, body)
            }
            parser.Node.Unsafe{body} => {
                walk_block_node(ck, body)
            }
            parser.Node.Select{arms} => {
                sa := arms
                for sa != nil {
                    match sa.v {
                        parser.Node.SArm{ch, ms, body} => {
                            if ch != nil {
                                scan_match(ck, ch, false)
                            }
                            if ms != nil {
                                scan_match(ck, ms, false)
                            }
                            walk_block_node(ck, body)
                        }
                        _ => {
                        }
                    }
                    sa = sa.next
                }
            }
            _ => {
            }
        }
        l = l.next
    }
}

fn walk_else(ck: mut Ck, els: ref parser.Node) {
    if els == nil {
        return
    }
    if nk(els) == 23 {
        walk_block_node(ck, els)
    }
    if nk(els) == 21 {
        walk_if(ck, els)
    }
}

fn walk_if(ck: mut Ck, s: ref parser.Node) {
    // else-if — descend like a block
    match s {
        parser.Node.If{cond, then, els} => {
            scan_match(ck, cond, false)
            walk_block_node(ck, then)
            walk_else(ck, els)
        }
        _ => {
        }
    }
}

fn walk_block_node(ck: mut Ck, body: ref parser.Node) {
    if body == nil {
        return
    }
    match body {
        parser.Node.List{items} => {
            walk_block(ck, items)
        }
        _ => {
        }
    }
}

// ---------- per-fn checking ----------
fn check_fn(ck: mut Ck, mod: str, name: str, recv: ref parser.Node, params: ref parser.NList, body: ref parser.Node) {
    qn := fn_qname(ck, mod, recv, name)
    ck.cur_fn = qn
    ck.retk = 0
    ck.ret1 = -1
    ck.ty_scope = nil
    ck.cur_ty_params = nil
    if collections.map_has(ck.fns, qn) {
        [fi, err] = collections.map_get(ck.fns, qn)
        if err == nil {
            ck.retk = ck.fnsv[fi].retk
            ck.ret1 = ck.fnsv[fi].ret1
            ck.cur_ty_params = tp_clone(ck.fnsv[fi].typarams)
            ck.ty_scope = tp_names(ck.fnsv[fi].typarams)
        }
    }
    ck.loop_depth = 0
    env := env_new()
    if collections.map_has(ck.fns, qn) {
        [fi, err] = collections.map_get(ck.fns, qn)
        if err == nil {
            wl := ck.fnsv[fi].params
            if recv != nil && wl != nil {
                match recv {
                    parser.Node.Param{name} => {
                        env_set(env, name, wl.v)
                    }
                    _ => {
                    }
                }
                wl = wl.next
            }
            pl := params
            for pl != nil && wl != nil {
                match pl.v {
                    parser.Node.Param{name, ty} => {
                        env_set(env, name, wl.v)
                    }
                    _ => {
                    }
                }
                wl = wl.next
                pl = pl.next
            }
        }
    }
    if body != nil {
        match body {
            parser.Node.List{items} => {
                block(ck, items, env)
            }
            _ => {
            }
        }
    }
}

fn check_items(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        if nk(its[i].node) == 24 {
            match its[i].node {
                parser.Node.Fn{ex, name, recv, params, body} => {
                    if !ex {
                        ck.cur_mod = its[i].mod
                        ck.cur_file = its[i].file
                        check_fn(ck, its[i].mod, name, recv, params, body)
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1
    }
    ck.cur_mod = ""
    ck.cur_file = ""
}

// item-level Skip nodes — surfaced as parse diagnostics
fn check_skips(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        match its[i].node {
            parser.Node.Skip{text} => {
                diag(ck, "parse", "unparsed `" + text + "`")
            }
            _ => {
            }
        }
        i = i + 1
    }
}

// susp rules that need the full set: defer + global inits + match pos
fn check_suspend_rules(ck: mut Ck, its: []It) {
    i := 0
    for i < len(its) {
        ck.cur_mod = its[i].mod
        ck.cur_file = its[i].file
        match its[i].node {
            parser.Node.Fn{ex, body} => {
                if !ex && body != nil {
                    walk_block_node(ck, body)
                }
            }
            parser.Node.Let{init} => {
                if expr_has_susp(ck, init) {
                    diag(ck, "check", "global initializer cannot suspend — move it into fn main")
                }
            }
            _ => {
            }
        }
        i = i + 1
    }
    ck.cur_mod = ""
    ck.cur_file = ""
}

// B4 deferred: fn values may not be suspend-capable
fn check_fnvals(ck: mut Ck) {
    l := ck.fnvals
    for l != nil {
        if sl_has(ck.susp, l.v) {
            diag(ck, "type", "suspendable fn `" + l.v + "` can't be a value (v0.2)")
        }
        l = l.next
    }
}

// ---------- driver: load + import resolution ----------
fn dir_of(path: str) -> str {
    ls := last_slash(path)
    if ls < 0 {
        return "."
    }
    if ls == 0 {
        return "/"
    }
    return substr(path, 0, ls)
}

// last path component, trailing slashes ignored — mirrors path_base
fn base_name(path: str) -> str {
    p := path
    for len(p) > 0 && strings.endswith(p, "/") {
        p = substr(p, 0, len(p) - 1)
    }
    ls := last_slash(p)
    if ls < 0 {
        return p
    }
    return substr(p, ls + 1, len(p))
}

// clause name cached per resolved dir — re-imports of an already-loaded
// (or mid-cycle) package still bind their package name
fn clause_of(ck: ref Ck, dir: str) -> str {
    l := ck.loaded_names
    for l != nil {
        if l.alias == dir {
            return l.stem
        }
        l = l.next
    }
    return ""
}

// ---------- module system (mirrors the Rust mod_ctx/resolve_pkg) ----------

// language version this self-hosted toolchain implements — kept in
// lock-step with the Rust OXL_VERSION (Cargo.toml major.minor)
fn tool_ver() -> str {
    return "0.3"
}

// resolve result: dir non-empty = found; missing non-empty = declared
// require with neither replace nor a cache copy; both = cannot find
struct RRes { dir: str, missing: str }

fn all_digits(s: str) -> bool {
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c < 48 || c > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

// `X.Y[.Z]` -> maj*1000000+min*1000+patch for ordering; -1 malformed
fn ver_tuple(v: str) -> int {
    if strings.startswith(v, "v") {
        v = substr(v, 1, len(v))
    }
    parts := strings.split(v, ".")
    nums := mkslice(int, 0)
    for parts != nil {
        if len(parts.v) == 0 || all_digits(parts.v) == false {
            return -1
        }
        nums = push(nums, atoi(parts.v))
        parts = parts.next
    }
    if len(nums) < 2 || len(nums) > 3 {
        return -1
    }
    patch := 0
    if len(nums) == 3 {
        patch = nums[2]
    }
    return nums[0] * 1000000 + nums[1] * 1000 + patch
}

// `vX.Y.Z` or a pseudo-version (`vX.Y.Z-<anything>`)
fn mod_ver_ok(v: str) -> bool {
    core := v
    h := find(v, "-")
    if h >= 0 {
        core = substr(v, 0, h)
    }
    if strings.startswith(core, "v") == false {
        return false
    }
    parts := strings.split(substr(core, 1, len(core)), ".")
    n := 0
    for parts != nil {
        if len(parts.v) == 0 || all_digits(parts.v) == false {
            return false
        }
        n = n + 1
        parts = parts.next
    }
    return n == 3
}

// first path segment carrying a `.` reads as a remote module path —
// drives the `oxl get` hint on `cannot find package`
fn remoteish(imp: str) -> bool {
    seg := imp
    i := find(imp, "/")
    if i >= 0 {
        seg = substr(imp, 0, i)
    }
    return find(seg, ".") >= 0
}

fn sl_len(l: ref SList) -> int {
    n := 0
    for l != nil {
        n = n + 1
        l = l.next
    }
    return n
}

fn sl_at(l: ref SList, i: int) -> str {
    for l != nil {
        if i == 0 {
            return l.v
        }
        i = i - 1
        l = l.next
    }
    return ""
}

// whitespace tokenizer for oxl.mod lines (space/tab — manifests don't
// quote), returned as an ordered list
fn split_ws(s: str) -> own SList {
    let rev: own SList = nil
    cur := ""
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c == 32 || c == 9 {
            if len(cur) > 0 {
                rev = scons(cur, rev)
                cur = ""
            }
        } else {
            cur = cur + substr(s, i, i + 1)
        }
        i = i + 1
    }
    if len(cur) > 0 {
        rev = scons(cur, rev)
    }
    let out: own SList = nil
    for rev != nil {
        out = scons(rev.v, out)
        rev = rev.next
    }
    return out
}

// lexical `.`/`..` normalization — the internal-package rule compares
// path prefixes, so `a/../b` must read as `b` (no symlink chasing; the
// resolver never emits them)
fn norm_path(p: str) -> str {
    abs := strings.startswith(p, "/")
    parts := strings.split(p, "/")
    let stack: own SList = nil
    for parts != nil {
        s := parts.v
        if s == ".." {
            if stack != nil && stack.v != ".." {
                stack = stack.next
            } else if abs == false {
                stack = scons("..", stack)
            }
        } else if len(s) > 0 && s != "." {
            stack = scons(s, stack)
        }
        parts = parts.next
    }
    out := ""
    for stack != nil {
        if len(out) == 0 {
            out = stack.v
        } else {
            out = stack.v + "/" + out
        }
        stack = stack.next
    }
    if abs {
        return "/" + out
    }
    if len(out) == 0 {
        return "."
    }
    return out
}

// nearest ancestor dir holding oxl.mod — "" when none (module-off)
fn find_root(d: str) -> str {
    for len(d) > 0 {
        if rt_fexists(d + "/oxl.mod") == 1 {
            return d
        }
        if d == "." || d == "/" {
            break
        }
        d = dir_of(d)
    }
    if rt_fexists("/oxl.mod") == 1 {
        return "/"
    }
    return ""
}

// OXLMODCACHE wins, else ~/.oxl/mod — mirrors modcache_dir
fn modcache_dir() -> str {
    v := rt_getenv("OXLMODCACHE")
    if len(v) > 0 {
        return v
    }
    h := rt_getenv("HOME")
    if len(h) == 0 {
        h = rt_getenv("USERPROFILE")
    }
    if len(h) > 0 {
        return h + "/.oxl/mod"
    }
    return ".oxl/mod"
}

// manifest diagnostic — `oxl.mod:<line>: <msg>` (the file is always AT
// the module root, so the bare name locates it)
fn merr(ck: mut Ck, lineno: int, msg: str) {
    diag(ck, "check", "oxl.mod:" + itoa(lineno) + ": " + msg)
}

// replace RHS is a local dir — absolute when `/` or `X:`-rooted,
// else anchored at the module root
fn is_abs(p: str) -> bool {
    if strings.startswith(p, "/") {
        return true
    }
    if len(p) >= 3 && substr(p, 1, 2) == ":" && substr(p, 2, 3) == "/" {
        return true
    }
    return false
}

// one require/replace entry (inline or inside a ( ) block); `rest` is
// the text after the keyword
fn manifest_entry(ck: mut Ck, kw: str, rest: str, lineno: int) -> int {
    toks := split_ws(rest)
    n := sl_len(toks)
    if kw == "require" {
        if n != 2 {
            merr(ck, lineno, "expected `path version`")
            return 0
        }
        p := sl_at(toks, 0)
        v := sl_at(toks, 1)
        if mod_ver_ok(v) == false {
            merr(ck, lineno, "bad version \"" + v + "\"")
            return 0
        }
        l := ck.mod_reqs
        for l != nil {
            if l.alias == p {
                merr(ck, lineno, "duplicate require \"" + p + "\"")
                return 0
            }
            l = l.next
        }
        ck.mod_reqs = new(ModEnt{alias: p, stem: v, next: ck.mod_reqs})
        return 1
    }
    // replace <path> [ver] => <dir>
    arrow := -1
    i := 0
    for i < n {
        if sl_at(toks, i) == "=>" {
            arrow = i
            break
        }
        i = i + 1
    }
    if arrow < 0 {
        merr(ck, lineno, "expected `=>`")
        return 0
    }
    if arrow == 0 || arrow > 2 || arrow + 1 != n - 1 {
        merr(ck, lineno, "expected `path [version] => dir`")
        return 0
    }
    if arrow == 2 && mod_ver_ok(sl_at(toks, 1)) == false {
        merr(ck, lineno, "bad version \"" + sl_at(toks, 1) + "\"")
        return 0
    }
    dir := sl_at(toks, arrow + 1)
    if is_abs(dir) == false {
        dir = ck.mod_root + "/" + dir
    }
    ck.mod_reps = new(ModEnt{alias: sl_at(toks, 0), stem: dir, next: ck.mod_reps})
    return 1
}

// parse oxl.mod into ck's module fields — mirrors parse_manifest:
// `//` comments, ( ) blocks, identical diagnostics incl. the oxl floor
fn parse_manifest(ck: mut Ck, text: str) -> int {
    lines := strings.split(text, "\n")
    lineno := 0
    block := ""
    block_line := 0
    for lines != nil {
        lineno = lineno + 1
        t := lines.v
        lines = lines.next
        ci := find(t, "//")
        if ci >= 0 {
            t = substr(t, 0, ci)
        }
        t = strings.trim(t)
        if len(t) == 0 {
            continue
        }
        if len(block) > 0 {
            if t == ")" {
                block = ""
            } else if manifest_entry(ck, block, t, lineno) == 0 {
                return 0
            }
            continue
        }
        toks := split_ws(t)
        kw := sl_at(toks, 0)
        n := sl_len(toks)
        if kw == "module" {
            if len(ck.mod_path) > 0 {
                merr(ck, lineno, "duplicate directive \"module\"")
                return 0
            }
            if n != 2 {
                merr(ck, lineno, "expected module path")
                return 0
            }
            ck.mod_path = sl_at(toks, 1)
        } else if kw == "oxl" {
            if len(ck.mod_floor) > 0 {
                merr(ck, lineno, "duplicate directive \"oxl\"")
                return 0
            }
            if n != 2 || ver_tuple(sl_at(toks, 1)) < 0 {
                merr(ck, lineno, "expected version")
                return 0
            }
            ck.mod_floor = sl_at(toks, 1)
            if ver_tuple(sl_at(toks, 1)) > ver_tuple(tool_ver()) {
                diag(ck, "check", "oxl.mod: requires oxl " + sl_at(toks, 1) + ", toolchain is " + tool_ver())
                return 0
            }
        } else if kw == "require" || kw == "replace" {
            if n == 2 && sl_at(toks, 1) == "(" {
                block = kw
                block_line = lineno
            } else if manifest_entry(ck, kw, substr(t, len(kw), len(t)), lineno) == 0 {
                return 0
            }
        } else {
            merr(ck, lineno, "unknown directive \"" + kw + "\"")
            return 0
        }
    }
    if len(block) > 0 {
        merr(ck, block_line, "unterminated " + block + " block")
        return 0
    }
    if len(ck.mod_path) == 0 {
        diag(ck, "check", "oxl.mod: missing module directive")
        return 0
    }
    return 1
}

// find + parse the nearest oxl.mod into ck's module fields — 0 on
// manifest error (diags emitted), 1 ok including module-off (no
// oxl.mod anywhere: mod_on stays 0 and only `std/` imports resolve)
fn mod_ctx_load(ck: mut Ck, start: str) -> int {
    root := find_root(start)
    if len(root) == 0 {
        return 1
    }
    ck.mod_root = root
    ck.modcache = modcache_dir()
    text := readfile(root + "/oxl.mod")
    if parse_manifest(ck, text) == 0 {
        return 0
    }
    ck.mod_on = 1
    return 1
}

// `<base>`-anchored ancestor walk for `std/<rest>` — the exe and the
// entry dir each get one pass inside resolve_imp
fn std_at(base: str, rest: str) -> str {
    d := base
    for len(d) > 0 {
        p := d + "/std/" + rest
        if rt_isdir(p) == 1 {
            return p
        }
        if d == "." || d == "/" {
            break
        }
        d = dir_of(d)
    }
    return ""
}

// mirrors resolve_pkg under the module rules: `std/` beside the
// toolchain exe, then the main module's own path, then the longest
// require-prefix through replace or the cache
fn resolve_imp(ck: mut Ck, imp: str) -> RRes {
    r := RRes{dir: "", missing: ""}
    if strings.startswith(imp, "std/") {
        rest := substr(imp, 4, len(imp))
        // exe ancestors first (shipped-tree std beside the binary),
        // then the entry's ancestors — a self-hosted checker compiled
        // into a scratch dir still finds the SOURCE tree's std
        r.dir = std_at(dir_of(argv(0)), rest)
        if len(r.dir) == 0 {
            r.dir = std_at(ck.entry_dir, rest)
        }
        return r
    }
    if ck.mod_on == 0 {
        return r
    }
    if imp == ck.mod_path || strings.startswith(imp, ck.mod_path + "/") {
        rest := ""
        if len(imp) > len(ck.mod_path) {
            rest = substr(imp, len(ck.mod_path) + 1, len(imp))
        }
        p := ck.mod_root
        if len(rest) > 0 {
            p = p + "/" + rest
        }
        if rt_isdir(p) == 1 {
            r.dir = p
        }
        return r
    }
    // requires — longest path prefix wins
    best_alias := ""
    best_ver := ""
    l := ck.mod_reqs
    for l != nil {
        if (imp == l.alias || strings.startswith(imp, l.alias + "/")) && len(l.alias) > len(best_alias) {
            best_alias = l.alias
            best_ver = l.stem
        }
        l = l.next
    }
    if len(best_alias) > 0 {
        rest := ""
        if len(imp) > len(best_alias) {
            rest = substr(imp, len(best_alias) + 1, len(imp))
        }
        rl := ck.mod_reps
        for rl != nil {
            if rl.alias == best_alias {
                p := rl.stem
                if len(rest) > 0 {
                    p = p + "/" + rest
                }
                if rt_isdir(p) == 1 {
                    r.dir = p
                }
                return r
            }
            rl = rl.next
        }
        base := ck.modcache + "/" + best_alias + "@" + best_ver
        p := base
        if len(rest) > 0 {
            p = p + "/" + rest
        }
        if rt_isdir(base) == 1 {
            if rt_isdir(p) == 1 {
                r.dir = p
            }
        } else {
            r.missing = best_alias + "@" + best_ver
        }
        return r
    }
    return r
}

// internal rule: the importing package's dir must sit under EVERY
// `internal` segment's parent — mirrors the Rust component scan over
// normalized paths
fn internal_ok(resolved: str, importer_dir: str) -> bool {
    rd := norm_path(resolved)
    id := norm_path(importer_dir)
    segs := strings.split(rd, "/")
    prefix := ""
    for segs != nil {
        s := segs.v
        if s == "internal" && len(prefix) > 0 {
            if id != prefix && strings.startswith(id, prefix + "/") == false {
                return false
            }
        }
        if len(s) > 0 {
            if len(prefix) == 0 {
                prefix = s
            } else {
                prefix = prefix + "/" + s
            }
        }
        segs = segs.next
    }
    return true
}

// the written-imp chain from the in-flight load of `dir` to the stack
// top, oldest first — "" when `dir` isn't mid-load
fn cycle_chain(ck: mut Ck, dir: str) -> str {
    rev := ""
    l := ck.loading
    for l != nil {
        if len(rev) == 0 {
            rev = l.stem
        } else {
            rev = l.stem + " → " + rev
        }
        if l.alias == dir {
            return rev
        }
        l = l.next
    }
    return ""
}

// one parsed package file: clause + ast
struct PFile { path: str, clause: str, ast: own parser.Node }

// read + parse a file, report failures; "" clause when unparseable
fn parse_pfile(ck: mut Ck, path: str) -> PFile {
    src := readfile(path)
    if len(src) == 0 {
        diag(ck, "check", "cannot read `" + path + "`")
        ck.load_fail = 1
        return PFile{path: path, clause: "", ast: nil}
    }
    ast := parser.parse(lexlib.lex(src))
    if ast == nil {
        diag(ck, "lex", "lexical error — see lex output above")
        ck.load_fail = 1
        return PFile{path: path, clause: "", ast: nil}
    }
    clause := ""
    match ast {
        parser.Node.Root{items} => {
            if items != nil && nk(items.v) == 52 {
                match items.v {
                    parser.Node.Package{name} => {
                        clause = name
                    }
                    _ => {
                    }
                }
            }
        }
        _ => {
        }
    }
    return PFile{path: path, clause: clause, ast: ast}
}

// collect one file's items + its own import bindings: names shared
// package-wide through `mod`, import tables stay per-file like Go
fn pfile_items(ck: mut Ck, ld: mut Loader, fpath: str, ast: own parser.Node, itemmod: str) {
    match ast {
        parser.Node.Root{items} => {
            l := items
            for l != nil {
                k := nk(l.v)
                if k != 25 && k != 52 {
                    ld.items = push(ld.items, It{node: l.v, mod: itemmod, file: fpath})
                }
                l = l.next
            }
            let al: own ModEnt = nil
            let nm: own ModEnt = nil
            l = items
            for l != nil {
                match l.v {
                    parser.Node.Import{path, alias, names} => {
                        if ck.load_fail == 1 {
                            break
                        }
                        rr := resolve_imp(ck, path)
                        if len(rr.missing) > 0 {
                            diag(ck, "check", "missing module `" + rr.missing + "` — oxl get it or replace it")
                            ck.load_fail = 1
                        } else if len(rr.dir) == 0 {
                            if remoteish(path) {
                                diag(ck, "check", "cannot find package `" + path + "` (missing module — oxl get it or add a require)")
                            } else {
                                diag(ck, "check", "cannot find package `" + path + "`")
                            }
                            ck.load_fail = 1
                        } else if internal_ok(rr.dir, dir_of(fpath)) == false {
                            diag(ck, "check", "use of internal package `" + path + "` not allowed")
                            ck.load_fail = 1
                        } else {
                            bound := load_pkg(ck, ld, rr.dir, path, 1, 0)
                            if len(bound) > 0 {
                                if len(alias) > 0 {
                                    al = new(ModEnt{alias: alias, stem: bound, next: al})
                                } else {
                                    al = new(ModEnt{alias: bound, stem: bound, next: al})
                                }
                                nl := names
                                for nl != nil {
                                    match nl.v {
                                        parser.Node.Name(n) => {
                                            nm = new(ModEnt{alias: n, stem: bound + "." + n, next: nm})
                                        }
                                        _ => {
                                        }
                                    }
                                    nl = nl.next
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                l = l.next
            }
            ck.file_aliases = push(ck.file_aliases, FileAlias{file: fpath, aliases: al, names: nm, next: nil})
        }
        _ => {
        }
    }
}

// load every .oxl in a package dir; returns the clause ("" on failure —
// diagnostics already emitted). Mirrors the Rust load_pkg checks:
// mixed clauses, clause-vs-dirname, `main` isn't importable.
fn load_pkg(ck: mut Ck, ld: mut Loader, dir: str, imp: str, as_import: int, is_root: int) -> str {
    if ck.load_fail == 1 {
        return ""
    }
    cc := cycle_chain(ck, dir)
    if len(cc) > 0 {
        diag(ck, "check", "import cycle not allowed: " + cc + " → " + imp)
        ck.load_fail = 1
        return ""
    }
    if sl_has(ck.loaded, dir) {
        return clause_of(ck, dir)
    }
    ck.loaded = scons(dir, ck.loaded)
    ck.loading = new(ModEnt{alias: dir, stem: imp, next: ck.loading})
    r := load_pkg_inner(ck, ld, dir, imp, as_import, is_root)
    ck.loading = ck.loading.next
    return r
}

fn load_pkg_inner(ck: mut Ck, ld: mut Loader, dir: str, imp: str, as_import: int, is_root: int) -> str {
    // .oxl entries of the dir — rt_lsdir presorts so the load order
    // (and diagnostics) match the Rust loader deterministically
    fs := mkslice(str, 0)
    raw := rt_lsdir(dir)
    for len(raw) > 0 {
        i := find(raw, "\n")
        nm := raw
        if i >= 0 {
            nm = substr(raw, 0, i)
            raw = substr(raw, i + 1, len(raw))
        } else {
            raw = ""
        }
        if strings.endswith(nm, ".oxl") {
            fs = push(fs, nm)
        }
    }
    if len(fs) == 0 {
        diag(ck, "check", "no .oxl source files in `" + dir + "`")
        return ""
    }
    // parse all files first — clause validation precedes item collection
    pfs := mkslice(PFile, 0)
    i := 0
    for i < len(fs) {
        pfs = push(pfs, parse_pfile(ck, dir + "/" + fs[i]))
        i = i + 1
    }
    clause0 := pfs[0].clause
    i = 1
    for i < len(pfs) {
        if pfs[i].clause != clause0 {
            diag(ck, "check", "found packages `" + clause0 + "` (`" + fs[0] + "`) and `" + pfs[i].clause + "` (`" + fs[i] + "`) in `" + dir + "`")
            return ""
        }
        i = i + 1
    }
    if as_import == 1 && clause0 == "main" {
        diag(ck, "check", "`" + imp + "` is a program, not an importable package")
        return ""
    }
    if clause0 != "main" && clause0 != base_name(dir) {
        diag(ck, "check", "package name `" + clause0 + "` does not match directory `" + base_name(dir) + "`")
        return ""
    }
    ck.loaded_names = new(ModEnt{alias: dir, stem: clause0, next: ck.loaded_names})
    itemmod := clause0
    if is_root == 1 {
        itemmod = ""
    }
    i = 0
    for i < len(pfs) {
        pfile_items(ck, ld, pfs[i].path, pfs[i].ast, itemmod)
        i = i + 1
    }
    return clause0
}

// file-mode root: one file is a one-file package — no dir-name or
// mixed-clause checks, items stay unqualified; imports still resolve
// to package directories (mirrors the Rust PkgSrc::Files path)
fn load_file_root(ck: mut Ck, ld: mut Loader, path: str) -> str {
    pf := parse_pfile(ck, path)
    if pf.ast == nil {
        return ""
    }
    pfile_items(ck, ld, pf.path, pf.ast, "")
    return pf.clause
}

// result of the whole check pipeline — codegen consumes it too
struct CkRes { ck: own Ck, items: []It }

// load + register + typecheck + susp analysis for `path`.
// `path` may name a file (file-list mode) or a package directory.
// `need_main` mirrors compile_mode: building requires `package main`
// (test mode's generated driver exempts it).
fn check_file(path: str, need_main: int) -> own CkRes {
    ck := new(Ck)
    ck.tyv = mkslice(T, 0)
    ck.fns = collections.map_new()
    ck.fnsv = mkslice(FnSig, 0)
    ck.structs = collections.map_new()
    ck.structsv = mkslice(SEnt, 0)
    ck.enums = collections.map_new()
    ck.enumsv = mkslice(EEnt, 0)
    ck.globals = collections.map_new()
    ck.ifaces = collections.map_new()
    ck.ifacesv = mkslice(IEnt, 0)
    ck.ty_scope = nil
    ck.cur_ty_params = nil
    ck.methods = nil
    ck.file_aliases = mkslice(FileAlias, 0)
    ck.diags = mkslice(DBox, 0)
    ck.edges = nil
    ck.susp = nil
    ck.loaded = nil
    ck.loaded_names = nil
    ck.fnvals = nil
    ck.cur_fn = ""
    ck.cur_mod = ""
    ck.cur_file = ""
    ck.retk = 0
    ck.ret1 = -1
    ck.in_let2 = 0
    ck.in_cl = 0
    ck.cl_ret = -1
    ck.clcks = nil
    ck.loop_depth = 0
    ck.nerr = 0
    ck.loading = nil
    ck.load_fail = 0
    ck.mod_on = 0
    ck.mod_path = ""
    ck.mod_root = ""
    ck.mod_floor = ""
    ck.mod_reqs = nil
    ck.mod_reps = nil
    ck.modcache = ""
    ck.entry_dir = ""
    ld := new(Loader)
    ld.items = mkslice(It, 0)
    // module ctx from the entry — dir args directly, file args' parent
    start := path
    if rt_isdir(path) == 0 {
        start = dir_of(path)
    }
    ck.entry_dir = start
    if mod_ctx_load(ck, start) == 0 {
        ck.load_fail = 1
    }
    root_pkg := ""
    if ck.load_fail == 0 {
        if rt_isdir(path) == 1 {
            root_pkg = load_pkg(ck, ld, path, path, 0, 1)
        } else {
            root_pkg = load_file_root(ck, ld, path)
        }
    }
    if ck.load_fail == 1 {
        r := new(CkRes)
        r.ck = ck
        r.items = ld.items
        return r
    }
    if need_main == 1 && len(root_pkg) > 0 && root_pkg != "main" {
        diag(ck, "check", "package `" + root_pkg + "` is not a main package")
        r := new(CkRes)
        r.ck = ck
        r.items = ld.items
        return r
    }
    register(ck, ld.items)
    check_skips(ck, ld.items)
    check_items(ck, ld.items)
    susp_seeds(ck, ld.items)
    susp_fixpoint(ck)
    // D3: methods may not suspend — vtable/indirect calls carry no task
    ml := ck.methods
    for ml != nil {
        if sl_has(ck.susp, ml.v) {
            diag(ck, "check", "suspendable method `" + ml.v + "` — methods may not suspend (v0.2)")
        }
        ml = ml.next
    }
    check_closures(ck)
    check_fnvals(ck)
    check_suspend_rules(ck, ld.items)
    r := new(CkRes)
    r.ck = ck
    r.items = ld.items
    return r
}
